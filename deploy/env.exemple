# Configuration du stockage objet (OVH Object Storage, S3 compatible).
# Copier vers /etc/ovmi/stockage.env (droits 640, root:ovmi) et remplir. Ne JAMAIS versionner le fichier rempli.
# Les cles viennent de la console OVH : Public Cloud > Object Storage > Utilisateurs S3 (voir docs/STOCKAGE.md).

# --- remote rclone "ovh", entierement defini par variables d'environnement (aucun rclone.conf necessaire)
OVMI_REMOTE=ovh
RCLONE_CONFIG_OVH_TYPE=s3
RCLONE_CONFIG_OVH_PROVIDER=OVHcloud
RCLONE_CONFIG_OVH_REGION=gra
RCLONE_CONFIG_OVH_ENDPOINT=s3.gra.io.cloud.ovh.net
RCLONE_CONFIG_OVH_ACCESS_KEY_ID=
RCLONE_CONFIG_OVH_SECRET_ACCESS_KEY=
RCLONE_CONFIG_OVH_ACL=private
# les buckets sont crees dans la console : rclone ne tente pas de les creer
RCLONE_S3_NO_CHECK_BUCKET=true
# variante : un fichier rclone.conf (droits 600) a la place des variables ci-dessus
# RCLONE_CONFIG=/etc/ovmi/rclone.conf

# --- buckets (nom, ou nom/prefixe). Le prive recoit les donnees de personnes physiques (data/lake/_restreint).
OVMI_BUCKET_PUBLIC=
OVMI_BUCKET_PRIVE=

# --- menagement du VPS partage
# bande passante d'envoi (rclone --bwlimit), ex. 8M ou "08:00,4M 23:00,off"
OVMI_BWLIMIT=8M
OVMI_DUCKDB_MEMOIRE=1GB
OVMI_DUCKDB_THREADS=2
# espace disque libre minimal (Go) : en dessous, la collecte ne demarre pas
OVMI_DISQUE_MIN_GO=10

# --- lots de la collecte hebdomadaire (separes par ";"), passes a collecte/collecte.py --flux
OVMI_LOTS="--lourd;--decouvertes --score-min 4"
# mise a jour du code (git pull --ff-only) avant chaque collecte : 1 pour activer
OVMI_MAJ_AUTO=0

# --- orchestrateur (facultatif) : apres la collecte, pipeline/tout.py complete un entrepot local des sources lues
# (plafond en Go) puis regenere site/data sur le VPS. Rien n'est publie depuis le VPS (voir docs/DEPLOIEMENT.md).
OVMI_PIPELINE=0
OVMI_PIPELINE_BUDGET=18000
OVMI_PIPELINE_PLAFOND_GO=10
# journaux gardes dans /var/lib/ovmi/journaux (compresses apres un jour)
OVMI_JOURNAUX_GARDES=12

# --- alerte optionnelle (issue GitHub en cas d'echec) : PAS ICI. Constat I5 de docs/AUDIT_SECURITE.md :
# le jeton va dans /etc/ovmi/alerte.env (600 root:root, cree par installer_vps.sh), lu par le seul
# ovmi-collecte-alerte.service. Un jeton laisse ici par une ancienne installation est retire de l'environnement
# de la collecte (UnsetEnvironment=) mais installer_vps.sh le signale : le deplacer vers alerte.env.
