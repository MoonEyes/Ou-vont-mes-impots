# En-têtes HTTP du site (copié dans web/dist par publier.sh ; lu par Cloudflare, non servi).
# Une règle ne doit pas répéter un en-tête d'une autre règle qui la recouvre : Cloudflare joindrait les valeurs.
# CSP : identique à la balise <meta> de web/index.html, plus frame-ancestors (ignoré dans une balise meta).

/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; worker-src 'self'; manifest-src 'self'; frame-ancestors 'none'
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()
  Strict-Transport-Security: max-age=31536000

# page d'entrée : toujours revalidée, pour qu'une nouvelle version soit vue tout de suite
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache

# fichiers Vite nommés par empreinte : immuables
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# données mises à jour chaque semaine, noms stables : 1 h en cache, puis revalidation en arrière-plan
/data/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/favicon.svg
  Cache-Control: public, max-age=86400
/og.png
  Cache-Control: public, max-age=86400
