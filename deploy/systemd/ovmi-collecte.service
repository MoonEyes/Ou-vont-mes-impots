[Unit]
Description=Ou vont mes impots : collecte hebdomadaire vers le stockage objet (mode flux)
Documentation=https://github.com/MoonEyes/Ou-vont-mes-impots/blob/main/docs/STOCKAGE.md
Wants=network-online.target
After=network-online.target
OnFailure=ovmi-collecte-alerte.service

[Service]
Type=oneshot
User=ovmi
Group=ovmi
EnvironmentFile=/etc/ovmi/stockage.env
Environment=HOME=/var/lib/ovmi PYTHONUNBUFFERED=1 OVMI_RACINE=/var/lib/ovmi
WorkingDirectory=/var/lib/ovmi/ou-vont-mes-impots
ExecStart=/var/lib/ovmi/ou-vont-mes-impots/deploy/collecte-hebdo.sh
SyslogIdentifier=ovmi-collecte
# un passage complet (124 Go a collecter la premiere fois) peut durer longtemps : 3 jours au plus
TimeoutStartSec=3d

# Priorite basse : ne pas gener les autres services du VPS
Nice=19
CPUSchedulingPolicy=batch
IOSchedulingClass=idle
CPUWeight=20
IOWeight=20
CPUQuota=150%
MemoryHigh=1536M
MemoryMax=2G
MemorySwapMax=512M
TasksMax=128

# Confinement : utilisateur sans droits, seul /var/lib/ovmi est inscriptible
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/ovmi
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
UMask=0027
