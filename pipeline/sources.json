{
  "ods_base": "https://data.economie.gouv.fr/api/explore/v2.1/catalog/datasets",
  "eurostat_base": "https://ec.europa.eu/eurostat/api/dissemination/statistics/1.0/data",
  "ods": [
    {
      "id": "budget_etat_vert",
      "dataset": "plf-2026-budget-vert",
      "description": "Credits budgetaires de l'Etat par mission > programme > action : execution 2024 et LFI 2025 (CP), retraites au format PLF 2026 par la direction du budget. Base de l'arbre Etat.",
      "select": "type_depense,mission,numero_programme,programme,code_action_si_credit_budgetaire,action_si_credit_budgetaire,code_depense,libelle,execution_2024_cp,lfi_2025_cp_ou_prevision_2025_si_depense_fiscale",
      "where": "type_depense='Crédits budgétaires'"
    },
    {
      "id": "situation_budgetaire",
      "dataset": "situations-mensuelles-budgetaires-series-longues",
      "description": "Situation mensuelle budgetaire de l'Etat (DGFiP), execution au 31 decembre : solde budgetaire, depenses nettes, prelevements sur recettes, remboursements et degrevements",
      "select": "niveau_hierarchique,categorie,sous_categorie,ligne_d_information,`31_12_2024`,`31_12_2025`"
    },
    {
      "id": "budget_etat_plf",
      "dataset": "plf25-depenses-2025-du-bg-et-des-ba-selon-nomenclatures-destination-et-nature",
      "description": "Detail PLF 2025 (projet, pas le budget vote) : sous-action x nature (titre, categorie). Sert uniquement a la vue complementaire 'repartition par nature d'apres le PLF 2025'",
      "select": "type_mission,code_mission,mission,programme,libelle_programme,action,libelle_action,sous_action,libelle_sousaction,code_titre,categorie,ae_plf,cp_plf,ministere",
      "where": "type_mission='BG'"
    },
    {
      "id": "taux_communes",
      "dataset": "fiscalite-locale-des-particuliers",
      "description": "Taux de taxe fonciere (bati) et TEOM par commune, dernier exercice",
      "select": "exercice,com,libcom,dep,taux_global_tfb,taux_plein_teom",
      "latest_of": "exercice",
      "where": "exercice='{latest}'"
    }
  ],
  "eurostat": [
    {
      "id": "cofog_france",
      "dataset": "gov_10a_exp",
      "description": "Depenses publiques par fonction (COFOG niveau 1), France, toutes administrations (S13)",
      "params": {
        "geo": "FR",
        "unit": "MIO_EUR",
        "sector": "S13",
        "na_item": "TE",
        "lastTimePeriod": "3"
      }
    },
    {
      "id": "deficit_france",
      "dataset": "gov_10dd_edpt1",
      "description": "Solde public (B9) et dette, France, toutes administrations",
      "params": {
        "geo": "FR",
        "unit": "MIO_EUR",
        "sector": "S13",
        "na_item": "B9",
        "lastTimePeriod": "3"
      }
    },
    {
      "id": "cofog_administrations",
      "dataset": "gov_10a_exp",
      "description": "Depenses par fonction COFOG niveaux 1 et 2, par administration (Etat, local, Secu), depuis 2005",
      "params": {
        "geo": "FR",
        "unit": "MIO_EUR",
        "sector": [
          "S13",
          "S1311",
          "S1313",
          "S1314"
        ],
        "na_item": "TE",
        "sinceTimePeriod": "2005",
        "lang": "fr"
      }
    },
    {
      "id": "comptes_administrations",
      "dataset": "gov_10a_main",
      "description": "Recettes (TR), depenses (TE) et solde (B9) par administration, depuis 2005",
      "params": {
        "geo": "FR",
        "unit": "MIO_EUR",
        "sector": [
          "S13",
          "S1311",
          "S1313",
          "S1314"
        ],
        "na_item": [
          "TR",
          "TE",
          "B9",
          "D73PAY",
          "D92PAY",
          "D99PAY"
        ],
        "sinceTimePeriod": "2005",
        "lang": "fr"
      }
    },
    {
      "id": "recettes_impots",
      "dataset": "gov_10a_taxag",
      "description": "Recettes par impot et administration beneficiaire, depuis 2005",
      "params": {
        "geo": "FR",
        "unit": "MIO_EUR",
        "sector": [
          "S13",
          "S1311",
          "S1313",
          "S1314"
        ],
        "na_item": [
          "D211",
          "D214A",
          "D29",
          "D2",
          "D51A_C1",
          "D51B",
          "D5",
          "D61",
          "D91"
        ],
        "sinceTimePeriod": "2005",
        "lang": "fr"
      }
    }
  ],
  "ods_pieces_jointes": [
    {
      "id": "situation_budgetaire_lois",
      "dataset": "situations-mensuelles-budgetaires-series-longues",
      "piece_jointe": "textes_legislatifs_2024_xxcsv",
      "description": "Memes agregats que la situation mensuelle, en prevision : LFI, derniere LFR/LFG et execution, 2024 et 2025",
      "colonnes": [
        "Catégorie",
        "Sous-catégorie",
        "Ligne d'information",
        "Texte législatif",
        "2024",
        "2025"
      ]
    },
    {
      "id": "plrg_2024_cp",
      "dataset": "plrg-2024",
      "piece_jointe": "annexe1_etat_cp_2024_csv",
      "description": "PLRG 2024, annexe 1 : credits de paiement par programme du budget general (LFI 2024 et depenses constatees 2024)",
      "colonnes": [
        "Mission",
        "Programme",
        "Titre",
        "LFI",
        "Depenses_constatees"
      ]
    },
    {
      "id": "plrg_2025_cp",
      "dataset": "projet-de-loi-relatif-aux-resultats-de-la-gestion-et-portant-approbation-des-comptes-de-lannee-plrg-2025",
      "piece_jointe": "annexe1_etat_cp_2025csv",
      "description": "PLRG 2025, annexe 1 : credits de paiement par programme du budget general (LFI 2025 votee et depenses constatees 2025)",
      "colonnes": [
        "Mission",
        "Programme",
        "Titre",
        "LFI",
        "Depenses_constatees"
      ]
    }
  ]
}
