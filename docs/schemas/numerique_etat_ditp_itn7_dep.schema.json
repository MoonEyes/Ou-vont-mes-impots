{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ou-vont-mes-impots.fr/contrat/v1/numerique_etat_ditp_itn7_dep.schema.json",
  "title": "site/data/numerique_etat/fonds/ditp_itn7/<dep>.json : projets de collectivités financés par le fonds déconcentré ITN7 (DITP) dans un département",
  "allOf": [
    {
      "$ref": "commun.schema.json#/$defs/entete"
    }
  ],
  "type": "object",
  "properties": {
    "millesime": {
      "type": "string",
      "minLength": 4
    },
    "source": {
      "type": "string",
      "minLength": 10
    },
    "unite": {
      "type": "string",
      "minLength": 4
    },
    "collecte_le": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "avertissement": {
      "type": "string",
      "minLength": 40
    },
    "departement": {
      "type": "object",
      "required": [
        "code",
        "nom"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^([0-9]{2,3}|2A|2B)$"
        },
        "nom": {
          "type": "string"
        }
      }
    },
    "total": {
      "type": "object",
      "required": [
        "projets",
        "montant_publie_eur",
        "projets_sans_montant_publie"
      ],
      "additionalProperties": false,
      "properties": {
        "projets": {
          "type": "integer",
          "minimum": 0
        },
        "montant_publie_eur": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "projets_sans_montant_publie": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "ordre": {
      "type": "object",
      "required": [
        "regle",
        "cles"
      ],
      "properties": {
        "regle": {
          "type": "string"
        },
        "cles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "projets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "propertyNames": {
          "not": {
            "pattern": "(?i)pr[eé]nom|courriel|e-?mail|t[eé]l[eé]phone|adresse|contact|dirigeant|responsable"
          }
        },
        "required": [
          "collectivite",
          "code_insee",
          "projet",
          "type",
          "cout_total_projet_eur",
          "montant_eur"
        ],
        "properties": {
          "collectivite": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 160
          },
          "code_insee": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^([0-9][0-9AB][0-9]{3}|[0-9]{9})$"
          },
          "projet": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 200
          },
          "type": {
            "type": [
              "string",
              "null"
            ]
          },
          "cout_total_projet_eur": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "montant_eur": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          }
        }
      }
    }
  },
  "required": [
    "millesime",
    "source",
    "unite",
    "collecte_le",
    "departement",
    "total",
    "ordre",
    "projets"
  ]
}
