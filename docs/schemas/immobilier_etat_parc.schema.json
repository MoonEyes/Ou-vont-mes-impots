{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ou-vont-mes-impots.fr/contrat/v1/immobilier_etat_parc.schema.json",
  "title": "site/data/immobilier_etat/parc.json : inventaire (quatre périmètres), surfaces, valeur comptable, établissements publics, jeux ouverts agrégés",
  "allOf": [
    {
      "$ref": "commun.schema.json#/$defs/entete"
    }
  ],
  "type": "object",
  "properties": {
    "millesime": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "unite": {
      "type": "string",
      "minLength": 1
    },
    "avertissement": {
      "type": "string",
      "minLength": 20
    },
    "collecte_le": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "inventaire": {
      "type": "object",
      "required": [
        "source",
        "perimetres"
      ],
      "properties": {
        "perimetres": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "object",
            "required": [
              "id",
              "libelle",
              "annees",
              "batiments_nombre",
              "batiments_surface_millions_m2",
              "terrains_nombre",
              "terrains_surface",
              "terrains_unite",
              "total_nombre"
            ],
            "properties": {
              "id": {
                "enum": [
                  "global",
                  "occupes_etat_et_operateurs",
                  "occupes_etat",
                  "comptable"
                ]
              },
              "annees": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 1990,
                  "maximum": 2100
                },
                "minItems": 1
              },
              "batiments_nombre": {
                "type": "array",
                "items": {
                  "type": [
                    "integer",
                    "null"
                  ]
                }
              },
              "batiments_surface_millions_m2": {
                "type": "array",
                "items": {
                  "type": [
                    "number",
                    "null"
                  ]
                }
              },
              "terrains_nombre": {
                "type": "array",
                "items": {
                  "type": [
                    "integer",
                    "null"
                  ]
                }
              },
              "terrains_surface": {
                "type": "array",
                "items": {
                  "type": [
                    "number",
                    "null"
                  ]
                }
              },
              "total_nombre": {
                "type": "array",
                "items": {
                  "type": [
                    "integer",
                    "null"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "surfaces_batiments": {
      "type": "object",
      "required": [
        "etat_et_total",
        "par_type"
      ]
    },
    "valeur": {
      "type": "object",
      "required": [
        "controlee",
        "par_ministere"
      ],
      "properties": {
        "controlee": {
          "type": "object",
          "required": [
            "annees",
            "page",
            "millions_eur"
          ],
          "properties": {
            "annees": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1990,
                "maximum": 2100
              },
              "minItems": 1
            },
            "page": {
              "type": "integer"
            },
            "millions_eur": {
              "type": "array",
              "items": {
                "type": [
                  "number",
                  "null"
                ]
              }
            }
          }
        },
        "par_ministere": {
          "type": "object",
          "required": [
            "annees",
            "ministeres",
            "total_millions_eur"
          ],
          "properties": {
            "ministeres": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "ministere",
                  "millions_eur"
                ],
                "properties": {
                  "millions_eur": {
                    "type": "array",
                    "items": {
                      "type": [
                        "number",
                        "null"
                      ]
                    }
                  }
                }
              }
            },
            "total_millions_eur": {
              "type": "array",
              "items": {
                "type": [
                  "number",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    "operateurs": {
      "type": "object",
      "required": [
        "annees",
        "batiments_m2",
        "terrains_m2"
      ]
    },
    "jeu_ouvert": {
      "type": "object",
      "required": [
        "jeux",
        "types_batiments",
        "types_emprises"
      ],
      "properties": {
        "jeux": {
          "type": "object",
          "required": [
            "2021"
          ],
          "additionalProperties": {
            "type": "object",
            "required": [
              "annee",
              "jeu",
              "url",
              "biens",
              "par_ministere"
            ],
            "properties": {
              "par_ministere": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "biens",
                    "batiments",
                    "batiments_surface_m2",
                    "emprises",
                    "type_non_renseigne",
                    "batiments_surface_non_renseignee",
                    "ministere"
                  ],
                  "properties": {
                    "biens": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "batiments": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "batiments_surface_m2": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "emprises": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "type_non_renseigne": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "batiments_surface_non_renseignee": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              },
              "par_departement": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "biens",
                    "batiments",
                    "batiments_surface_m2",
                    "emprises",
                    "type_non_renseigne",
                    "batiments_surface_non_renseignee",
                    "departement"
                  ],
                  "properties": {
                    "biens": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "batiments": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "batiments_surface_m2": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "emprises": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "type_non_renseigne": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "batiments_surface_non_renseignee": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              },
              "par_type": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "type",
                    "groupe",
                    "biens",
                    "surface_m2"
                  ]
                }
              },
              "par_type_proprietaire": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "categorie",
                    "biens"
                  ],
                  "properties": {
                    "categorie": {
                      "type": "string",
                      "minLength": 1
                    },
                    "biens": {
                      "type": "integer"
                    }
                  }
                }
              },
              "par_type_gestionnaire": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "categorie",
                    "biens"
                  ],
                  "properties": {
                    "categorie": {
                      "type": "string",
                      "minLength": 1
                    },
                    "biens": {
                      "type": "integer"
                    }
                  }
                }
              },
              "par_pays_hors_france": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "categorie",
                    "biens"
                  ],
                  "properties": {
                    "categorie": {
                      "type": "string",
                      "minLength": 1
                    },
                    "biens": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "ordre": {
      "type": "object",
      "required": [
        "regle"
      ]
    }
  },
  "required": [
    "millesime",
    "source",
    "unite",
    "avertissement",
    "collecte_le",
    "inventaire",
    "surfaces_batiments",
    "valeur",
    "operateurs",
    "jeu_ouvert",
    "ordre"
  ]
}
