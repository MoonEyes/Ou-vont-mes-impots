{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ou-vont-mes-impots.fr/contrat/v1/aide_developpement_expertise_france.schema.json",
  "title": "site/data/aide_developpement/expertise_france.json : contrats d'Expertise France de plus de 15 000 euros, agrégés par pays, bailleur, année et type d'acte ; aucun attributaire nommé",
  "allOf": [
    {
      "$ref": "commun.schema.json#/$defs/entete"
    }
  ],
  "type": "object",
  "required": [
    "millesime",
    "source",
    "unite",
    "avertissement",
    "licence",
    "definitions",
    "regle_personnes",
    "annees",
    "ordre",
    "colonnes",
    "lignes",
    "par_bailleur",
    "par_pays",
    "ecartes",
    "limites",
    "sources_textes"
  ],
  "properties": {
    "millesime": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "unite": {
      "type": "string",
      "minLength": 1
    },
    "avertissement": {
      "type": "string",
      "minLength": 20,
      "pattern": "ne s'additionnent pas"
    },
    "collecte_le": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "licence": {
      "type": "string",
      "minLength": 1
    },
    "definitions": {
      "type": "object",
      "required": [
        "marche",
        "marche_subsequent",
        "subvention",
        "accord_cadre",
        "bailleur"
      ]
    },
    "regle_personnes": {
      "type": "string",
      "pattern": "personnes physiques"
    },
    "annees": {
      "type": "array",
      "minItems": 3,
      "items": {
        "$ref": "commun.schema.json#/$defs/annee_entier"
      }
    },
    "ordre": {
      "type": "object",
      "required": [
        "cles",
        "regle"
      ],
      "properties": {
        "cles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "regle": {
          "type": "string",
          "minLength": 20
        }
      }
    },
    "colonnes": {
      "const": [
        "annee",
        "pays",
        "bailleur",
        "type",
        "contrats",
        "montant_initial_maximal_eur"
      ]
    },
    "lignes": {
      "type": "array",
      "minItems": 100,
      "items": {
        "type": "array",
        "prefixItems": [
          {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 2000,
            "maximum": 2100
          },
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "string",
            "minLength": 1
          },
          {
            "enum": [
              "marche",
              "marche_subsequent",
              "subvention",
              "accord_cadre"
            ]
          },
          {
            "type": "integer",
            "minimum": 1
          },
          {
            "type": [
              "integer",
              "null"
            ]
          }
        ],
        "items": false,
        "minItems": 6
      }
    },
    "par_bailleur": {
      "type": "object",
      "required": [
        "colonnes",
        "lignes"
      ],
      "properties": {
        "colonnes": {
          "const": [
            "bailleur",
            "contrats",
            "montant_initial_maximal_eur",
            "accords_cadres",
            "plafonds_accords_cadres_eur"
          ]
        },
        "lignes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": [
                  "integer",
                  "null"
                ]
              },
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": [
                  "integer",
                  "null"
                ]
              }
            ],
            "items": false,
            "minItems": 5
          }
        }
      }
    },
    "par_pays": {
      "type": "object",
      "required": [
        "colonnes",
        "lignes"
      ],
      "properties": {
        "colonnes": {
          "const": [
            "pays",
            "contrats",
            "montant_initial_maximal_eur",
            "accords_cadres",
            "plafonds_accords_cadres_eur"
          ]
        },
        "lignes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": [
                  "integer",
                  "null"
                ]
              },
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": [
                  "integer",
                  "null"
                ]
              }
            ],
            "items": false,
            "minItems": 5
          }
        }
      }
    },
    "ecartes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "motif",
          "contrats"
        ],
        "properties": {
          "motif": {
            "type": "string",
            "minLength": 20
          },
          "contrats": {
            "type": "integer"
          }
        }
      }
    },
    "limites": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 20
      }
    },
    "sources_textes": {
      "type": "object",
      "minProperties": 1,
      "description": "Source de chaque champ texte explicatif (motif de chemin, indices remplacés par *) : « traitement » (règle appliquée par pipeline/aide_developpement.py), identifiant de sources[] d'index.json, « arbre » (budget de l'État) ou « citation:<id> » ; « citation » pour le texte d'une citation.",
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "pattern": "^(traitement|arbre|citation|citation:[a-z0-9_]+|[a-z0-9_]+)$"
        }
      }
    }
  }
}
