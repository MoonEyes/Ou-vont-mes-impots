{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://ou-vont-mes-impots.fr/contrat/v1/projets_subventionnes_index.schema.json",
 "title": "site/data/projets_subventionnes/index.json : dispositifs et statut publié, totaux du Fonds vert par année, départements, contrôles, sources, recherche préalable (pipeline/projets_subventionnes.py)",
 "allOf": [
  {
   "$ref": "commun.schema.json#/$defs/entete"
  }
 ],
 "type": "object",
 "required": [
  "millesime",
  "source",
  "unite",
  "date_sources",
  "statuts",
  "sans_projet",
  "dispositifs",
  "badges",
  "liens",
  "fonds_vert",
  "badges_totaux",
  "badges_hors_cog",
  "departements",
  "controles",
  "methode",
  "limites",
  "sources",
  "sources_inaccessibles",
  "recherche_publique",
  "ordre"
 ],
 "properties": {
  "unite": {
   "const": "€"
  },
  "date_sources": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
  },
  "statuts": {
   "type": "object",
   "required": [
    "dgcl",
    "fonds_vert"
   ],
   "properties": {
    "dgcl": {
     "const": "subvention attribuée"
    },
    "fonds_vert": {
     "const": "montant engagé"
    },
    "regle": {
     "type": "string"
    }
   }
  },
  "sans_projet": {
   "const": "aucun projet publié pour ces dispositifs"
  },
  "dispositifs": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "libelle",
     "source",
     "programme",
     "statut"
    ],
    "properties": {
     "id": {
      "type": "string"
     },
     "libelle": {
      "type": "string"
     },
     "source": {
      "enum": [
       "dgcl",
       "fonds_vert"
      ]
     },
     "programme": {
      "type": "string"
     },
     "statut": {
      "enum": [
       "subvention attribuée",
       "montant engagé"
      ]
     }
    }
   },
   "minItems": 2
  },
  "badges": {
   "type": "object",
   "required": [
    "acv",
    "pvd"
   ],
   "additionalProperties": {
    "type": "object",
    "required": [
     "libelle",
     "source",
     "definition"
    ]
   }
  },
  "liens": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "vue",
     "fichier",
     "lecture"
    ]
   }
  },
  "fonds_vert": {
   "type": "object",
   "required": [
    "statut",
    "methode",
    "par_annee",
    "intitules_retires",
    "note"
   ],
   "properties": {
    "statut": {
     "const": "calculé par le site"
    },
    "intitules_retires": {
     "type": "integer"
    },
    "par_annee": {
     "type": "object",
     "propertyNames": {
      "pattern": "^20[0-9]{2}$"
     },
     "additionalProperties": {
      "type": "object",
      "required": [
       "lignes",
       "montant_eur",
       "lignes_montant_non_communique",
       "projets_publies",
       "montant_publie_eur",
       "exclus",
       "non_localises"
      ],
      "properties": {
       "exclus": {
        "type": "object",
        "required": [
         "projets",
         "montant_eur",
         "dont_personnes_physiques",
         "dont_sans_siren",
         "dont_siren_introuvable",
         "dont_nom_de_personne_possible"
        ],
        "properties": {
         "projets": {
          "type": "integer",
          "minimum": 0
         },
         "montant_eur": {
          "type": "number",
          "minimum": 0
         },
         "dont_personnes_physiques": {
          "type": "integer",
          "minimum": 0
         },
         "dont_sans_siren": {
          "type": "integer",
          "minimum": 0
         },
         "dont_siren_introuvable": {
          "type": "integer",
          "minimum": 0
         },
         "dont_nom_de_personne_possible": {
          "type": "integer",
          "minimum": 0
         }
        },
        "additionalProperties": false
       },
       "non_localises": {
        "type": "object",
        "required": [
         "projets",
         "montant_eur"
        ]
       }
      }
     }
    }
   }
  },
  "badges_totaux": {
   "type": "object",
   "required": [
    "acv",
    "pvd"
   ]
  },
  "badges_hors_cog": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "badge",
     "insee"
    ]
   }
  },
  "departements": {
   "type": "array",
   "minItems": 101,
   "maxItems": 101,
   "items": {
    "type": "object",
    "required": [
     "code",
     "nom",
     "fichier",
     "fichier_dgcl",
     "fonds_vert_projets",
     "communes_avec_fonds_vert",
     "communes_acv",
     "communes_pvd"
    ],
    "properties": {
     "code": {
      "type": "string",
      "pattern": "^(\\d{2}|2A|2B|97\\d)$"
     },
     "fichier": {
      "type": "string",
      "pattern": "^projets_subventionnes/[0-9AB]+\\.json$"
     },
     "fichier_dgcl": {
      "type": [
       "string",
       "null"
      ]
     }
    }
   }
  },
  "controles": {
   "type": "object",
   "required": [
    "fonds_vert_subventions"
   ],
   "properties": {
    "fonds_vert_subventions": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "annee",
       "montant_eur",
       "autre_source",
       "autre_montant_eur",
       "ecart_eur",
       "lecture"
      ]
     }
    }
   }
  },
  "methode": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "limites": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "sources": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "titre",
     "page",
     "licence",
     "verdict"
    ]
   }
  },
  "sources_inaccessibles": {
   "type": "array"
  },
  "recherche_publique": {
   "type": "object",
   "required": [
    "date",
    "trouvailles"
   ]
  },
  "ordre": {
   "type": "string"
  }
 }
}
