{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ou-vont-mes-impots.fr/contrat/v1/arbre_administrations_methode.schema.json",
  "title": "site/data/arbre_administrations/methode.json : note de consolidation",
  "allOf": [
    {
      "$ref": "commun.schema.json#/$defs/entete"
    }
  ],
  "type": "object",
  "properties": {
    "annee": {
      "$ref": "commun.schema.json#/$defs/annee"
    },
    "unite": {
      "type": "string"
    },
    "lecture": {
      "type": "string",
      "minLength": 20
    },
    "somme_administrations_md": {
      "type": "number"
    },
    "total_consolide_md": {
      "type": "number"
    },
    "transferts_courants_entre_administrations_md": {
      "type": "number"
    },
    "ecart_consolidation_md": {
      "type": "number",
      "description": "somme_administrations_md - total_consolide_md, sur les valeurs publiées (la soustraction affichée est exacte)."
    },
    "ecart_depenses_totales_md": {
      "type": "number",
      "description": "Dépenses totales (TE, gov_10a_main) des trois administrations moins celles de l'ensemble : tous les transferts entre administrations."
    },
    "depenses_totales_ensemble_md": {
      "type": "number"
    },
    "ecart_tables_eurostat_md": {
      "type": "number",
      "description": "depenses_totales_ensemble_md (gov_10a_main) - total_consolide_md (gov_10a_exp)."
    },
    "definitions": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "required": [
    "annee",
    "lecture",
    "somme_administrations_md",
    "total_consolide_md",
    "transferts_courants_entre_administrations_md",
    "ecart_consolidation_md",
    "ecart_depenses_totales_md"
  ]
}
