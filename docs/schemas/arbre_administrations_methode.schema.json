{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ou-vont-mes-impots.fr/contrat/v1/arbre_administrations_methode.schema.json",
  "title": "site/data/arbre_administrations/methode.json : note de consolidation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "annee",
    "lecture",
    "somme_administrations_md",
    "total_consolide_md",
    "transferts_courants_entre_administrations_md",
    "ecart_consolidation_md"
  ],
  "properties": {
    "annee": {
      "type": "string",
      "pattern": "^(19|20)[0-9]{2}$"
    },
    "lecture": {
      "type": "string",
      "minLength": 10
    },
    "somme_administrations_md": {
      "type": "number",
      "description": "Montant en milliards d'euros"
    },
    "total_consolide_md": {
      "type": "number",
      "description": "Montant en milliards d'euros"
    },
    "transferts_courants_entre_administrations_md": {
      "type": "number",
      "description": "Montant en milliards d'euros"
    },
    "ecart_consolidation_md": {
      "type": "number",
      "description": "Montant en milliards d'euros"
    }
  }
}
