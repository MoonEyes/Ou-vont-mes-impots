{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ou-vont-mes-impots.fr/contrat/v1/immobilier_etat_loyers.schema.json",
  "title": "site/data/immobilier_etat/loyers.json : loyers payés, dépenses immobilières, prises à bail, grandes prises à bail, emphytéoses, loyers perçus",
  "allOf": [
    {
      "$ref": "commun.schema.json#/$defs/entete"
    }
  ],
  "type": "object",
  "properties": {
    "millesime": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "unite": {
      "type": "string",
      "minLength": 1
    },
    "avertissement": {
      "type": "string",
      "minLength": 20
    },
    "collecte_le": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "loyers_payes": {
      "type": "object",
      "required": [
        "annees",
        "page",
        "millions_eur",
        "indice_2014"
      ],
      "properties": {
        "annees": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1990,
            "maximum": 2100
          },
          "minItems": 1
        },
        "page": {
          "type": "integer"
        },
        "millions_eur": {
          "type": "array",
          "items": {
            "type": [
              "number",
              "null"
            ]
          }
        },
        "indice_2014": {
          "type": "array",
          "items": {
            "type": [
              "number",
              "null"
            ]
          }
        }
      }
    },
    "depenses_immobilieres": {
      "type": "object",
      "required": [
        "annees",
        "natures",
        "total_millions_eur"
      ]
    },
    "prises_a_bail": {
      "type": "object",
      "required": [
        "annees",
        "nombre"
      ]
    },
    "grandes_prises_a_bail": {
      "type": "object",
      "required": [
        "page",
        "baux"
      ],
      "properties": {
        "baux": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "ministere",
              "date_effet",
              "surface_m2",
              "occupant",
              "loyer_annuel_ht_eur",
              "departement",
              "prix_m2_eur"
            ],
            "properties": {
              "date_effet": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
              },
              "surface_m2": {
                "type": "number"
              },
              "loyer_annuel_ht_eur": {
                "type": "number"
              },
              "prix_m2_eur": {
                "type": "number"
              },
              "occupant": {
                "type": "string",
                "minLength": 1
              },
              "ministere": {
                "type": "string",
                "minLength": 1
              }
            },
            "not": {
              "anyOf": [
                {
                  "required": [
                    "bailleur"
                  ]
                },
                {
                  "required": [
                    "adresse"
                  ]
                }
              ]
            }
          }
        }
      }
    },
    "emphyteoses": {
      "type": "object",
      "required": [
        "annees",
        "nombre",
        "valeur_comptable_millions_eur"
      ]
    },
    "loyers_percus_par_l_etat": {
      "type": "object",
      "required": [
        "lignes"
      ],
      "properties": {
        "lignes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "annee",
              "code",
              "libelle",
              "execution_eur"
            ]
          }
        }
      }
    },
    "ordre": {
      "type": "object",
      "required": [
        "regle"
      ]
    }
  },
  "required": [
    "millesime",
    "source",
    "unite",
    "avertissement",
    "collecte_le",
    "loyers_payes",
    "depenses_immobilieres",
    "prises_a_bail",
    "grandes_prises_a_bail",
    "emphyteoses",
    "loyers_percus_par_l_etat",
    "ordre"
  ]
}
