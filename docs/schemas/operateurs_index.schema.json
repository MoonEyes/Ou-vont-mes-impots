{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ou-vont-mes-impots.fr/contrat/v1/operateurs_index.schema.json",
  "title": "site/data/operateurs/index.json : totaux par année, couverture, sources, recherche préalable et limites (pipeline/operateurs.py)",
  "allOf": [{"$ref": "commun.schema.json#/$defs/entete"}],
  "type": "object",
  "required": ["millesime", "source", "unite", "fichier", "annees", "couverture", "totaux", "sources", "recherche_prealable", "limites", "unites_source"],
  "properties": {
    "unite": {"type": "string"},
    "fichier": {"const": "operateurs/operateurs.json"},
    "annees": {"type": "array", "items": {"type": "integer"}},
    "couverture": {
      "type": "object",
      "required": ["lignes_jaune", "categories", "operateurs_liste_plf2026", "siren_resolus", "siren_a_resoudre", "annees_execution", "annees_lfi", "annees_absentes"],
      "properties": {
        "lignes_jaune": {"type": "integer", "minimum": 1},
        "categories": {"type": "integer", "minimum": 0},
        "operateurs_liste_plf2026": {"type": "integer", "minimum": 1},
        "siren_resolus": {"type": "integer", "minimum": 0},
        "siren_a_resoudre": {"type": "integer", "minimum": 0},
        "annees_execution": {"type": "array", "items": {"type": "integer"}},
        "annees_lfi": {"type": "array", "items": {"type": "integer"}},
        "annees_absentes": {"type": "object", "additionalProperties": {"type": "string"}}
      }
    },
    "totaux": {
      "type": "object",
      "propertyNames": {"pattern": "^20[0-9]{2}$"},
      "additionalProperties": {"type": "object", "required": ["lignes"], "additionalProperties": {"type": "number"}}
    },
    "sources": {"type": "object", "additionalProperties": {"type": "string", "minLength": 3}},
    "recherche_prealable": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["trouvaille", "verdict", "licence", "mise_a_jour", "usage"],
        "properties": {"verdict": {"enum": ["réutilisable tel quel", "à adapter", "inspiration seulement"]}}
      }
    },
    "limites": {"type": "array", "items": {"type": "string"}},
    "lignes_non_reconnues": {"type": "integer", "minimum": 0},
    "unites_source": {"type": "object", "additionalProperties": {"type": "string"}}
  }
}
