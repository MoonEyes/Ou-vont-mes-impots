{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://ou-vont-mes-impots.fr/contrat/v1/jurisprudence_comptes.schema.json",
 "title": "site/data/jurisprudence/comptes.json : nombre de décisions par année et juridiction, dont classées, matière fiscale (deux critères, jamais additionnés) et budgétaire",
 "allOf": [
  {
   "$ref": "commun.schema.json#/$defs/entete"
  }
 ],
 "type": "object",
 "required": [
  "millesime",
  "source",
  "date_sources",
  "unite",
  "colonnes",
  "lignes"
 ],
 "properties": {
  "date_sources": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
  },
  "colonnes": {
   "const": [
    "annee",
    "juridiction",
    "decisions",
    "classees",
    "fiscale_classement",
    "fiscale_type_recours",
    "budgetaire_classement"
   ]
  },
  "lignes": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "array",
    "minItems": 7,
    "maxItems": 7,
    "prefixItems": [
     {
      "type": "integer",
      "minimum": 1900
     },
     {
      "type": "string",
      "minLength": 3
     },
     {
      "type": "integer",
      "minimum": 0
     },
     {
      "type": "integer",
      "minimum": 0
     },
     {
      "type": "integer",
      "minimum": 0
     },
     {
      "type": "integer",
      "minimum": 0
     },
     {
      "type": "integer",
      "minimum": 0
     }
    ]
   }
  }
 }
}
