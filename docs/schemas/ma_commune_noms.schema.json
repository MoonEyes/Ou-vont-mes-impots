{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://ou-vont-mes-impots.fr/contrat/v1/ma_commune_noms.schema.json",
 "title": "site/data/ma_commune/noms/<préfixe>.json : noms de communes, de localités (ligne 5 de La Poste) et d'arrondissements dont la clé compacte commence par le préfixe [insee, nom, département, population, codes postaux, type] (pipeline/ma_commune.py)",
 "allOf": [
  {
   "$ref": "commun.schema.json#/$defs/entete"
  }
 ],
 "type": "object",
 "required": [
  "millesime",
  "source",
  "date_sources",
  "cle",
  "colonnes",
  "noms"
 ],
 "properties": {
  "date_sources": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
  },
  "cle": {
   "type": "string",
   "pattern": "^[a-z0-9]+$"
  },
  "colonnes": {
   "const": [
    "insee",
    "nom",
    "departement",
    "population",
    "codes_postaux",
    "type"
   ]
  },
  "noms": {
   "type": "array",
   "items": {
    "type": "array",
    "prefixItems": [
     {
      "type": "string",
      "pattern": "^(\\d{5}|2[AB]\\d{3})$"
     },
     {
      "type": "string",
      "minLength": 1
     },
     {
      "type": "string",
      "pattern": "^(\\d{2,3}|2[AB])$"
     },
     {
      "type": [
       "integer",
       "null"
      ],
      "minimum": 0
     },
     {
      "type": "string",
      "pattern": "^(\\d{5}( \\d{5})*)?$"
     },
     {
      "enum": [
       "commune",
       "localite",
       "arrondissement"
      ]
     }
    ],
    "minItems": 6,
    "maxItems": 6
   }
  }
 }
}
