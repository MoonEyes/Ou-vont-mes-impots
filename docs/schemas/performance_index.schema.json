{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ou-vont-mes-impots.fr/contrat/v1/performance_index.schema.json",
  "title": "site/data/performance/index.json : présentation, avertissements, règles, sources, missions et programmes (pipeline/performance.py)",
  "allOf": [
    {
      "$ref": "commun.schema.json#/$defs/entete"
    }
  ],
  "type": "object",
  "required": [
    "millesime",
    "source",
    "collecte_le",
    "presentation",
    "avertissements",
    "regles",
    "limites",
    "recherche_publique",
    "sources_performance",
    "miroirs_data_gouv",
    "non_exploites",
    "comptes",
    "missions",
    "fichiers",
    "liens",
    "ordre"
  ],
  "properties": {
    "collecte_le": {
      "type": "string",
      "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}$"
    },
    "presentation": {
      "type": "string",
      "minLength": 1
    },
    "avertissements": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "regles": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "limites": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "recherche_publique": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "trouvaille",
          "url",
          "verdict",
          "licence",
          "dernier_commit",
          "usage"
        ]
      }
    },
    "sources_performance": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "miroirs_data_gouv": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^https://"
      }
    },
    "non_exploites": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source",
          "url",
          "motif"
        ]
      }
    },
    "comptes": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "missions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "mission",
          "programmes"
        ],
        "properties": {
          "mission": {
            "type": "string",
            "minLength": 1
          },
          "programmes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "programme",
                "libelle",
                "mission",
                "nombre_indicateurs",
                "nombre_lignes",
                "annees",
                "fichier"
              ],
              "properties": {
                "programme": {
                  "type": "string",
                  "pattern": "^[0-9]{3}$"
                },
                "libelle": {
                  "type": "string",
                  "minLength": 1
                },
                "mission": {
                  "type": "string",
                  "minLength": 1
                },
                "nombre_indicateurs": {
                  "type": "integer"
                },
                "nombre_lignes": {
                  "type": "integer"
                },
                "annees": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 1990,
                    "maximum": 2100
                  }
                },
                "fichier": {
                  "type": "string",
                  "pattern": "^performance/programmes/[0-9]{3}\\.json$"
                }
              }
            }
          }
        }
      }
    },
    "fichiers": {
      "type": "object"
    },
    "liens": {
      "type": "object"
    },
    "ordre": {
      "type": "string",
      "minLength": 1
    }
  }
}
