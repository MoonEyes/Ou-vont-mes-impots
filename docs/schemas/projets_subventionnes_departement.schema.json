{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://ou-vont-mes-impots.fr/contrat/v1/projets_subventionnes_departement.schema.json",
 "title": "site/data/projets_subventionnes/<dep>.json : projets du Fonds vert par commune (montants engagés), badges Action cœur de ville et Petites villes de demain, lien vers les projets des dotations de l'État (territoires/<dep>.json) (pipeline/projets_subventionnes.py)",
 "allOf": [
  {
   "$ref": "commun.schema.json#/$defs/entete"
  }
 ],
 "type": "object",
 "required": [
  "millesime",
  "source",
  "unite",
  "date_sources",
  "departement",
  "liens",
  "statuts",
  "sans_projet",
  "format_fonds_vert",
  "demarches",
  "beneficiaires",
  "communes",
  "communes_hors_cog",
  "fonds_vert_totaux",
  "exclus_personnes_physiques_ou_non_identifies",
  "ordre"
 ],
 "properties": {
  "unite": {
   "const": "€"
  },
  "date_sources": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
  },
  "departement": {
   "type": "object",
   "required": [
    "code",
    "nom"
   ],
   "properties": {
    "code": {
     "type": "string",
     "pattern": "^(\\d{2}|2A|2B|97\\d)$"
    },
    "nom": {
     "type": "string"
    }
   }
  },
  "liens": {
   "type": "object",
   "required": [
    "dgcl",
    "geo",
    "index"
   ],
   "properties": {
    "dgcl": {
     "type": [
      "string",
      "null"
     ],
     "pattern": "^territoires/[0-9AB]+\\.json$"
    },
    "geo": {
     "type": "string"
    },
    "index": {
     "type": "string"
    }
   }
  },
  "statuts": {
   "type": "object",
   "required": [
    "dgcl",
    "fonds_vert"
   ],
   "properties": {
    "dgcl": {
     "const": "subvention attribuée"
    },
    "fonds_vert": {
     "const": "montant engagé"
    },
    "regle": {
     "type": "string"
    }
   }
  },
  "sans_projet": {
   "const": "aucun projet publié pour ces dispositifs"
  },
  "format_fonds_vert": {
   "const": [
    "annee",
    "programme",
    "demarche",
    "intitule",
    "montant_engage_eur",
    "beneficiaire_siren",
    "numero_engagement_juridique"
   ]
  },
  "demarches": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "beneficiaires": {
   "type": "object",
   "propertyNames": {
    "pattern": "^[0-9]{9}$"
   },
   "additionalProperties": {
    "type": "object",
    "required": [
     "nom",
     "categorie_juridique"
    ],
    "properties": {
     "nom": {
      "type": "string",
      "minLength": 1
     },
     "categorie_juridique": {
      "$ref": "commun.schema.json#/$defs/categorie_personne_morale"
     }
    },
    "additionalProperties": false
   }
  },
  "communes": {
   "type": "object",
   "propertyNames": {
    "pattern": "^(\\d{5}|2[AB]\\d{3})$"
   },
   "additionalProperties": {
    "type": "object",
    "required": [
     "nom"
    ],
    "properties": {
     "nom": {
      "type": "string"
     },
     "badges": {
      "type": "object",
      "properties": {
       "acv": {
        "type": "object",
        "required": [
         "id",
         "date_signature"
        ],
        "properties": {
         "id": {
          "type": [
           "string",
           "null"
          ]
         },
         "programme": {
          "type": [
           "string",
           "null"
          ]
         },
         "date_signature": {
          "type": [
           "string",
           "null"
          ],
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
         }
        },
        "additionalProperties": false
       },
       "pvd": {
        "type": "object",
        "required": [
         "id",
         "date_signature"
        ],
        "properties": {
         "id": {
          "type": [
           "string",
           "null"
          ]
         },
         "programme": {
          "type": [
           "string",
           "null"
          ]
         },
         "date_signature": {
          "type": [
           "string",
           "null"
          ],
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
         }
        },
        "additionalProperties": false
       }
      },
      "additionalProperties": false,
      "minProperties": 1
     },
     "fonds_vert": {
      "type": "array",
      "items": {
       "type": "array",
       "minItems": 7,
       "maxItems": 7,
       "prefixItems": [
        {
         "type": "integer",
         "minimum": 2018,
         "maximum": 2035
        },
        {
         "enum": [
          "380",
          "113"
         ]
        },
        {
         "type": [
          "integer",
          "null"
         ],
         "minimum": 0
        },
        {
         "type": [
          "string",
          "null"
         ],
         "maxLength": 300
        },
        {
         "type": [
          "number",
          "null"
         ]
        },
        {
         "$ref": "commun.schema.json#/$defs/siren"
        },
        {
         "type": [
          "string",
          "null"
         ],
         "pattern": "^[0-9]+$"
        }
       ]
      },
      "minItems": 1
     },
     "fonds_vert_totaux": {
      "type": "object",
      "propertyNames": {
       "pattern": "^20[0-9]{2}$"
      },
      "additionalProperties": {
       "type": "object",
       "required": [
        "projets",
        "montant_eur",
        "lignes_montant_non_communique"
       ],
       "properties": {
        "projets": {
         "type": "integer",
         "minimum": 1
        },
        "montant_eur": {
         "type": "number"
        },
        "lignes_montant_non_communique": {
         "type": "integer",
         "minimum": 0
        }
       },
       "additionalProperties": false
      }
     }
    },
    "additionalProperties": false
   }
  },
  "communes_hors_cog": {
   "type": "object",
   "propertyNames": {
    "pattern": "^(\\d{5}|2[AB]\\d{3})$"
   },
   "additionalProperties": {
    "type": "array",
    "items": {
     "type": "array",
     "minItems": 7,
     "maxItems": 7,
     "prefixItems": [
      {
       "type": "integer",
       "minimum": 2018,
       "maximum": 2035
      },
      {
       "enum": [
        "380",
        "113"
       ]
      },
      {
       "type": [
        "integer",
        "null"
       ],
       "minimum": 0
      },
      {
       "type": [
        "string",
        "null"
       ],
       "maxLength": 300
      },
      {
       "type": [
        "number",
        "null"
       ]
      },
      {
       "$ref": "commun.schema.json#/$defs/siren"
      },
      {
       "type": [
        "string",
        "null"
       ],
       "pattern": "^[0-9]+$"
      }
     ]
    },
    "minItems": 1
   }
  },
  "fonds_vert_totaux": {
   "type": "object",
   "required": [
    "statut",
    "methode",
    "par_annee"
   ],
   "properties": {
    "statut": {
     "const": "calculé par le site"
    },
    "methode": {
     "type": "string"
    },
    "par_annee": {
     "type": "object",
     "propertyNames": {
      "pattern": "^20[0-9]{2}$"
     },
     "additionalProperties": {
      "type": "object",
      "required": [
       "projets",
       "montant_eur",
       "lignes_montant_non_communique"
      ],
      "properties": {
       "projets": {
        "type": "integer",
        "minimum": 1
       },
       "montant_eur": {
        "type": "number"
       },
       "lignes_montant_non_communique": {
        "type": "integer",
        "minimum": 0
       }
      },
      "additionalProperties": false
     }
    }
   }
  },
  "exclus_personnes_physiques_ou_non_identifies": {
   "type": "object",
   "required": [
    "note",
    "par_annee"
   ],
   "properties": {
    "note": {
     "type": "string"
    },
    "par_annee": {
     "type": "object",
     "propertyNames": {
      "pattern": "^20[0-9]{2}$"
     },
     "additionalProperties": {
      "type": "object",
      "required": [
       "projets",
       "montant_eur",
       "dont_personnes_physiques",
       "dont_sans_siren",
       "dont_siren_introuvable",
       "dont_nom_de_personne_possible"
      ],
      "properties": {
       "projets": {
        "type": "integer",
        "minimum": 0
       },
       "montant_eur": {
        "type": "number",
        "minimum": 0
       },
       "dont_personnes_physiques": {
        "type": "integer",
        "minimum": 0
       },
       "dont_sans_siren": {
        "type": "integer",
        "minimum": 0
       },
       "dont_siren_introuvable": {
        "type": "integer",
        "minimum": 0
       },
       "dont_nom_de_personne_possible": {
        "type": "integer",
        "minimum": 0
       }
      },
      "additionalProperties": false
     }
    }
   }
  },
  "ordre": {
   "type": "string"
  }
 }
}
