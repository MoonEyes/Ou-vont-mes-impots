{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ou-vont-mes-impots.fr/contrat/v1/assurance_maladie_territoires_index.schema.json",
  "title": "site/data/assurance_maladie_territoires/index.json : présentation, totaux nationaux remboursés par grand poste, ONDAM résumé, écarts entre champs, liens, méthode, sources (pipeline/assurance_maladie_territoires.py)",
  "allOf": [
    {
      "$ref": "commun.schema.json#/$defs/entete"
    }
  ],
  "type": "object",
  "required": [
    "millesime",
    "source",
    "unite",
    "date_sources",
    "presentation",
    "fichiers",
    "annees_postes",
    "annees_departements",
    "annees_ondam",
    "nombre_departements",
    "totaux_nationaux",
    "ondam",
    "ecarts",
    "liens",
    "methode",
    "limites",
    "confidentialite",
    "regle",
    "ordre",
    "sources",
    "sources_inaccessibles",
    "recherche_publique"
  ],
  "properties": {
    "unite": {
      "type": "string",
      "minLength": 3
    },
    "date_sources": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "presentation": {
      "type": "string",
      "minLength": 50
    },
    "fichiers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "postes",
        "departements",
        "ondam"
      ],
      "properties": {
        "postes": {
          "const": "assurance_maladie_territoires/postes.json"
        },
        "departements": {
          "const": "assurance_maladie_territoires/departements.json"
        },
        "ondam": {
          "const": "assurance_maladie_territoires/ondam.json"
        }
      }
    },
    "annees_postes": {
      "type": "array",
      "items": {
        "$ref": "commun.schema.json#/$defs/annee_entier"
      },
      "minItems": 1
    },
    "annees_departements": {
      "type": "array",
      "items": {
        "$ref": "commun.schema.json#/$defs/annee_entier"
      },
      "minItems": 1
    },
    "annees_ondam": {
      "type": "array",
      "items": {
        "$ref": "commun.schema.json#/$defs/annee_entier"
      },
      "minItems": 1
    },
    "nombre_departements": {
      "type": "integer",
      "minimum": 100
    },
    "totaux_nationaux": {
      "type": "object",
      "required": [
        "unite",
        "source",
        "annees"
      ],
      "properties": {
        "annees": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[0-9]{4}$"
          },
          "additionalProperties": {
            "type": "object",
            "required": [
              "total",
              "soins_de_ville",
              "hospitalisations",
              "prestations_en_especes"
            ],
            "additionalProperties": {
              "type": [
                "integer",
                "null"
              ]
            }
          }
        }
      }
    },
    "ondam": {
      "type": "object",
      "required": [
        "annee",
        "objectif_initial_md",
        "objectif_rectifie_md",
        "constat_md",
        "source"
      ],
      "properties": {
        "annee": {
          "$ref": "commun.schema.json#/$defs/annee_entier"
        },
        "objectif_initial_md": {
          "type": [
            "number",
            "null"
          ]
        },
        "objectif_rectifie_md": {
          "type": [
            "number",
            "null"
          ]
        },
        "constat_md": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "ecarts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "grandeur",
          "annee",
          "valeur_md",
          "source",
          "autre_valeur_md",
          "autre_source",
          "lecture_ecart"
        ],
        "properties": {
          "annee": {
            "$ref": "commun.schema.json#/$defs/annee_entier"
          },
          "valeur_md": {
            "type": [
              "number",
              "null"
            ]
          },
          "autre_valeur_md": {
            "type": [
              "number",
              "null"
            ]
          },
          "lecture_ecart": {
            "type": "string",
            "minLength": 3
          }
        }
      }
    },
    "liens": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 3
      }
    },
    "methode": {
      "type": "string",
      "minLength": 3
    },
    "limites": {
      "type": "string",
      "minLength": 3
    },
    "confidentialite": {
      "type": "string",
      "minLength": 3
    },
    "regle": {
      "type": "string",
      "minLength": 3
    },
    "ordre": {
      "type": "string",
      "minLength": 3
    },
    "sources": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "url",
          "titre",
          "producteur",
          "millesime",
          "licence",
          "verdict",
          "entrepot"
        ],
        "properties": {
          "url": {
            "type": "string",
            "minLength": 3
          },
          "titre": {
            "type": "string",
            "minLength": 3
          },
          "producteur": {
            "type": "string",
            "minLength": 3
          },
          "millesime": {
            "type": "string",
            "minLength": 3
          },
          "licence": {
            "type": "string",
            "minLength": 3
          },
          "verdict": {
            "type": "string",
            "minLength": 3
          },
          "entrepot": {
            "type": "string",
            "minLength": 3
          },
          "collecte_le": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "sources_inaccessibles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "nom",
          "url",
          "motif"
        ]
      }
    },
    "recherche_publique": {
      "type": "object",
      "required": [
        "date",
        "requetes",
        "conclusion",
        "trouvailles"
      ],
      "properties": {
        "trouvailles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "nom",
              "url",
              "licence",
              "mise_a_jour",
              "verdict"
            ]
          }
        }
      }
    }
  }
}
