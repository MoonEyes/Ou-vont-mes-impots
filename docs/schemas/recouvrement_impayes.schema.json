{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://ou-vont-mes-impots.fr/contrat/v1/recouvrement_impayes.schema.json",
 "title": "site/data/recouvrement/impayes.json : taux d'impayés mensuels des cotisations (Urssaf), métropole et régions",
 "description": "Axe « recouvrement » (pipeline/recouvrement.py). Trois notions séparées : montant notifié, montant encaissé, estimation. Aucun total entre sphère fiscale et sphère sociale.",
 "allOf": [
  {
   "$ref": "commun.schema.json#/$defs/entete"
  }
 ],
 "type": "object",
 "properties": {
  "millesime": {
   "type": "string"
  },
  "source": {
   "type": "string"
  },
  "unite": {
   "type": "string",
   "minLength": 3
  },
  "avertissement": {
   "type": "string",
   "minLength": 20
  },
  "collecte_le": {
   "type": "string",
   "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
  },
  "sphere": {
   "const": "sociale"
  },
  "producteur": {
   "type": "string",
   "minLength": 3
  },
  "perimetre": {
   "type": "string",
   "minLength": 20
  },
  "methode": {
   "type": "string",
   "minLength": 20
  },
  "notion": {
   "const": "taux_impayes"
  },
  "taux": {
   "type": "object",
   "required": [
    "fin_mois",
    "fin_mois_suivant",
    "a_90_jours"
   ]
  },
  "national": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "source",
    "mois",
    "fin_mois",
    "fin_mois_suivant",
    "a_90_jours"
   ],
   "properties": {
    "source": {
     "type": "string"
    },
    "mois": {
     "type": "array",
     "minItems": 12,
     "items": {
      "type": "string",
      "pattern": "^(19|20)[0-9]{2}-[01][0-9]$"
     }
    },
    "fin_mois": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": [
       "number",
       "null"
      ]
     }
    },
    "fin_mois_suivant": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": [
       "number",
       "null"
      ]
     }
    },
    "a_90_jours": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": [
       "number",
       "null"
      ]
     }
    }
   }
  },
  "regions": {
   "type": "array",
   "minItems": 10,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "code_region",
     "region",
     "nom_tri",
     "mois",
     "fin_mois",
     "fin_mois_suivant",
     "a_90_jours"
    ],
    "properties": {
     "code_region": {
      "type": "string"
     },
     "region": {
      "type": "string"
     },
     "nom_tri": {
      "type": "string"
     },
     "mois": {
      "type": "array",
      "minItems": 12,
      "items": {
       "type": "string",
       "pattern": "^(19|20)[0-9]{2}-[01][0-9]$"
      }
     },
     "fin_mois": {
      "type": "array",
      "minItems": 1,
      "items": {
       "type": [
        "number",
        "null"
       ]
      }
     },
     "fin_mois_suivant": {
      "type": "array",
      "minItems": 1,
      "items": {
       "type": [
        "number",
        "null"
       ]
      }
     },
     "a_90_jours": {
      "type": "array",
      "minItems": 1,
      "items": {
       "type": [
        "number",
        "null"
       ]
      }
     }
    }
   }
  },
  "ordre": {
   "type": "object",
   "required": [
    "regle",
    "cles"
   ],
   "additionalProperties": false,
   "properties": {
    "regle": {
     "type": "string",
     "minLength": 10
    },
    "cles": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "string"
     }
    }
   }
  }
 },
 "required": [
  "millesime",
  "source",
  "unite",
  "avertissement",
  "collecte_le",
  "sphere",
  "producteur",
  "perimetre",
  "methode",
  "notion",
  "taux",
  "national",
  "regions",
  "ordre"
 ],
 "additionalProperties": false
}
