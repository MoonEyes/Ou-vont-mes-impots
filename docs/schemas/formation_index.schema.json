{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ou-vont-mes-impots.fr/contrat/v1/formation_index.schema.json",
  "title": "site/data/formation/index.json : CPF par année et financeur, formation des élus, FIPHFP, liens vers les financeurs, écarts entre sources, sources, recherche préalable",
  "allOf": [
    {
      "$ref": "commun.schema.json#/$defs/entete"
    }
  ],
  "type": "object",
  "properties": {
    "millesime": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "pattern": "Caisse des dépôts"
    },
    "unite": {
      "type": "string"
    },
    "collecte_le": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "avertissement": {
      "type": "string",
      "minLength": 40
    },
    "date_sources": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "fichiers": {
      "type": "object",
      "required": [
        "cpf_mois",
        "cpf_departements",
        "cpf_certifications",
        "cpf_organismes",
        "cpf_usagers",
        "elus",
        "fiphfp"
      ],
      "additionalProperties": {
        "type": "string",
        "pattern": "^formation/"
      }
    },
    "cpf": {
      "type": "object",
      "required": [
        "definition",
        "statuts",
        "retenus",
        "regle",
        "financeurs",
        "annees",
        "organismes"
      ],
      "properties": {
        "statuts": {
          "type": "object",
          "required": [
            "realise",
            "realise_partiellement",
            "en_cours",
            "annule"
          ]
        },
        "retenus": {
          "type": "array",
          "items": {
            "enum": [
              "realise",
              "realise_partiellement",
              "en_cours",
              "annule"
            ]
          }
        },
        "financeurs": {
          "type": "object",
          "required": [
            "france_competences",
            "titulaire",
            "etat",
            "france_travail",
            "regions",
            "opco",
            "entreprises",
            "cec"
          ],
          "additionalProperties": {
            "type": "string"
          }
        },
        "annees": {
          "type": "object",
          "minProperties": 5,
          "propertyNames": {
            "pattern": "^20[0-9]{2}$"
          },
          "additionalProperties": {
            "type": "object",
            "required": [
              "dossiers",
              "montant_eur",
              "financeurs_eur",
              "par_statut",
              "financeurs_pct",
              "dossiers_cofinances",
              "complete",
              "prix_moyen_eur"
            ],
            "properties": {
              "dossiers": {
                "type": "integer",
                "minimum": 0
              },
              "montant_eur": {
                "type": "integer",
                "minimum": 0
              },
              "financeurs_eur": {
                "type": "object",
                "required": [
                  "france_competences",
                  "titulaire",
                  "etat",
                  "france_travail",
                  "regions",
                  "opco",
                  "entreprises",
                  "cec"
                ],
                "additionalProperties": false,
                "properties": {
                  "france_competences": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "titulaire": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "etat": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "france_travail": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "regions": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "opco": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "entreprises": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "cec": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              },
              "par_statut": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "realise": {
                    "type": "object",
                    "required": [
                      "dossiers",
                      "montant_eur"
                    ],
                    "properties": {
                      "dossiers": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "montant_eur": {
                        "type": "integer",
                        "minimum": 0
                      }
                    }
                  },
                  "realise_partiellement": {
                    "type": "object",
                    "required": [
                      "dossiers",
                      "montant_eur"
                    ],
                    "properties": {
                      "dossiers": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "montant_eur": {
                        "type": "integer",
                        "minimum": 0
                      }
                    }
                  },
                  "en_cours": {
                    "type": "object",
                    "required": [
                      "dossiers",
                      "montant_eur"
                    ],
                    "properties": {
                      "dossiers": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "montant_eur": {
                        "type": "integer",
                        "minimum": 0
                      }
                    }
                  },
                  "annule": {
                    "type": "object",
                    "required": [
                      "dossiers",
                      "montant_eur"
                    ],
                    "properties": {
                      "dossiers": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "montant_eur": {
                        "type": "integer",
                        "minimum": 0
                      }
                    }
                  }
                }
              },
              "financeurs_pct": {
                "type": "object",
                "required": [
                  "france_competences",
                  "titulaire",
                  "etat",
                  "france_travail",
                  "regions",
                  "opco",
                  "entreprises",
                  "cec"
                ],
                "additionalProperties": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 100
                }
              },
              "dossiers_cofinances": {
                "type": "object",
                "additionalProperties": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "complete": {
                "type": "boolean"
              },
              "prix_moyen_eur": {
                "type": [
                  "integer",
                  "null"
                ]
              }
            }
          }
        },
        "organismes": {
          "type": "object",
          "required": [
            "fichier",
            "nommes",
            "agreges",
            "totaux",
            "estimation"
          ],
          "properties": {
            "estimation": {
              "const": "approché"
            }
          }
        }
      }
    },
    "elus": {
      "type": "object",
      "required": [
        "fichier",
        "annees",
        "totaux",
        "organismes_nommes",
        "organismes_agreges",
        "cellules_regroupees"
      ]
    },
    "fiphfp": {
      "type": "object",
      "required": [
        "fichier",
        "aides_totaux",
        "conventions_totaux"
      ]
    },
    "liens": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "vue",
          "fichier",
          "id",
          "nom",
          "lecture"
        ],
        "properties": {
          "vue": {
            "enum": [
              "operateurs",
              "arbre_etat"
            ]
          },
          "lecture": {
            "type": "string",
            "minLength": 40
          }
        }
      }
    },
    "ecarts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "annee",
          "source",
          "montant",
          "autre_source",
          "autre_montant",
          "autre_publie",
          "ecart",
          "ecart_pct",
          "lecture_ecart"
        ],
        "properties": {
          "annee": {
            "$ref": "commun.schema.json#/$defs/annee_entier"
          },
          "montant": {
            "type": "integer",
            "minimum": 0
          },
          "autre_montant": {
            "type": "integer",
            "minimum": 0
          },
          "ecart": {
            "type": "integer"
          },
          "ecart_pct": {
            "type": "number"
          }
        }
      }
    },
    "ecarts_source": {
      "type": "object",
      "required": [
        "document",
        "url",
        "champ"
      ]
    },
    "verification_documents": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "valeurs",
        "retrouvees"
      ]
    },
    "confidentialite": {
      "type": "object",
      "required": [
        "regle",
        "organismes_agreges"
      ]
    },
    "limites": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "string"
      }
    },
    "sources": {
      "type": "object",
      "minProperties": 9,
      "additionalProperties": {
        "type": "object",
        "required": [
          "jeu",
          "page",
          "requete",
          "licence"
        ]
      }
    },
    "sources_inaccessibles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source",
          "motif"
        ]
      }
    },
    "recherche_publique": {
      "type": "object",
      "required": [
        "date",
        "conclusion",
        "trouvailles"
      ],
      "properties": {
        "trouvailles": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "required": [
              "nom",
              "url",
              "licence",
              "mise_a_jour",
              "verdict"
            ],
            "properties": {
              "verdict": {
                "pattern": "^(réutilisable tel quel|à adapter|inspiration seulement)"
              }
            }
          }
        }
      }
    }
  },
  "required": [
    "millesime",
    "source",
    "unite",
    "collecte_le",
    "avertissement",
    "fichiers",
    "cpf",
    "elus",
    "fiphfp",
    "liens",
    "ecarts",
    "confidentialite",
    "limites",
    "sources",
    "sources_inaccessibles",
    "recherche_publique"
  ]
}
