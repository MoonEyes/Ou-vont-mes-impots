{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://ou-vont-mes-impots.fr/contrat/v1/fiscalite_locale_series_index.schema.json",
 "title": "site/data/fiscalite_locale_series/index.json : années, séries, variables REI lues, ruptures, renvois vers local/taux, fichiers par département, totaux nationaux, contrôles (pipeline/fiscalite_locale_series.py)",
 "allOf": [
  {
   "$ref": "commun.schema.json#/$defs/entete"
  }
 ],
 "type": "object",
 "required": [
  "millesime",
  "source",
  "date_sources",
  "presentation",
  "annees",
  "series",
  "definitions",
  "regle_null",
  "sans_objet",
  "deja_publie",
  "variables",
  "lecture_annees",
  "ruptures",
  "totaux_nationaux",
  "departements",
  "controles",
  "methode",
  "limites",
  "sources",
  "sources_inaccessibles",
  "recherche_publique",
  "ordre"
 ],
 "properties": {
  "annees": {
   "type": "array",
   "items": {
    "type": "string",
    "pattern": "^\\d{4}$"
   },
   "minItems": 1
  },
  "series": {
   "type": "object",
   "required": [
    "taux",
    "produits",
    "autres"
   ],
   "additionalProperties": {
    "type": "array",
    "items": {
     "type": "object",
     "required": [
      "cle",
      "libelle",
      "variables_candidates"
     ]
    }
   }
  },
  "variables": {
   "type": "object",
   "additionalProperties": {
    "type": "object",
    "additionalProperties": {
     "type": [
      "string",
      "null"
     ]
    }
   }
  },
  "ruptures": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "annee",
     "series",
     "constat"
    ]
   }
  },
  "totaux_nationaux": {
   "type": "object",
   "required": [
    "lecture",
    "produits"
   ],
   "properties": {
    "produits": {
     "type": "object",
     "additionalProperties": {
      "type": "array",
      "items": {
       "type": [
        "integer",
        "null"
       ]
      }
     }
    }
   }
  },
  "departements": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "departement",
     "parties"
    ],
    "properties": {
     "parties": {
      "type": "array",
      "minItems": 1,
      "items": {
       "type": "object",
       "required": [
        "fichier",
        "premier",
        "dernier",
        "communes"
       ],
       "properties": {
        "fichier": {
         "type": "string",
         "pattern": "^communes/[0-9AB]{2,3}(_\\d+)?\\.json$"
        },
        "communes": {
         "type": "integer",
         "minimum": 1
        }
       }
      }
     }
    }
   }
  },
  "controles": {
   "type": "object",
   "required": [
    "local_taux",
    "communes_par_annee",
    "taille_max_octets"
   ]
  },
  "sources": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "titre",
     "page",
     "licence"
    ]
   }
  },
  "recherche_publique": {
   "type": "object",
   "required": [
    "date",
    "trouvailles",
    "verdict"
   ],
   "properties": {
    "trouvailles": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "nom",
       "url",
       "licence",
       "derniere_modification",
       "verdict"
      ],
      "properties": {
       "verdict": {
        "enum": [
         "réutilisable tel quel",
         "à adapter",
         "inspiration seulement"
        ]
       }
      }
     }
    }
   }
  }
 }
}
