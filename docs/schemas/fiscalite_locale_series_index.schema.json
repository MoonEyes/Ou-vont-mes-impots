{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ou-vont-mes-impots.fr/contrat/v1/fiscalite_locale_series_index.schema.json",
  "title": "site/data/fiscalite_locale_series/index.json : variables, codes REI par année, notes de rupture, complément local/taux, totaux nationaux, sources (pipeline/fiscalite_locale_series.py)",
  "allOf": [{"$ref": "commun.schema.json#/$defs/entete"}],
  "type": "object",
  "$defs": {
    "variable": {"type": "object",
      "properties": {"cle": {"type": "string", "pattern": "^[a-z_]+$"}, "libelle": {"type": "string", "minLength": 3},
        "unite": {"enum": ["%", "euros"]}},
      "required": ["cle", "libelle", "unite"], "additionalProperties": false},
    "parties": {"type": "array", "minItems": 1, "items": {"type": "object",
      "properties": {"fichier": {"type": "string", "pattern": "^(taux|produits)/([0-9]{2}|2[AB]|97[0-9])(-[0-9]+)?\\.json$"},
        "premiere_commune": {"type": "string", "pattern": "^([0-9]{5}|2[AB][0-9]{3})$"},
        "derniere_commune": {"type": "string", "pattern": "^([0-9]{5}|2[AB][0-9]{3})$"}},
      "required": ["fichier", "premiere_commune", "derniere_commune"], "additionalProperties": false}},
    "codes": {"type": "object", "additionalProperties": {"type": "object",
      "propertyNames": {"$ref": "commun.schema.json#/$defs/annee"},
      "additionalProperties": {"type": ["string", "null"]}}}
  },
  "properties": {
    "millesime": {"type": "string"}, "source": {"type": "string"},
    "licence": {"type": "string"},
    "producteur": {"type": "string"},
    "perimetre": {"type": "string"},
    "methode": {"type": "string"},
    "annees": {"type": "array", "items": {"$ref": "commun.schema.json#/$defs/annee_entier"}, "minItems": 1},
    "variables": {"type": "object", "required": ["taux", "produits"], "additionalProperties": false,
      "properties": {"taux": {"type": "array", "items": {"$ref": "#/$defs/variable"}, "minItems": 1},
        "produits": {"type": "array", "items": {"$ref": "#/$defs/variable"}, "minItems": 1}}},
    "codes_rei": {"type": "object", "required": ["taux", "produits"], "additionalProperties": false,
      "properties": {"taux": {"$ref": "#/$defs/codes"}, "produits": {"$ref": "#/$defs/codes"}}},
    "notes": {"type": "array", "minItems": 1, "items": {"type": "object",
      "properties": {"cle": {"type": "string"}, "texte": {"type": "string", "minLength": 10}},
      "required": ["cle", "texte"], "additionalProperties": false}},
    "complement_local_taux": {"type": "object",
      "properties": {
        "principe": {"type": "string"},
        "colonnes": {"type": "object", "additionalProperties": {"type": "string"}},
        "exercices_par_departement": {"type": "object", "additionalProperties": {"type": "array",
          "items": {"$ref": "commun.schema.json#/$defs/annee_entier"}}},
        "ecarts_taux_nets_votes": {"type": "object",
          "properties": {"comparaisons": {"type": "integer"}, "egales": {"type": "integer"},
            "differentes": {"type": "integer"}, "absentes_de_local": {"type": "integer"}, "lecture": {"type": "string"}},
          "required": ["comparaisons", "egales", "differentes", "absentes_de_local", "lecture"]}},
      "required": ["principe", "colonnes", "exercices_par_departement", "ecarts_taux_nets_votes"]},
    "communes_par_annee": {"type": "object", "propertyNames": {"$ref": "commun.schema.json#/$defs/annee"},
      "additionalProperties": {"type": "integer", "minimum": 1}},
    "totaux_nationaux_produits": {"type": "object",
      "properties": {"unite": {"const": "euros"}, "lecture": {"type": "string"},
        "series": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": ["integer", "null"]}}}},
      "required": ["unite", "lecture", "series"]},
    "sources_par_annee": {"type": "array", "minItems": 1, "items": {"type": "object",
      "properties": {"annee": {"$ref": "commun.schema.json#/$defs/annee_entier"},
        "url": {"type": "string", "pattern": "^https://data\\.economie\\.gouv\\.fr/"},
        "fichier": {"type": ["string", "null"]}, "octets": {"type": ["integer", "null"]},
        "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}},
      "required": ["annee", "url", "fichier", "octets", "sha256"], "additionalProperties": false}},
    "departements": {"type": "array", "minItems": 1, "items": {"type": "object",
      "properties": {"departement": {"type": "string", "pattern": "^([0-9]{2}|2[AB]|97[0-9])$"},
        "communes": {"type": "integer", "minimum": 1},
        "taux": {"$ref": "#/$defs/parties"}, "produits": {"$ref": "#/$defs/parties"}},
      "required": ["departement", "communes", "taux", "produits"], "additionalProperties": false}},
    "recherche_publique": {"type": "object"}
  },
  "required": ["millesime", "source", "licence", "producteur", "perimetre", "methode", "annees", "variables",
    "codes_rei", "notes", "complement_local_taux", "communes_par_annee", "totaux_nationaux_produits",
    "sources_par_annee", "departements"],
  "additionalProperties": false
}
