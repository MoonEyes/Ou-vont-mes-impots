{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ou-vont-mes-impots.fr/contrat/v1/aide_developpement_index.schema.json",
  "title": "site/data/aide_developpement/index.json : grandeurs de l'aide au développement (jamais additionnées), lien avec la mission budgétaire, totaux par grandeur, écarts entre sources, sources et licences",
  "allOf": [
    {
      "$ref": "commun.schema.json#/$defs/entete"
    }
  ],
  "type": "object",
  "required": [
    "millesime",
    "source",
    "unite",
    "avertissement",
    "regle",
    "financement_des_prets",
    "grandeurs",
    "credits_budgetaires",
    "totaux",
    "ecarts",
    "fichiers",
    "sources",
    "sources_inaccessibles",
    "limites",
    "recherche_publique"
  ],
  "properties": {
    "millesime": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "unite": {
      "type": "string",
      "minLength": 1
    },
    "avertissement": {
      "type": "string",
      "minLength": 20,
      "pattern": "ne s'additionnent pas"
    },
    "collecte_le": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "regle": {
      "type": "string",
      "pattern": "ne s'additionnent pas"
    },
    "financement_des_prets": {
      "type": "object",
      "required": [
        "texte",
        "producteur",
        "perimetre",
        "methode"
      ]
    },
    "grandeurs": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": [
          "id",
          "nom",
          "producteur",
          "unite",
          "perimetre",
          "methode",
          "financement",
          "fichier"
        ],
        "properties": {
          "id": {
            "enum": [
              "credits_budgetaires",
              "apd_declaree",
              "afd",
              "proparco",
              "expertise_france",
              "ocde"
            ]
          },
          "fichier": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "credits_budgetaires": {
      "type": "object",
      "required": [
        "unite",
        "source",
        "vues",
        "lecture"
      ],
      "properties": {
        "vues": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "vue",
              "millesime",
              "mission",
              "programmes"
            ],
            "properties": {
              "mission": {
                "type": "object",
                "required": [
                  "id",
                  "nom",
                  "md"
                ]
              },
              "programmes": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "numero",
                    "nom",
                    "md",
                    "fichier"
                  ],
                  "properties": {
                    "numero": {
                      "type": "string",
                      "pattern": "^[0-9]{3}$"
                    },
                    "md": {
                      "type": [
                        "number",
                        "null"
                      ]
                    },
                    "fichier": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "totaux": {
      "type": "object",
      "required": [
        "note",
        "apd_declaree",
        "afd",
        "ocde"
      ],
      "additionalProperties": false,
      "properties": {
        "note": {
          "type": "string",
          "minLength": 20
        },
        "apd_declaree": {
          "type": "object",
          "required": [
            "perimetre",
            "colonnes",
            "lignes"
          ],
          "properties": {
            "lignes": {
              "type": "array",
              "minItems": 3,
              "items": {
                "type": "array",
                "prefixItems": [
                  {
                    "$ref": "commun.schema.json#/$defs/annee_entier"
                  },
                  {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  {
                    "type": [
                      "number",
                      "null"
                    ]
                  }
                ],
                "items": false,
                "minItems": 6
              }
            }
          }
        },
        "afd": {
          "type": "object",
          "required": [
            "perimetre",
            "colonnes",
            "lignes"
          ],
          "properties": {
            "lignes": {
              "type": "array",
              "minItems": 3,
              "items": {
                "type": "array",
                "prefixItems": [
                  {
                    "$ref": "commun.schema.json#/$defs/annee_entier"
                  },
                  {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  {
                    "type": [
                      "number",
                      "null"
                    ]
                  }
                ],
                "items": false,
                "minItems": 5
              }
            }
          }
        },
        "ocde": {
          "type": "object",
          "required": [
            "perimetre",
            "colonnes",
            "lignes"
          ],
          "properties": {
            "lignes": {
              "type": "array",
              "minItems": 3,
              "items": {
                "type": "array",
                "prefixItems": [
                  {
                    "$ref": "commun.schema.json#/$defs/annee_entier"
                  },
                  {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  {
                    "type": [
                      "number",
                      "null"
                    ]
                  }
                ],
                "items": false,
                "minItems": 8
              }
            }
          }
        }
      }
    },
    "ecarts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "annee",
          "comparaison",
          "unite",
          "source",
          "montant",
          "autre_source",
          "autre_montant",
          "ecart",
          "ecart_pct",
          "lecture"
        ],
        "properties": {
          "annee": {
            "$ref": "commun.schema.json#/$defs/annee_entier"
          },
          "comparaison": {
            "type": "string",
            "minLength": 1
          },
          "unite": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "montant": {
            "type": "number"
          },
          "autre_source": {
            "type": "string",
            "minLength": 1
          },
          "autre_montant": {
            "type": "number"
          },
          "ecart": {
            "type": "number"
          },
          "ecart_pct": {
            "type": [
              "number",
              "null"
            ]
          },
          "lecture": {
            "type": "string",
            "minLength": 20
          }
        }
      }
    },
    "ecarts_note": {
      "type": "string",
      "minLength": 20
    },
    "fichiers": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": [
          "fichier",
          "contenu"
        ],
        "properties": {
          "fichier": {
            "type": "string",
            "pattern": "^aide_developpement/[a-z_]+\\.json$"
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "required": [
          "id",
          "nom",
          "url",
          "licence",
          "producteur",
          "collecte_le"
        ]
      }
    },
    "sources_inaccessibles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source",
          "constat"
        ]
      }
    },
    "limites": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 20
      }
    },
    "recherche_publique": {
      "type": "object",
      "required": [
        "date",
        "conclusion",
        "trouvailles"
      ],
      "properties": {
        "trouvailles": {
          "type": "array",
          "minItems": 5,
          "items": {
            "type": "object",
            "required": [
              "nom",
              "url",
              "verdict",
              "licence",
              "mise_a_jour"
            ],
            "properties": {
              "verdict": {
                "enum": [
                  "réutilisable tel quel",
                  "à adapter",
                  "inspiration seulement"
                ]
              }
            }
          }
        }
      }
    }
  }
}
