{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ou-vont-mes-impots.fr/contrat/v1/fonction_publique_cabinets.schema.json",
  "title": "site/data/fonction_publique/cabinets.json : personnels affectés dans les cabinets ministériels, agrégats par pôle ministériel (jaunes PLF), aucun nom",
  "allOf": [
    {
      "$ref": "commun.schema.json#/$defs/entete"
    }
  ],
  "type": "object",
  "required": [
    "millesime",
    "source",
    "collecte_le",
    "unite",
    "definitions",
    "regle_personnes",
    "methode",
    "limites",
    "situations"
  ],
  "properties": {
    "collecte_le": {
      "type": "string",
      "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}$"
    },
    "unite": {
      "type": "string",
      "minLength": 1
    },
    "definitions": {
      "type": "object",
      "required": [
        "membres_cabinet",
        "fonctions_support",
        "dotation_isp_eur"
      ],
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "regle_personnes": {
      "type": "string",
      "minLength": 1
    },
    "methode": {
      "type": "string",
      "minLength": 1
    },
    "limites": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "situations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "annee",
          "date_situation",
          "total",
          "nb_cabinets",
          "par_fonction",
          "par_position_statutaire",
          "poles",
          "edition",
          "source"
        ],
        "additionalProperties": false,
        "propertyNames": {
          "not": {
            "pattern": "(?i)^(pr[eé]nom|nom|nom_prenom|civilite|dirigeant|responsable|adresse|courriel|email|telephone|ministre|elu)$"
          }
        },
        "properties": {
          "annee": {
            "$ref": "commun.schema.json#/$defs/annee_entier"
          },
          "date_situation": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}$"
          },
          "total": {
            "type": "object",
            "required": [
              "effectif_total",
              "membres_cabinet",
              "fonctions_support",
              "dotation_isp_eur"
            ],
            "additionalProperties": {
              "type": "integer",
              "minimum": 0
            }
          },
          "nb_cabinets": {
            "type": "integer",
            "minimum": 1
          },
          "par_fonction": {
            "type": "object",
            "required": [
              "membres",
              "fonctions_support",
              "total"
            ],
            "additionalProperties": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            }
          },
          "par_position_statutaire": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": [
                "membres_cabinet",
                "fonctions_support"
              ],
              "additionalProperties": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              }
            }
          },
          "poles": {
            "type": "array",
            "minItems": 5,
            "items": {
              "type": "object",
              "required": [
                "pole",
                "nb_cabinets",
                "effectif_total",
                "membres_cabinet",
                "fonctions_support",
                "dotation_isp_eur",
                "ministeres_budget"
              ],
              "additionalProperties": false,
              "properties": {
                "pole": {
                  "type": "string",
                  "minLength": 1,
                  "not": {
                    "pattern": "(?i)^(ministre|secr[eé]taire d|garde des|premi(er|ère) ministre$)"
                  }
                },
                "nb_cabinets": {
                  "type": "integer",
                  "minimum": 1
                },
                "effectif_total": {
                  "type": "integer",
                  "minimum": 0
                },
                "membres_cabinet": {
                  "type": "integer",
                  "minimum": 0
                },
                "fonctions_support": {
                  "type": "integer",
                  "minimum": 0
                },
                "dotation_isp_eur": {
                  "type": "integer",
                  "minimum": 0
                },
                "ministeres_budget": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z0-9_]+$"
                  }
                },
                "libelle_restitue": {
                  "const": true
                }
              }
            }
          },
          "edition": {
            "type": "string",
            "pattern": "^PLF 20[0-9]{2}$"
          },
          "source": {
            "type": "string",
            "minLength": 3
          }
        }
      }
    }
  }
}
