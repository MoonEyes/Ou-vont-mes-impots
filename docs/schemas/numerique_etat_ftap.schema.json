{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ou-vont-mes-impots.fr/contrat/v1/numerique_etat_ftap.schema.json",
  "title": "site/data/numerique_etat/fonds/ftap.json : lauréats des guichets numériques du Fonds pour la transformation de l'action publique",
  "allOf": [
    {
      "$ref": "commun.schema.json#/$defs/entete"
    }
  ],
  "type": "object",
  "properties": {
    "millesime": {
      "type": "string",
      "minLength": 4
    },
    "source": {
      "type": "string",
      "minLength": 10
    },
    "unite": {
      "type": "string",
      "minLength": 4
    },
    "collecte_le": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "avertissement": {
      "type": "string",
      "minLength": 40
    },
    "arbre_etat": {
      "type": "object",
      "required": [
        "programme",
        "noeud",
        "nom_programme",
        "fichier",
        "action",
        "nom_action",
        "rattachement"
      ],
      "properties": {
        "programme": {
          "type": "string",
          "pattern": "^[0-9]{3}$"
        },
        "noeud": {
          "type": "string"
        },
        "fichier": {
          "type": "string",
          "pattern": "^arbre/.+\\.json$"
        },
        "action": {
          "type": "string",
          "pattern": "^[0-9]{3}-[0-9]{2}$"
        },
        "nom_action": {
          "type": "string"
        },
        "rattachement": {
          "type": "string"
        }
      }
    },
    "definitions": {
      "type": "object"
    },
    "total": {
      "type": "object",
      "required": [
        "projets",
        "montant_publie_eur",
        "projets_sans_montant_publie"
      ],
      "additionalProperties": false,
      "properties": {
        "projets": {
          "type": "integer",
          "minimum": 0
        },
        "montant_publie_eur": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "projets_sans_montant_publie": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "par_guichet": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "guichet",
          "projets",
          "montant_publie_eur",
          "projets_sans_montant_publie"
        ],
        "properties": {
          "guichet": {
            "type": [
              "string",
              "null"
            ]
          },
          "projets": {
            "type": "integer"
          },
          "montant_publie_eur": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "projets_sans_montant_publie": {
            "type": "integer"
          }
        }
      }
    },
    "par_ministere": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "ministere",
          "projets",
          "montant_publie_eur",
          "projets_sans_montant_publie"
        ],
        "properties": {
          "ministere": {
            "type": [
              "string",
              "null"
            ]
          },
          "projets": {
            "type": "integer"
          },
          "montant_publie_eur": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "projets_sans_montant_publie": {
            "type": "integer"
          }
        }
      }
    },
    "par_annee": {
      "type": "null"
    },
    "par_annee_note": {
      "type": "string",
      "minLength": 10
    },
    "ordre": {
      "type": "object",
      "required": [
        "regle",
        "cles"
      ],
      "properties": {
        "regle": {
          "type": "string"
        },
        "cles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "laureats": {
      "type": "array",
      "minItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "propertyNames": {
          "not": {
            "pattern": "(?i)pr[eé]nom|courriel|e-?mail|t[eé]l[eé]phone|adresse|contact|dirigeant|responsable"
          }
        },
        "required": [
          "guichet",
          "projet",
          "incubateur",
          "ministere",
          "porteur",
          "montant_eur"
        ],
        "properties": {
          "guichet": {
            "type": [
              "string",
              "null"
            ]
          },
          "projet": {
            "type": [
              "string",
              "null"
            ]
          },
          "incubateur": {
            "type": [
              "string",
              "null"
            ]
          },
          "ministere": {
            "type": [
              "string",
              "null"
            ]
          },
          "porteur": {
            "type": [
              "string",
              "null"
            ]
          },
          "montant_eur": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          }
        }
      }
    }
  },
  "required": [
    "millesime",
    "source",
    "unite",
    "collecte_le",
    "avertissement",
    "arbre_etat",
    "total",
    "par_guichet",
    "par_ministere",
    "par_annee",
    "par_annee_note",
    "ordre",
    "laureats"
  ]
}
