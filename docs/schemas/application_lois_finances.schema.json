{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ou-vont-mes-impots.fr/contrat/v1/application_lois_finances.schema.json",
  "title": "site/data/application_lois/lois_finances.json : lois de finances et de financement de la Sécurité sociale, mesures d'application prévues et publiées, du plus récent au plus ancien",
  "allOf": [
    {
      "$ref": "commun.schema.json#/$defs/entete"
    }
  ],
  "type": "object",
  "required": [
    "millesime",
    "source",
    "unite",
    "collecte_le",
    "ordre",
    "avertissement",
    "methode",
    "categories",
    "lois"
  ],
  "properties": {
    "millesime": {
      "type": "string",
      "minLength": 10
    },
    "source": {
      "type": "string",
      "minLength": 20
    },
    "unite": {
      "type": "string",
      "minLength": 4
    },
    "collecte_le": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "ordre": {
      "type": "object",
      "required": [
        "regle",
        "cles"
      ],
      "properties": {
        "regle": {
          "type": "string",
          "minLength": 20
        },
        "cles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "avertissement": {
      "type": "string",
      "minLength": 80
    },
    "methode": {
      "type": "string",
      "minLength": 80
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "categorie",
          "libelle",
          "lois"
        ],
        "properties": {
          "categorie": {
            "enum": [
              "lfss_rectificative",
              "lfss",
              "approbation_comptes_secu",
              "lf_rectificative",
              "lf_fin_de_gestion",
              "lf_initiale",
              "loi_speciale",
              "reglement",
              "programmation_finances_publiques"
            ]
          },
          "libelle": {
            "type": "string"
          },
          "lois": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "lois": {
      "type": "array",
      "minItems": 50,
      "items": {
        "allOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "titre",
              "date_publication",
              "annee",
              "legislature",
              "categorie",
              "categorie_libelle",
              "commission_saisie_au_fond",
              "application_directe",
              "sans_echeancier",
              "ratification_accords",
              "habilitation_ordonnances",
              "ratification_ordonnances",
              "mesures_a_appliquer",
              "mesures_appliquees",
              "mesures_en_attente",
              "mesures_sans_objet",
              "mesures_dans_l_echeancier",
              "taux_application_publie",
              "taux_note",
              "comptes_coherents",
              "delais",
              "url_legifrance",
              "url_dossier_legislatif",
              "fichier_mesures"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^JORFTEXT[0-9]{12}$"
              },
              "titre": {
                "type": "string",
                "minLength": 10
              },
              "date_publication": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
              },
              "annee": {
                "type": "integer",
                "minimum": 2000,
                "maximum": 2100
              },
              "legislature": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1
              },
              "categorie": {
                "enum": [
                  null,
                  "lfss_rectificative",
                  "lfss",
                  "approbation_comptes_secu",
                  "lf_rectificative",
                  "lf_fin_de_gestion",
                  "lf_initiale",
                  "loi_speciale",
                  "reglement",
                  "programmation_finances_publiques"
                ]
              },
              "categorie_libelle": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "commission_saisie_au_fond": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "application_directe": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "sans_echeancier": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "ratification_accords": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "habilitation_ordonnances": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "ratification_ordonnances": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "mesures_a_appliquer": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "mesures_appliquees": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "mesures_en_attente": {
                "type": "integer",
                "minimum": 0
              },
              "mesures_sans_objet": {
                "type": "integer",
                "minimum": 0
              },
              "mesures_dans_l_echeancier": {
                "type": "integer",
                "minimum": 0
              },
              "taux_application_publie": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1
              },
              "taux_note": {
                "type": "string",
                "minLength": 20
              },
              "comptes_coherents": {
                "type": "boolean"
              },
              "delais": {
                "type": [
                  "object",
                  "null"
                ],
                "additionalProperties": false,
                "required": [
                  "mesures",
                  "minimum_jours",
                  "mediane_jours",
                  "maximum_jours",
                  "calcule_par_le_site",
                  "methode"
                ],
                "properties": {
                  "mesures": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "minimum_jours": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "mediane_jours": {
                    "type": "number",
                    "minimum": 0
                  },
                  "maximum_jours": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "calcule_par_le_site": {
                    "const": true
                  },
                  "methode": {
                    "type": "string",
                    "minLength": 40
                  }
                }
              },
              "url_legifrance": {
                "type": "string",
                "pattern": "^https://www\\.legifrance\\.gouv\\.fr/jorf/id/JORFTEXT"
              },
              "url_dossier_legislatif": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^https://www\\.legifrance\\.gouv\\.fr/dossierlegislatif/JORFDOLE"
              },
              "fichier_mesures": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^application_lois/mesures/JORFTEXT[0-9]{12}\\.json$"
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "mesures_a_appliquer": {
                      "const": 0
                    }
                  }
                },
                "then": {
                  "properties": {
                    "taux_application_publie": {
                      "type": "null"
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "categorie": {
                      "type": "null"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "categorie_libelle": {
                      "type": "null"
                    }
                  }
                },
                "else": {
                  "properties": {
                    "categorie_libelle": {
                      "type": "string"
                    }
                  }
                }
              }
            ]
          },
          {
            "properties": {
              "categorie": {
                "type": "string"
              }
            }
          }
        ]
      }
    }
  }
}
