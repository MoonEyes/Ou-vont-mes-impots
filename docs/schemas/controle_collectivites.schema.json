{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ou-vont-mes-impots.fr/contrat/v1/controle_collectivites.schema.json",
  "title": "Publications des chambres régionales des comptes par département",
  "description": "controle/publications/collectivites/<dep>.json (et region_<code>.json) : rapports reliés à la commune, l'EPCI, le département ou la région (codes COG).",
  "allOf": [
    {
      "$ref": "commun.schema.json#/$defs/entete"
    }
  ],
  "type": "object",
  "properties": {
    "departement": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^([0-9][0-9AB]|97[0-9]|region_[0-9]{2})$"
        },
        "nom": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "code",
        "nom"
      ]
    },
    "note": {
      "type": [
        "string",
        "null"
      ]
    },
    "comptes_par_niveau": {
      "type": "object",
      "additionalProperties": {
        "type": "integer"
      }
    },
    "publications": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "controle_commun.schema.json#/$defs/publication"
          },
          {
            "required": [
              "niveau",
              "codes",
              "rattachement"
            ]
          }
        ]
      }
    }
  },
  "required": [
    "departement",
    "publications",
    "comptes_par_niveau"
  ]
}