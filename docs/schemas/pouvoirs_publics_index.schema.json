{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ou-vont-mes-impots.fr/contrat/v1/pouvoirs_publics_index.schema.json",
  "title": "site/data/pouvoirs_publics/index.json : fichiers, repères, limites, sources, sources inaccessibles, recherche publique",
  "allOf": [
    {
      "$ref": "commun.schema.json#/$defs/entete"
    }
  ],
  "type": "object",
  "properties": {
    "millesime": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "minLength": 20
    },
    "date_sources": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "avertissement": {
      "type": "string",
      "minLength": 40
    },
    "fichiers": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "properties": {
          "fichier": {
            "type": "string",
            "pattern": "^pouvoirs_publics/[a-z_]+\\.json$"
          },
          "contenu": {
            "type": "string"
          },
          "octets": {
            "type": "integer",
            "maximum": 1000000
          }
        },
        "required": [
          "fichier",
          "contenu",
          "octets"
        ],
        "additionalProperties": false
      }
    },
    "reperes": {
      "type": "object",
      "required": [
        "total_mission_lfi_2026_eur",
        "total_mission_plf_2027_eur",
        "dotations_lfi_2026"
      ]
    },
    "limites": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sources": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^pouvoirs_publics_"
          },
          "titre": {
            "type": "string"
          },
          "producteur": {
            "type": "string"
          },
          "url": {
            "type": [
              "string",
              "null"
            ]
          },
          "licence": {
            "type": [
              "string",
              "null"
            ]
          },
          "collecte_le": {
            "type": [
              "string",
              "null"
            ]
          },
          "sha256": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "titre",
          "producteur",
          "url"
        ],
        "additionalProperties": false
      }
    },
    "sources_inaccessibles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "motif": {
            "type": "string"
          },
          "consequence": {
            "type": "string"
          }
        },
        "required": [
          "source",
          "url",
          "motif",
          "consequence"
        ],
        "additionalProperties": false
      }
    },
    "recherche_publique": {
      "type": "object",
      "properties": {
        "date": {
          "type": "string"
        },
        "conclusion": {
          "type": "string"
        },
        "trouvailles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "nom": {
                "type": "string"
              },
              "url": {
                "type": "string"
              },
              "verdict": {
                "enum": [
                  "réutilisable tel quel",
                  "à adapter",
                  "inspiration seulement"
                ]
              },
              "licence": {
                "type": "string"
              },
              "mise_a_jour": {
                "type": "string"
              }
            },
            "required": [
              "nom",
              "url",
              "verdict",
              "licence",
              "mise_a_jour"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "date",
        "conclusion",
        "trouvailles"
      ]
    }
  },
  "required": [
    "millesime",
    "source",
    "date_sources",
    "avertissement",
    "fichiers",
    "reperes",
    "limites",
    "sources",
    "sources_inaccessibles",
    "recherche_publique"
  ],
  "additionalProperties": false
}
