{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ou-vont-mes-impots.fr/contrat/v1/meta.schema.json",
  "title": "site/data/meta.json : provenance, millesimes et totaux de controle",
  "type": "object",
  "properties": {
    "version_contrat": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$",
      "description": "PREVU : version de docs/contrat_interface.md respectee par le pipeline"
    },
    "millesime": {
      "type": "object",
      "properties": {
        "etat_defaut": {
          "type": "string"
        },
        "etat_disponibles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "nature_etat": {
          "type": "string"
        }
      },
      "required": [
        "etat_defaut",
        "etat_disponibles"
      ]
    },
    "source": {
      "type": "string"
    },
    "genere_le": {
      "type": "string",
      "format": "date-time"
    },
    "sources": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string",
            "minLength": 3
          },
          "maj_source": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "source",
          "maj_source"
        ],
        "additionalProperties": false
      }
    },
    "controle": {
      "type": "object",
      "properties": {
        "etat": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "properties": {
              "millesime": {
                "type": "string"
              },
              "defaut": {
                "type": "boolean"
              },
              "dossier_arbre": {
                "type": "string"
              },
              "total_md": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "total_hors_psr_md": {
                "type": "number"
              },
              "arbre": {
                "type": "object",
                "properties": {
                  "noeuds": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "feuilles": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "profondeur": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "fichiers": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "required": [
                  "noeuds",
                  "feuilles",
                  "profondeur",
                  "fichiers"
                ]
              },
              "hors_perimetre_md": {
                "type": "object",
                "additionalProperties": {
                  "type": "number"
                }
              },
              "prelevements_sur_recettes_md": {
                "type": "object",
                "additionalProperties": {
                  "type": "number"
                }
              },
              "remboursements_et_degrevements": {
                "type": "object",
                "properties": {
                  "montant_md": {
                    "type": "number"
                  }
                },
                "required": [
                  "montant_md"
                ]
              },
              "exclu_remboursements_md": {
                "type": "number"
              }
            },
            "required": [
              "total_md",
              "arbre"
            ]
          }
        },
        "exercice": {
          "$ref": "commun.schema.json#/$defs/annee"
        },
        "annee_cofog": {
          "$ref": "commun.schema.json#/$defs/annee"
        },
        "administrations_derniere_annee": {
          "$ref": "commun.schema.json#/$defs/annee"
        },
        "tva_annee": {
          "$ref": "commun.schema.json#/$defs/annee"
        },
        "recettes_annees": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{4}$"
        },
        "communes": {
          "type": "integer",
          "minimum": 30000
        },
        "departements": {
          "type": "integer",
          "minimum": 96
        },
        "deficit_derniere_annee": {
          "type": "array",
          "prefixItems": [
            {
              "$ref": "commun.schema.json#/$defs/annee"
            },
            {
              "type": "number"
            }
          ],
          "items": false,
          "minItems": 2
        },
        "part_empruntee_etat": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        },
        "part_empruntee_apu_derniere_annee": {
          "type": "array",
          "prefixItems": [
            {
              "$ref": "commun.schema.json#/$defs/annee"
            },
            {
              "type": "number"
            }
          ],
          "items": false,
          "minItems": 2
        },
        "tva_derniere_annee": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "number",
              "null"
            ]
          }
        },
        "arbre_administrations": {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "noeuds": {
                  "type": "integer",
                  "minimum": 0
                },
                "feuilles": {
                  "type": "integer",
                  "minimum": 0
                },
                "profondeur": {
                  "type": "integer",
                  "minimum": 0
                },
                "fichiers": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "noeuds",
                "feuilles",
                "profondeur",
                "fichiers"
              ]
            }
          ],
          "properties": {
            "annee": {
              "$ref": "commun.schema.json#/$defs/annee"
            },
            "somme_md": {
              "type": "number"
            },
            "total_consolide_s13_md": {
              "type": "number"
            },
            "ecart_consolidation_md": {
              "type": "number",
              "description": "somme_md - total_consolide_s13_md (valeurs publiées)."
            },
            "ecart_depenses_totales_md": {
              "type": "number",
              "description": "Même écart sur les dépenses totales (TE, gov_10a_main), tous transferts compris."
            }
          },
          "required": [
            "annee",
            "somme_md",
            "total_consolide_s13_md",
            "ecart_consolidation_md"
          ]
        }
      },
      "required": [
        "etat",
        "exercice",
        "communes",
        "departements",
        "annee_cofog",
        "deficit_derniere_annee",
        "arbre_administrations"
      ]
    }
  },
  "required": [
    "millesime",
    "source",
    "genere_le",
    "sources",
    "controle"
  ]
}
