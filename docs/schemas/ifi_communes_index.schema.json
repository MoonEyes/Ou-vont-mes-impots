{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://ou-vont-mes-impots.fr/contrat/v1/ifi_communes_index.schema.json",
 "title": "site/data/ifi_communes/index.json : impôt sur la fortune immobilière par commune (DGFiP ; pipeline/ifi_communes.py)",
 "allOf": [
  {
   "$ref": "commun.schema.json#/$defs/entete"
  }
 ],
 "type": "object",
 "required": [
  "presentation",
  "annees",
  "colonnes",
  "definitions",
  "seuil",
  "rupture",
  "licence",
  "couverture",
  "recherche_publique"
 ],
 "properties": {
  "annees": {
   "type": "array",
   "items": {
    "type": "string",
    "pattern": "^\\d{4}$"
   }
  },
  "recherche_publique": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "trouvaille",
     "classement",
     "licence"
    ],
    "properties": {
     "classement": {
      "enum": [
       "réutilisable tel quel",
       "à adapter",
       "inspiration seulement"
      ]
     }
    }
   }
  }
 }
}
