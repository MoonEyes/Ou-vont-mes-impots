{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ou-vont-mes-impots.fr/contrat/v1/formation_cpf_certifications.schema.json",
  "title": "site/data/formation/cpf_certifications.json : CPF par certification et par année (dossiers non annulés)",
  "allOf": [
    {
      "$ref": "commun.schema.json#/$defs/entete"
    }
  ],
  "type": "object",
  "properties": {
    "millesime": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "pattern": "Caisse des dépôts"
    },
    "unite": {
      "type": "string"
    },
    "collecte_le": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "avertissement": {
      "type": "string",
      "minLength": 40
    },
    "ordre": {
      "type": "object",
      "required": [
        "regle",
        "cles"
      ],
      "properties": {
        "regle": {
          "type": "string",
          "minLength": 20
        },
        "cles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "colonnes": {
      "const": [
        "dossiers",
        "montant_eur",
        "france_competences_eur",
        "prix_moyen_eur"
      ]
    },
    "referentiels": {
      "type": "object",
      "required": [
        "RNCP",
        "RS",
        "Autre"
      ]
    },
    "par_referentiel": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "propertyNames": {
          "pattern": "^20[0-9]{2}$"
        },
        "additionalProperties": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "nombre_certifications": {
      "type": "integer",
      "minimum": 0
    },
    "certifications": {
      "type": "array",
      "minItems": 50,
      "items": {
        "type": "object",
        "required": [
          "referentiel",
          "code",
          "intitule",
          "montant_cumule_eur",
          "annees"
        ],
        "properties": {
          "referentiel": {
            "enum": [
              "RNCP",
              "RS",
              "Autre"
            ]
          },
          "code": {
            "type": [
              "string",
              "null"
            ]
          },
          "intitule": {
            "type": "string",
            "minLength": 1
          },
          "montant_cumule_eur": {
            "type": "integer",
            "minimum": 0
          },
          "annees": {
            "type": "object",
            "propertyNames": {
              "pattern": "^20[0-9]{2}$"
            },
            "additionalProperties": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": {
                "type": [
                  "integer",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    "autres_certifications": {
      "type": "object",
      "required": [
        "nombre",
        "annees"
      ],
      "properties": {
        "annees": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    }
  },
  "required": [
    "millesime",
    "source",
    "unite",
    "collecte_le",
    "avertissement",
    "ordre",
    "colonnes",
    "par_referentiel",
    "nombre_certifications",
    "certifications",
    "autres_certifications"
  ]
}
