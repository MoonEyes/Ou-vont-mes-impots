{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ou-vont-mes-impots.fr/contrat/v1/transports_afitf.schema.json",
  "title": "site/data/transports/afitf.json : budgets de l'AFITF (exécutés, initial), séries du SDES, part des CPER, taxes affectées (pipeline/transports.py)",
  "allOf": [
    {
      "$ref": "commun.schema.json#/$defs/entete"
    }
  ],
  "type": "object",
  "required": [
    "millesime",
    "source",
    "unite",
    "date_sources",
    "sources_url",
    "definitions",
    "modes",
    "budgets",
    "serie_recettes_depenses",
    "serie_interventions_par_mode",
    "cper",
    "taxes_affectees",
    "controles",
    "ecarts"
  ],
  "additionalProperties": false,
  "properties": {
    "millesime": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "unite": {
      "type": "string",
      "minLength": 1
    },
    "date_sources": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "sources_url": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^https://"
      }
    },
    "definitions": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "modes": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "budgets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "annee",
          "nature",
          "url",
          "modes",
          "total",
          "dont_plan_de_relance",
          "recettes",
          "total_recettes",
          "controles"
        ],
        "properties": {
          "annee": {
            "$ref": "commun.schema.json#/$defs/annee_entier"
          },
          "nature": {
            "enum": [
              "budget exécuté",
              "budget initial"
            ]
          },
          "url": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^https://"
          },
          "modes": {
            "type": "array",
            "minItems": 7,
            "maxItems": 7,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "libelle",
                "ae",
                "cp",
                "lignes",
                "dont_plan_de_relance"
              ],
              "properties": {
                "id": {
                  "enum": [
                    "ferroviaire",
                    "routier",
                    "tca",
                    "fluvial",
                    "maritime",
                    "exceptionnels",
                    "support"
                  ]
                },
                "libelle": {
                  "type": "string",
                  "minLength": 1
                },
                "ae": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "cp": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "dont_plan_de_relance": {
                  "oneOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "ae",
                        "cp"
                      ],
                      "properties": {
                        "ae": {
                          "type": [
                            "number",
                            "null"
                          ]
                        },
                        "cp": {
                          "type": [
                            "number",
                            "null"
                          ]
                        }
                      }
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "lignes": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "id",
                      "libelle",
                      "ae",
                      "cp"
                    ],
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "libelle": {
                        "type": "string",
                        "minLength": 1
                      },
                      "ae": {
                        "type": [
                          "number",
                          "null"
                        ]
                      },
                      "cp": {
                        "type": [
                          "number",
                          "null"
                        ]
                      }
                    }
                  }
                }
              }
            }
          },
          "total": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ae",
              "cp"
            ],
            "properties": {
              "ae": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "cp": {
                "type": [
                  "number",
                  "null"
                ]
              }
            }
          },
          "dont_plan_de_relance": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "ae",
                  "cp"
                ],
                "properties": {
                  "ae": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "cp": {
                    "type": [
                      "number",
                      "null"
                    ]
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "recettes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "libelle",
                "montant"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "libelle": {
                  "type": "string",
                  "minLength": 1
                },
                "montant": {
                  "type": [
                    "number",
                    "null"
                  ]
                }
              }
            }
          },
          "total_recettes": {
            "type": "number"
          },
          "controles": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "mode",
                "colonne",
                "total_publie",
                "somme_des_lignes",
                "ecart",
                "lecture"
              ],
              "properties": {
                "mode": {
                  "type": "string",
                  "minLength": 1
                },
                "colonne": {
                  "enum": [
                    "ae",
                    "cp"
                  ]
                },
                "total_publie": {
                  "type": "number"
                },
                "somme_des_lignes": {
                  "type": "number"
                },
                "ecart": {
                  "type": "number"
                },
                "lecture": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "serie_recettes_depenses": {
      "$ref": "#/$defs/tableau"
    },
    "serie_interventions_par_mode": {
      "$ref": "#/$defs/tableau"
    },
    "cper": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lecture",
        "serie",
        "budgets"
      ],
      "properties": {
        "lecture": {
          "type": "string",
          "minLength": 1
        },
        "serie": {
          "$ref": "#/$defs/tableau"
        },
        "budgets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "annee",
              "nature",
              "lignes"
            ],
            "properties": {
              "annee": {
                "$ref": "commun.schema.json#/$defs/annee_entier"
              },
              "nature": {
                "type": "string",
                "minLength": 1
              },
              "lignes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "mode",
                    "libelle",
                    "ae",
                    "cp"
                  ],
                  "properties": {
                    "mode": {
                      "type": "string",
                      "minLength": 1
                    },
                    "libelle": {
                      "type": "string",
                      "minLength": 1
                    },
                    "ae": {
                      "type": [
                        "number",
                        "null"
                      ]
                    },
                    "cp": {
                      "type": [
                        "number",
                        "null"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "taxes_affectees": {
      "oneOf": [
        {
          "$ref": "#/$defs/taxe"
        },
        {
          "type": "null"
        }
      ]
    },
    "controles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/controle"
      }
    },
    "ecarts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ecart"
      }
    }
  },
  "$defs": {
    "tableau": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "onglet",
        "titre",
        "unite",
        "annees",
        "statut_annees",
        "lignes",
        "absences",
        "renvois_source"
      ],
      "properties": {
        "onglet": {
          "type": "string",
          "minLength": 1
        },
        "titre": {
          "type": "string",
          "minLength": 1
        },
        "unite": {
          "type": [
            "string",
            "null"
          ]
        },
        "annees": {
          "type": "array",
          "items": {
            "$ref": "commun.schema.json#/$defs/annee_entier"
          },
          "minItems": 3
        },
        "statut_annees": {
          "type": "object",
          "propertyNames": {
            "pattern": "^(19|20)[0-9]{2}$"
          },
          "additionalProperties": {
            "enum": [
              "semi-définitif",
              "provisoire",
              "définitif"
            ]
          }
        },
        "lignes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "libelle",
              "valeurs"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9_.]+$"
              },
              "libelle": {
                "type": "string",
                "minLength": 1
              },
              "valeurs": {
                "type": "array",
                "items": {
                  "type": [
                    "number",
                    "null"
                  ]
                }
              }
            }
          }
        },
        "absences": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ligne",
              "annee",
              "a_la_source"
            ],
            "properties": {
              "ligne": {
                "type": "string",
                "minLength": 1
              },
              "annee": {
                "$ref": "commun.schema.json#/$defs/annee_entier"
              },
              "a_la_source": {
                "enum": [
                  "-",
                  "nd",
                  "cellule vide"
                ]
              }
            }
          }
        },
        "renvois_source": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "ecart": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "objet",
        "annee",
        "source",
        "valeur",
        "autre_source",
        "autre_valeur",
        "ecart",
        "ecart_pct",
        "lecture_ecart"
      ],
      "properties": {
        "objet": {
          "type": "string",
          "minLength": 1
        },
        "annee": {
          "$ref": "commun.schema.json#/$defs/annee_entier"
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "valeur": {
          "type": "number"
        },
        "autre_source": {
          "type": "string",
          "minLength": 1
        },
        "autre_valeur": {
          "type": "number"
        },
        "ecart": {
          "type": "number"
        },
        "ecart_pct": {
          "type": [
            "number",
            "null"
          ]
        },
        "lecture_ecart": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "controle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "objet",
        "tableau",
        "annee",
        "total_publie",
        "somme_des_lignes",
        "ecart",
        "lignes",
        "lignes_vides"
      ],
      "properties": {
        "objet": {
          "type": "string",
          "minLength": 1
        },
        "tableau": {
          "type": "string",
          "minLength": 1
        },
        "annee": {
          "$ref": "commun.schema.json#/$defs/annee_entier"
        },
        "total_publie": {
          "type": "number"
        },
        "somme_des_lignes": {
          "type": "number"
        },
        "ecart": {
          "type": "number"
        },
        "lignes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "lignes_vides": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "lien": {
      "type": "object",
      "required": [
        "vue",
        "fichier",
        "lecture"
      ],
      "additionalProperties": false,
      "properties": {
        "vue": {
          "type": "string",
          "minLength": 1
        },
        "fichier": {
          "type": "string",
          "pattern": "\\.json$"
        },
        "lecture": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "taxe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "affectataire",
        "programme",
        "lignes",
        "total_eur"
      ],
      "properties": {
        "affectataire": {
          "type": "string",
          "minLength": 1
        },
        "programme": {
          "type": [
            "integer",
            "null"
          ]
        },
        "total_eur": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "execution_2024",
            "lfi_2025",
            "plf_2026"
          ],
          "properties": {
            "execution_2024": {
              "type": [
                "number",
                "null"
              ]
            },
            "lfi_2025": {
              "type": [
                "number",
                "null"
              ]
            },
            "plf_2026": {
              "type": [
                "number",
                "null"
              ]
            }
          }
        },
        "lignes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "libelle",
              "execution_2024",
              "lfi_2025",
              "plf_2026"
            ],
            "properties": {
              "libelle": {
                "type": "string",
                "minLength": 1
              },
              "execution_2024": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "lfi_2025": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "plf_2026": {
                "type": [
                  "number",
                  "null"
                ]
              }
            }
          }
        }
      }
    }
  }
}
