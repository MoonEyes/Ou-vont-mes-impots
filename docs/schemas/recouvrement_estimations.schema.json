{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://ou-vont-mes-impots.fr/contrat/v1/recouvrement_estimations.schema.json",
 "title": "site/data/recouvrement/estimations.json : estimations publiées, constats sur l'absence d'estimation, montants détectés et recouvrés par la sécurité sociale",
 "description": "Axe « recouvrement » (pipeline/recouvrement.py). Trois notions séparées : montant notifié, montant encaissé, estimation. Aucun total entre sphère fiscale et sphère sociale.",
 "allOf": [
  {
   "$ref": "commun.schema.json#/$defs/entete"
  }
 ],
 "type": "object",
 "properties": {
  "millesime": {
   "type": "string"
  },
  "source": {
   "type": "string"
  },
  "unite": {
   "type": "string",
   "minLength": 3
  },
  "avertissement": {
   "type": "string",
   "minLength": 20
  },
  "collecte_le": {
   "type": "string",
   "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
  },
  "regle": {
   "type": "string",
   "minLength": 20
  },
  "ordre": {
   "type": "object",
   "required": [
    "regle",
    "cles"
   ],
   "additionalProperties": false,
   "properties": {
    "regle": {
     "type": "string",
     "minLength": 10
    },
    "cles": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "string"
     }
    }
   }
  },
  "estimations": {
   "type": "array",
   "minItems": 5,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "sphere",
     "objet",
     "producteur",
     "publication",
     "annee_publication",
     "annee_donnees",
     "perimetre",
     "methode",
     "unite",
     "valeur",
     "valeur_basse",
     "valeur_haute",
     "repere",
     "citation",
     "langue_citation",
     "notion",
     "source"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^[a-z_]+$"
     },
     "sphere": {
      "enum": [
       "fiscale",
       "sociale"
      ]
     },
     "objet": {
      "type": "string",
      "minLength": 10
     },
     "producteur": {
      "type": "string",
      "minLength": 3
     },
     "publication": {
      "type": "string",
      "minLength": 10
     },
     "annee_publication": {
      "type": "integer",
      "minimum": 1990,
      "maximum": 2100
     },
     "annee_donnees": {
      "type": [
       "integer",
       "null"
      ]
     },
     "annee_donnees_note": {
      "type": "string",
      "minLength": 10
     },
     "perimetre": {
      "type": "string",
      "minLength": 20
     },
     "methode": {
      "type": "string",
      "minLength": 20
     },
     "unite": {
      "enum": [
       "Md€",
       "M€"
      ]
     },
     "valeur": {
      "type": [
       "number",
       "null"
      ]
     },
     "valeur_basse": {
      "type": [
       "number",
       "null"
      ]
     },
     "valeur_haute": {
      "type": [
       "number",
       "null"
      ]
     },
     "repere": {
      "type": [
       "string",
       "null"
      ]
     },
     "citation": {
      "type": "string",
      "minLength": 20
     },
     "langue_citation": {
      "enum": [
       "fr",
       "en"
      ]
     },
     "notion": {
      "const": "estimation"
     },
     "source": {
      "type": "object",
      "required": [
       "id",
       "url",
       "page",
       "document"
      ],
      "additionalProperties": false,
      "properties": {
       "id": {
        "type": "string"
       },
       "url": {
        "type": "string",
        "pattern": "^https://"
       },
       "page": {
        "type": [
         "integer",
         "null"
        ],
        "minimum": 1
       },
       "document": {
        "type": "string",
        "pattern": "^data/lake/recouvrement/"
       }
      }
     }
    },
    "allOf": [
     {
      "if": {
       "properties": {
        "annee_donnees": {
         "type": "null"
        }
       }
      },
      "then": {
       "required": [
        "annee_donnees_note"
       ]
      }
     },
     {
      "anyOf": [
       {
        "properties": {
         "valeur": {
          "type": "number"
         }
        }
       },
       {
        "properties": {
         "valeur_basse": {
          "type": "number"
         },
         "valeur_haute": {
          "type": "number"
         }
        }
       }
      ]
     }
    ]
   }
  },
  "estimation_ensemble_fraude_fiscale": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "valeur",
    "note",
    "constats"
   ],
   "properties": {
    "valeur": {
     "type": "null"
    },
    "note": {
     "type": "string",
     "minLength": 20
    },
    "constats": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "string"
     }
    }
   }
  },
  "constats": {
   "type": "array",
   "minItems": 3,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "sphere",
     "producteur",
     "texte",
     "citation",
     "source"
    ],
    "properties": {
     "id": {
      "type": "string"
     },
     "sphere": {
      "enum": [
       "fiscale",
       "sociale"
      ]
     },
     "producteur": {
      "type": "string"
     },
     "texte": {
      "type": "string",
      "minLength": 20
     },
     "citation": {
      "type": "string",
      "minLength": 20
     },
     "source": {
      "type": "object",
      "required": [
       "id",
       "url",
       "page",
       "document"
      ],
      "additionalProperties": false,
      "properties": {
       "id": {
        "type": "string"
       },
       "url": {
        "type": "string",
        "pattern": "^https://"
       },
       "page": {
        "type": [
         "integer",
         "null"
        ],
        "minimum": 1
       },
       "document": {
        "type": "string",
        "pattern": "^data/lake/recouvrement/"
       }
      }
     }
    }
   }
  },
  "securite_sociale_detecte_recouvre": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "perimetre",
    "methode",
    "montants"
   ],
   "properties": {
    "perimetre": {
     "type": "string",
     "minLength": 20
    },
    "methode": {
     "type": "string",
     "minLength": 20
    },
    "montants": {
     "type": "array",
     "minItems": 2,
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "id",
       "notion",
       "terme_source",
       "libelle",
       "annee",
       "valeur",
       "unite",
       "precision",
       "citation",
       "sphere",
       "producteur",
       "source"
      ],
      "properties": {
       "id": {
        "type": "string"
       },
       "notion": {
        "enum": [
         "notifie",
         "encaisse"
        ]
       },
       "terme_source": {
        "type": "string"
       },
       "libelle": {
        "type": "string"
       },
       "annee": {
        "type": "integer",
        "minimum": 1990,
        "maximum": 2100
       },
       "valeur": {
        "type": "number"
       },
       "unite": {
        "enum": [
         "Md€",
         "M€"
        ]
       },
       "precision": {
        "type": [
         "string",
         "null"
        ]
       },
       "citation": {
        "type": "string"
       },
       "sphere": {
        "const": "sociale"
       },
       "producteur": {
        "type": "string"
       },
       "source": {
        "type": "object",
        "required": [
         "id",
         "url",
         "page",
         "document"
        ],
        "additionalProperties": false,
        "properties": {
         "id": {
          "type": "string"
         },
         "url": {
          "type": "string",
          "pattern": "^https://"
         },
         "page": {
          "type": [
           "integer",
           "null"
          ],
          "minimum": 1
         },
         "document": {
          "type": "string",
          "pattern": "^data/lake/recouvrement/"
         }
        }
       }
      }
     }
    }
   }
  },
  "verification_documents": {
   "type": "object",
   "required": [
    "citations",
    "retrouvees",
    "methode"
   ]
  }
 },
 "required": [
  "millesime",
  "source",
  "unite",
  "avertissement",
  "collecte_le",
  "regle",
  "ordre",
  "estimations",
  "estimation_ensemble_fraude_fiscale",
  "constats",
  "securite_sociale_detecte_recouvre",
  "verification_documents"
 ],
 "additionalProperties": false
}
