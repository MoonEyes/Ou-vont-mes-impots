      "minLength": 20
    },
    "unite": {
      "type": "string"
    },
    "date_sources": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "avertissement": {
      "type": "string",
      "minLength": 40
    },
    "budget": {
      "type": "object",
      "properties": {
        "credits_paiement": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "annee": {
                "type": "integer"
              },
              "meur": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "annee",
              "meur"
            ],
            "additionalProperties": false
          },
          "minItems": 2
        },
        "dont_personnel": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "annee": {
                "type": "integer"
              },
              "meur": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "annee",
              "meur"
            ],
            "additionalProperties": false
          },
          "minItems": 2
        },
        "autorisations_engagement": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "annee": {
                "type": "integer"
              },
              "meur": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "annee",
              "meur"
            ],
            "additionalProperties": false
          },
          "minItems": 2
        },
        "annee_programmes": {
          "type": "integer"
        },
        "programmes": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {
            "type": "object",
            "properties": {
              "programme": {
                "type": "string",
                "pattern": "^[0-9]{3}$"
              },
              "libelle": {
                "type": "string"
              },
              "cp_meur": {
                "type": "number",
                "minimum": 0
              },
              "part_pct": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              }
            },
            "required": [
              "cp_meur",
              "libelle",
              "part_pct",
              "programme"
