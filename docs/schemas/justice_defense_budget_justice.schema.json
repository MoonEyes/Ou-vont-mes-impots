{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ou-vont-mes-impots.fr/contrat/v1/justice_defense_budget_justice.schema.json",
  "title": "site/data/justice_defense/budget_justice.json : budget de la justice par programme, frais de justice, aide juridictionnelle (Les chiffres clés de la Justice, édition 2026)",
  "allOf": [
    {
      "$ref": "commun.schema.json#/$defs/entete"
    }
  ],
  "type": "object",
