            "civil_meur": {
              "type": "number"
            },
            "penal_meur": {
              "type": "number"
            },
            "administratif_meur": {
              "type": "number"
            },
            "aide_intervention_avocat_meur": {
              "type": "number"
            }
          },
          "required": [
            "administratif_meur",
            "aide_intervention_avocat_meur",
            "aide_juridictionnelle_meur",
            "annee",
            "civil_meur",
            "dont_aj_garantie_meur",
            "penal_meur",
            "total_meur"
          ],
          "additionalProperties": false
        }
      },
