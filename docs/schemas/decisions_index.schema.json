{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ou-vont-mes-impots.fr/contrat/v1/decisions_index.schema.json",
  "title": "site/data/decisions/index.json : programmes, fichiers, comptes, contrôle PLRG, limites",
  "allOf": [
    {
      "$ref": "commun.schema.json#/$defs/entete"
    }
  ],
  "type": "object",
  "properties": {
    "genere_le": {
      "type": "string"
    },
    "programmes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[0-9]{3}$"
      }
    },
    "fichiers": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^decisions/.+\\.json$"
      }
    },
    "comptes": {
      "type": "object"
    },
    "coherence_plrg": {
      "type": "object"
    },
    "regle_personnes": {
      "type": "string"
    },
    "limites": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": ["programmes", "fichiers", "comptes"]
}
