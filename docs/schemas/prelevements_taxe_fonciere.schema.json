{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ou-vont-mes-impots.fr/contrat/v1/prelevements_taxe_fonciere.schema.json",
  "title": "site/data/prelevements/taxe_fonciere.json : methode et agregats de l'estimation de taxe fonciere",
  "allOf": [
    {
      "$ref": "commun.schema.json#/$defs/entete"
    }
  ],
  "type": "object",
  "properties": {
    "unite": {
      "type": "string"
    },
    "methode": {
      "type": [
        "string",
        "array"
      ],
      "items": {
        "type": "string"
      }
    },
    "limites": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "agregats_nationaux_m": {
      "type": "object"
    },
    "couverture": {
      "type": "object"
    },
    "departements": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^([0-9]{2}|2[AB]|97[1-6])$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "fichiers": {
      "type": "string"
    }
  },
  "required": [
    "unite",
    "methode",
    "departements",
    "fichiers"
  ]
}
