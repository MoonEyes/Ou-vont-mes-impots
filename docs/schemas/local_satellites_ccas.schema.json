{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ou-vont-mes-impots.fr/contrat/v1/local_satellites_ccas.schema.json",
  "title": "site/data/local_satellites/ccas/<dep>.json : CCAS de chaque commune et CIAS de son intercommunalité (pipeline/local_satellites.py)",
  "allOf": [
    {
      "$ref": "commun.schema.json#/$defs/entete"
    }
  ],
  "type": "object",
  "$defs": {
    "centre": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nom",
        "type",
        "commune_siege",
        "rattachement",
        "population",
        "serie",
        "eur_hab",
        "eur_hab_exercice"
      ],
      "properties": {
        "nom": {
          "type": [
            "string",
            "null"
          ]
        },
        "type": {
          "enum": [
            "ccas",
            "cias"
          ]
        },
        "commune_siege": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^([0-9]{2}|2[AB])[0-9]{3}$",
          "description": "commune de l'établissement siège (SIRENE) ; null si inconnue ou hors référentiel"
        },
        "rattachement": {
          "enum": [
            "commune_siege",
            "epci_de_la_commune_siege",
            null
          ]
        },
        "epci": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]{9}$"
        },
        "competence_cias_banatic": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "population": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "budgets": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "serie": {
          "type": "object",
          "required": [
            "depenses_totales_hors_remb",
            "depenses_fonctionnement",
            "depenses_investissement_hors_remb",
            "participations_communes",
            "subventions_participations_recues",
            "ventes_biens_services"
          ],
          "additionalProperties": false,
          "properties": {
            "depenses_totales_hors_remb": {
              "type": "array",
              "minItems": 8,
              "maxItems": 8,
              "items": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "description": "euros par exercice, aligné sur `annees` ; null = non publié par l'OFGL cet exercice, jamais 0"
            },
            "depenses_fonctionnement": {
              "type": "array",
              "minItems": 8,
              "maxItems": 8,
              "items": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "description": "euros par exercice, aligné sur `annees` ; null = non publié par l'OFGL cet exercice, jamais 0"
            },
            "depenses_investissement_hors_remb": {
              "type": "array",
              "minItems": 8,
              "maxItems": 8,
              "items": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "description": "euros par exercice, aligné sur `annees` ; null = non publié par l'OFGL cet exercice, jamais 0"
            },
            "participations_communes": {
              "type": "array",
              "minItems": 8,
              "maxItems": 8,
              "items": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "description": "euros par exercice, aligné sur `annees` ; null = non publié par l'OFGL cet exercice, jamais 0"
            },
            "subventions_participations_recues": {
              "type": "array",
              "minItems": 8,
              "maxItems": 8,
              "items": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "description": "euros par exercice, aligné sur `annees` ; null = non publié par l'OFGL cet exercice, jamais 0"
            },
            "ventes_biens_services": {
              "type": "array",
              "minItems": 8,
              "maxItems": 8,
              "items": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "description": "euros par exercice, aligné sur `annees` ; null = non publié par l'OFGL cet exercice, jamais 0"
            }
          }
        },
        "eur_hab": {
          "type": [
            "number",
            "null"
          ]
        },
        "eur_hab_exercice": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 2024,
          "maximum": 2025
        }
      }
    }
  },
  "properties": {
    "licence": {
      "const": "Licence Ouverte 2.0"
    },
    "departement": {
      "type": "object",
      "required": [
        "code",
        "nom"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "nom": {
          "type": "string"
        }
      }
    },
    "annees": {
      "const": [
        2018,
        2019,
        2020,
        2021,
        2022,
        2023,
        2024,
        2025
      ]
    },
    "colonnes": {
      "const": [
        "depenses_totales_hors_remb",
        "depenses_fonctionnement",
        "depenses_investissement_hors_remb",
        "participations_communes",
        "subventions_participations_recues",
        "ventes_biens_services"
      ]
    },
    "unite": {
      "const": "euros"
    },
    "population_source": {
      "type": "string"
    },
    "centres": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[0-9]{9}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/centre"
      }
    },
    "non_rattaches": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9]{9}$"
      }
    },
    "communes": {
      "type": "object",
      "propertyNames": {
        "pattern": "^([0-9]{2}|2[AB])[0-9]{3}$"
      },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "pattern": "^[0-9]{9}$"
        }
      }
    }
  },
  "required": [
    "millesime",
    "source",
    "licence",
    "departement",
    "annees",
    "colonnes",
    "centres",
    "non_rattaches",
    "communes"
  ]
}
