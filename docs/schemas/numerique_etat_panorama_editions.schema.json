{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ou-vont-mes-impots.fr/contrat/v1/numerique_etat_panorama_editions.schema.json",
  "title": "site/data/numerique_etat/panorama/editions.json : chaque édition du panorama (projets, coûts estimés publiés, entrants, sortants, par ministère) et éditions par année",
  "allOf": [
    {
      "$ref": "commun.schema.json#/$defs/entete"
    }
  ],
  "type": "object",
  "properties": {
    "millesime": {
      "type": "string",
      "minLength": 4
    },
    "source": {
      "type": "string",
      "minLength": 10
    },
    "unite": {
      "type": "string",
      "minLength": 4
    },
    "collecte_le": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "avertissement": {
      "type": "string",
      "minLength": 40
    },
    "definitions": {
      "type": "object"
    },
    "editions": {
      "type": "array",
      "minItems": 20,
      "items": {
        "type": "object",
        "required": [
          "edition",
          "numero",
          "annee",
          "url",
          "projets",
          "cout_publie_meur",
          "projets_sans_cout_publie",
          "entrants",
          "sortants",
          "par_tranche",
          "par_ministere"
        ],
        "properties": {
          "edition": {
            "type": "string",
            "pattern": "^20[0-9]{2}-(0[1-9]|1[0-2])$"
          },
          "numero": {
            "type": "integer",
            "minimum": 1
          },
          "annee": {
            "$ref": "commun.schema.json#/$defs/annee_entier"
          },
          "url": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^https://"
          },
          "projets": {
            "type": "integer",
            "minimum": 1
          },
          "cout_publie_meur": {
            "type": [
              "number",
              "null"
            ],
            "exclusiveMinimum": 0
          },
          "projets_sans_cout_publie": {
            "type": "integer",
            "minimum": 0
          },
          "entrants": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            }
          },
          "sortants": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            }
          },
          "par_tranche": {
            "type": "object",
            "additionalProperties": {
              "type": "integer"
            }
          },
          "par_ministere": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "ministere",
                "projets",
                "cout_publie_meur",
                "projets_sans_cout_publie"
              ],
              "properties": {
                "ministere": {
                  "type": "string"
                },
                "projets": {
                  "type": "integer",
                  "minimum": 1
                },
                "cout_publie_meur": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "exclusiveMinimum": 0
                },
                "projets_sans_cout_publie": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    },
    "annees": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "annee",
          "editions"
        ],
        "properties": {
          "annee": {
            "$ref": "commun.schema.json#/$defs/annee_entier"
          },
          "editions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^20[0-9]{2}-(0[1-9]|1[0-2])$"
            }
          }
        }
      }
    }
  },
  "required": [
    "millesime",
    "source",
    "unite",
    "collecte_le",
    "avertissement",
    "definitions",
    "editions",
    "annees"
  ]
}
