{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://ou-vont-mes-impots.fr/contrat/v1/fonds_solidarite_departements.schema.json",
 "title": "site/data/fonds_solidarite/departements.json : volet 1 au dernier instantané, par département et section d'activité, catégorie juridique, classe d'effectif (agrégats, aucune entreprise nommée)",
 "allOf": [
  {
   "$ref": "commun.schema.json#/$defs/entete"
  }
 ],
 "type": "object",
 "required": [
  "millesime",
  "source",
  "date_sources",
  "unite",
  "instantane",
  "volet",
  "par_section",
  "par_categorie_juridique",
  "par_classe_effectif"
 ],
 "properties": {
  "date_sources": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
  },
  "instantane": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
  },
  "volet": {
   "const": 1
  },
  "par_section": {
   "type": "object",
   "required": [
    "colonnes",
    "lignes"
   ],
   "properties": {
    "colonnes": {
     "const": [
      "departement",
      "section",
      "nombre_aides",
      "nombre_entreprises",
      "montant_eur"
     ]
    },
    "lignes": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "array",
      "prefixItems": [
       {
        "type": "string",
        "pattern": "^(\\d{2,3}|2[AB])$"
       },
       {
        "type": "string",
        "pattern": "^([A-Z]|NR)$"
       },
       {
        "type": [
         "integer",
         "null"
        ]
       },
       {
        "type": [
         "integer",
         "null"
        ]
       },
       {
        "type": [
         "integer",
         "null"
        ]
       }
      ],
      "minItems": 5,
      "maxItems": 5
     }
    }
   }
  },
  "par_categorie_juridique": {
   "type": "object",
   "required": [
    "colonnes",
    "lignes"
   ],
   "properties": {
    "colonnes": {
     "const": [
      "departement",
      "categorie_juridique",
      "nombre_aides",
      "nombre_entreprises",
      "montant_eur"
     ]
    },
    "lignes": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "array",
      "prefixItems": [
       {
        "type": "string",
        "pattern": "^(\\d{2,3}|2[AB])$"
       },
       {
        "type": "string",
        "pattern": "^(\\d{2}|NR)$"
       },
       {
        "type": [
         "integer",
         "null"
        ]
       },
       {
        "type": [
         "integer",
         "null"
        ]
       },
       {
        "type": [
         "integer",
         "null"
        ]
       }
      ],
      "minItems": 5,
      "maxItems": 5
     }
    }
   }
  },
  "par_classe_effectif": {
   "type": "object",
   "required": [
    "colonnes",
    "lignes"
   ],
   "properties": {
    "colonnes": {
     "const": [
      "departement",
      "classe_effectif",
      "nombre_aides",
      "nombre_entreprises",
      "montant_eur"
     ]
    },
    "lignes": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "array",
      "prefixItems": [
       {
        "type": "string",
        "pattern": "^(\\d{2,3}|2[AB])$"
       },
       {
        "type": "string",
        "pattern": "^([0-9A-Z]{1,3})$"
       },
       {
        "type": [
         "integer",
         "null"
        ]
       },
       {
        "type": [
         "integer",
         "null"
        ]
       },
       {
        "type": [
         "integer",
         "null"
        ]
       }
      ],
      "minItems": 5,
      "maxItems": 5
     }
    }
   }
  }
 }
}
