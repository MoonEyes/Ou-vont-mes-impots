{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ou-vont-mes-impots.fr/contrat/v1/transports_programmes.schema.json",
  "title": "site/data/transports/programmes.json : programmes budgétaires des transports par action, taxes affectées, dépenses de l'État et de l'AFITF par mode (pipeline/transports.py)",
  "allOf": [
    {
      "$ref": "commun.schema.json#/$defs/entete"
    }
  ],
  "type": "object",
  "required": [
    "millesime",
    "source",
    "unite",
    "date_sources",
    "sources_url",
    "programmes",
    "programmes_sans_donnee_ici",
    "colonnes",
    "taxes_affectees",
    "depenses_etat_afitf_par_mode",
    "ecarts",
    "regle"
  ],
  "additionalProperties": false,
  "properties": {
    "millesime": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "unite": {
      "type": "string",
      "minLength": 1
    },
    "date_sources": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "sources_url": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^https://"
      }
    },
    "programmes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "numero",
          "nom",
          "mission",
          "actions",
          "total_actions_eur",
          "lignes_hors_action",
          "liens"
        ],
        "properties": {
          "numero": {
            "type": "integer"
          },
          "nom": {
            "type": "string",
            "minLength": 1
          },
          "mission": {
            "type": "string",
            "minLength": 1
          },
          "actions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "code",
                "libelle",
                "execution_2024",
                "lfi_2025",
                "plf_2026"
              ],
              "properties": {
                "code": {
                  "type": "string",
                  "minLength": 1
                },
                "libelle": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "execution_2024": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "lfi_2025": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "plf_2026": {
                  "type": [
                    "number",
                    "null"
                  ]
                }
              }
            }
          },
          "total_actions_eur": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "execution_2024",
              "lfi_2025",
              "plf_2026"
            ],
            "properties": {
              "execution_2024": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "lfi_2025": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "plf_2026": {
                "type": [
                  "number",
                  "null"
                ]
              }
            }
          },
          "lignes_hors_action": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "code",
                "libelle",
                "execution_2024",
                "lfi_2025",
                "plf_2026"
              ],
              "properties": {
                "code": {
                  "type": "string",
                  "minLength": 1
                },
                "libelle": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "execution_2024": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "lfi_2025": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "plf_2026": {
                  "type": [
                    "number",
                    "null"
                  ]
                }
              }
            }
          },
          "liens": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/lien"
            }
          }
        }
      }
    },
    "programmes_sans_donnee_ici": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "numero",
          "nom",
          "liens",
          "lecture"
        ],
        "properties": {
          "numero": {
            "type": "integer"
          },
          "nom": {
            "type": "string",
            "minLength": 1
          },
          "lecture": {
            "type": "string",
            "minLength": 1
          },
          "liens": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/lien"
            }
          }
        }
      }
    },
    "colonnes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution_2024",
        "lfi_2025",
        "plf_2026"
      ],
      "properties": {
        "execution_2024": {
          "type": "string",
          "minLength": 1
        },
        "lfi_2025": {
          "type": "string",
          "minLength": 1
        },
        "plf_2026": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "taxes_affectees": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/taxe"
      }
    },
    "depenses_etat_afitf_par_mode": {
      "$ref": "#/$defs/tableau"
    },
    "ecarts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ecart"
      }
    },
    "regle": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "tableau": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "onglet",
        "titre",
        "unite",
        "annees",
        "statut_annees",
        "lignes",
        "absences",
        "renvois_source"
      ],
      "properties": {
        "onglet": {
          "type": "string",
          "minLength": 1
        },
        "titre": {
          "type": "string",
          "minLength": 1
        },
        "unite": {
          "type": [
            "string",
            "null"
          ]
        },
        "annees": {
          "type": "array",
          "items": {
            "$ref": "commun.schema.json#/$defs/annee_entier"
          },
          "minItems": 3
        },
        "statut_annees": {
          "type": "object",
          "propertyNames": {
            "pattern": "^(19|20)[0-9]{2}$"
          },
          "additionalProperties": {
            "enum": [
              "semi-définitif",
              "provisoire",
              "définitif"
            ]
          }
        },
        "lignes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "libelle",
              "valeurs"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9_.]+$"
              },
              "libelle": {
                "type": "string",
                "minLength": 1
              },
              "valeurs": {
                "type": "array",
                "items": {
                  "type": [
                    "number",
                    "null"
                  ]
                }
              }
            }
          }
        },
        "absences": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ligne",
              "annee",
              "a_la_source"
            ],
            "properties": {
              "ligne": {
                "type": "string",
                "minLength": 1
              },
              "annee": {
                "$ref": "commun.schema.json#/$defs/annee_entier"
              },
              "a_la_source": {
                "enum": [
                  "-",
                  "nd",
                  "cellule vide"
                ]
              }
            }
          }
        },
        "renvois_source": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "ecart": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "objet",
        "annee",
        "source",
        "valeur",
        "autre_source",
        "autre_valeur",
        "ecart",
        "ecart_pct",
        "lecture_ecart"
      ],
      "properties": {
        "objet": {
          "type": "string",
          "minLength": 1
        },
        "annee": {
          "$ref": "commun.schema.json#/$defs/annee_entier"
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "valeur": {
          "type": "number"
        },
        "autre_source": {
          "type": "string",
          "minLength": 1
        },
        "autre_valeur": {
          "type": "number"
        },
        "ecart": {
          "type": "number"
        },
        "ecart_pct": {
          "type": [
            "number",
            "null"
          ]
        },
        "lecture_ecart": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "controle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "objet",
        "tableau",
        "annee",
        "total_publie",
        "somme_des_lignes",
        "ecart",
        "lignes",
        "lignes_vides"
      ],
      "properties": {
        "objet": {
          "type": "string",
          "minLength": 1
        },
        "tableau": {
          "type": "string",
          "minLength": 1
        },
        "annee": {
          "$ref": "commun.schema.json#/$defs/annee_entier"
        },
        "total_publie": {
          "type": "number"
        },
        "somme_des_lignes": {
          "type": "number"
        },
        "ecart": {
          "type": "number"
        },
        "lignes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "lignes_vides": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "lien": {
      "type": "object",
      "required": [
        "vue",
        "fichier",
        "lecture"
      ],
      "additionalProperties": false,
      "properties": {
        "vue": {
          "type": "string",
          "minLength": 1
        },
        "fichier": {
          "type": "string",
          "pattern": "\\.json$"
        },
        "lecture": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "taxe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "affectataire",
        "programme",
        "lignes",
        "total_eur"
      ],
      "properties": {
        "affectataire": {
          "type": "string",
          "minLength": 1
        },
        "programme": {
          "type": [
            "integer",
            "null"
          ]
        },
        "total_eur": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "execution_2024",
            "lfi_2025",
            "plf_2026"
          ],
          "properties": {
            "execution_2024": {
              "type": [
                "number",
                "null"
              ]
            },
            "lfi_2025": {
              "type": [
                "number",
                "null"
              ]
            },
            "plf_2026": {
              "type": [
                "number",
                "null"
              ]
            }
          }
        },
        "lignes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "libelle",
              "execution_2024",
              "lfi_2025",
              "plf_2026"
            ],
            "properties": {
              "libelle": {
                "type": "string",
                "minLength": 1
              },
              "execution_2024": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "lfi_2025": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "plf_2026": {
                "type": [
                  "number",
                  "null"
                ]
              }
            }
          }
        }
      }
    }
  }
}
