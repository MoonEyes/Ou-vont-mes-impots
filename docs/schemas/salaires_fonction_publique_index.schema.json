{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://ou-vont-mes-impots.fr/contrat/v1/salaires_fonction_publique_index.schema.json",
 "title": "site/data/salaires_fonction_publique/index.json : jeux de l'Insee repris, nomenclatures (libellés des modalités), années, définitions, règles et limites (pipeline/salaires_fonction_publique.py)",
 "allOf": [
  {
   "$ref": "commun.schema.json#/$defs/entete"
  }
 ],
 "type": "object",
 "required": [
  "millesime",
  "source",
  "date_sources",
  "licence",
  "presentation",
  "jeux",
  "definitions",
  "regles",
  "limites",
  "recherche_publique",
  "ordre"
 ],
 "properties": {
  "date_sources": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
  },
  "jeux": {
   "type": "object",
   "required": [
    "series_longues",
    "annuel"
   ],
   "additionalProperties": {
    "type": "object",
    "required": [
     "nomenclatures",
     "annees",
     "observations",
     "valeurs_absentes",
     "millesime",
     "source",
     "identifiant_catalogue",
     "url",
     "page",
     "chemin",
     "octets"
    ]
   }
  }
 }
}
