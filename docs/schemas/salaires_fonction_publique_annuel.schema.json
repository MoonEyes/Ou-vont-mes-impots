{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://ou-vont-mes-impots.fr/contrat/v1/salaires_fonction_publique_annuel.schema.json",
 "title": "site/data/salaires_fonction_publique/annuel.json : observations de l'Insee [année, codes des dimensions, valeur] telles que publiées (pipeline/salaires_fonction_publique.py)",
 "allOf": [
  {
   "$ref": "commun.schema.json#/$defs/entete"
  }
 ],
 "type": "object",
 "required": [
  "millesime",
  "source",
  "date_sources",
  "unite",
  "colonnes",
  "observations"
 ],
 "properties": {
  "date_sources": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
  },
  "colonnes": {
   "type": "array",
   "minItems": 10,
   "maxItems": 10,
   "prefixItems": [
    {
     "const": "annee"
    }
   ],
   "items": {
    "type": "string"
   }
  },
  "observations": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "array",
    "minItems": 10,
    "maxItems": 10,
    "prefixItems": [
     {
      "type": "integer",
      "minimum": 1990
     },
     {
      "type": "string"
     },
     {
      "type": "string"
     },
     {
      "type": "string"
     },
     {
      "type": "string"
     },
     {
      "type": "string"
     },
     {
      "type": "string"
     },
     {
      "type": "string"
     },
     {
      "type": "string"
     },
     {
      "type": [
       "number",
       "null"
      ]
     }
    ]
   }
  }
 }
}
