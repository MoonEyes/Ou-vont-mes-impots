{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ou-vont-mes-impots.fr/contrat/v1/deficit.schema.json",
  "title": "site/data/deficit.json : solde public (B9) toutes administrations",
  "type": "object",
  "required": [
    "unite",
    "solde_public"
  ],
  "additionalProperties": false,
  "properties": {
    "unite": {
      "const": "milliards d'euros (negatif = deficit)"
    },
    "solde_public": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "type": "string",
        "pattern": "^(19|20)[0-9]{2}$"
      },
      "additionalProperties": {
        "type": "number"
      }
    }
  }
}
