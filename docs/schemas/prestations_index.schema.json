{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ou-vont-mes-impots.fr/contrat/v1/prestations_index.schema.json",
  "title": "site/data/prestations/index.json : prestations aux ménages, financeurs, totaux par source, écarts, sources (pipeline/prestations.py)",
  "allOf": [{"$ref": "commun.schema.json#/$defs/entete"}],
  "type": "object",
  "$defs": {
    "serie": {"type": "object", "propertyNames": {"$ref": "commun.schema.json#/$defs/annee"},
      "additionalProperties": {"type": ["number", "null"]}},
    "lien": {"type": "object",
      "properties": {
        "vue": {"enum": ["arbre_etat", "secu_arbre", "secu_cps", "local"]},
        "fichier": {"type": "string", "pattern": "^(arbre|secu|local)/.+\\.json$"},
        "id": {"type": "string", "minLength": 1}, "nom": {"type": "string"},
        "md": {"type": "number"}, "millesime": {"type": "string"}, "lecture": {"type": "string"},
        "partage_avec": {"type": "array", "items": {"type": "string"}}},
      "required": ["vue", "fichier", "id", "nom", "millesime"], "additionalProperties": false},
    "ecart": {"type": "object",
      "properties": {
        "prestation": {"type": "string"}, "grandeur": {"enum": ["beneficiaires"]}, "lien": {"type": "string"},
        "annee": {"$ref": "commun.schema.json#/$defs/annee_entier"},
        "source": {"type": "string"}, "montant": {"type": "number"},
        "autre_source": {"type": "string"}, "autre_montant": {"type": "number"},
        "ecart": {"type": "number"}, "ecart_pct": {"type": ["number", "null"]},
        "lecture_ecart": {"type": ["string", "null"]}, "note": {"type": "string"},
        "codes_mois_manquants": {"type": "array", "items": {"type": "string"}}},
      "required": ["prestation", "annee", "source", "montant", "autre_source", "autre_montant", "ecart", "ecart_pct"],
      "additionalProperties": false}
  },
  "properties": {
    "unite": {"type": "string"},
    "date_sources": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "annees": {"type": "array", "items": {"$ref": "commun.schema.json#/$defs/annee_entier"}, "minItems": 1},
    "derniere_annee": {"type": "object", "additionalProperties": {"type": ["integer", "null"]}},
    "prestations": {"type": "array", "minItems": 1, "items": {"type": "object",
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z_]+$"}, "nom": {"type": "string"}, "groupe": {"type": "string"},
        "financeur": {"type": "string"},
        "serie_principale": {"enum": ["cnaf_depenses", "drees_cps", "unedic"]},
        "departemental": {"type": "boolean"},
        "liens": {"type": "array", "items": {"$ref": "#/$defs/lien"}}},
      "required": ["id", "nom", "groupe", "financeur", "serie_principale", "departemental", "liens"]}},
    "fichiers": {"type": "object", "required": ["nationales", "departements"],
      "properties": {"nationales": {"const": "prestations/nationales.json"},
        "departements": {"type": "object", "propertyNames": {"$ref": "commun.schema.json#/$defs/annee"},
          "additionalProperties": {"type": "string", "pattern": "^prestations/departements/[0-9]{4}\\.json$"}}}},
    "totaux": {"type": "object", "propertyNames": {"enum": ["drees_cps", "cnaf_depenses"]},
      "additionalProperties": {"type": "object",
        "properties": {"prestations": {"type": "array", "items": {"type": "string"}},
          "montant_eur": {"$ref": "#/$defs/serie"},
          "total_prestations_protection_sociale_eur": {"$ref": "#/$defs/serie"},
          "part_du_total_pct": {"$ref": "#/$defs/serie"}, "lecture": {"type": "string"}},
        "required": ["prestations", "montant_eur", "lecture"]}},
    "ecarts": {"type": "array", "items": {"$ref": "#/$defs/ecart"}},
    "ecarts_departements": {"type": "array", "items": {"$ref": "#/$defs/ecart"}},
    "couverture_departementale": {"type": "object",
      "required": ["prestations", "grandeurs", "annees", "departements", "rsa_recentralise", "non_couvert"]},
    "regle": {"type": "string"},
    "sources": {"type": "object", "additionalProperties": {"type": "object",
      "properties": {"titre": {"type": "string"}, "url": {"type": "string", "pattern": "^https://"},
                     "licence": {"type": "string"}, "verdict": {"type": "string"}, "millesime": {"type": "string"}},
      "required": ["titre", "url", "licence", "verdict", "millesime"]}},
    "sources_inaccessibles": {"type": "array", "items": {"type": "object", "required": ["source", "motif"]}},
    "recherche_publique": {"type": "object", "required": ["date", "conclusion", "trouvailles"],
      "properties": {"trouvailles": {"type": "array", "items": {"type": "object",
        "properties": {"verdict": {"type": "string", "pattern": "^(réutilisable tel quel|à adapter|inspiration seulement|aucun)"}},
        "required": ["nom", "url", "licence", "verdict"]}}}}
  },
  "required": ["unite", "date_sources", "annees", "derniere_annee", "prestations", "fichiers", "totaux", "ecarts",
               "ecarts_departements", "couverture_departementale", "regle", "sources", "sources_inaccessibles",
               "recherche_publique"]
}
