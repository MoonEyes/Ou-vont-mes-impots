{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ou-vont-mes-impots.fr/contrat/v1/immobilier_etat_cessions.schema.json",
  "title": "site/data/immobilier_etat/cessions.json : prix des actes, encaissements, recouvrements, cessions par nature, administration, lieu, jeu ouvert 2013-2017",
  "allOf": [
    {
      "$ref": "commun.schema.json#/$defs/entete"
    }
  ],
  "type": "object",
  "properties": {
    "millesime": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "unite": {
      "type": "string",
      "minLength": 1
    },
    "avertissement": {
      "type": "string",
      "minLength": 20
    },
    "collecte_le": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "comparaison_par_annee": {
      "type": "object",
      "required": [
        "lignes"
      ],
      "properties": {
        "lignes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "annee",
              "prix_actes_millions_eur",
              "encaissements_millions_eur",
              "recouvrements_ligne_76101_eur"
            ]
          }
        }
      }
    },
    "prix_actes": {
      "type": "object",
      "required": [
        "annees",
        "page",
        "millions_eur"
      ],
      "properties": {
        "annees": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1990,
            "maximum": 2100
          },
          "minItems": 1
        },
        "page": {
          "type": "integer"
        },
        "millions_eur": {
          "type": "array",
          "items": {
            "type": [
              "number",
              "null"
            ]
          }
        }
      }
    },
    "encaissements": {
      "type": "object",
      "required": [
        "annees",
        "page",
        "millions_eur"
      ],
      "properties": {
        "annees": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1990,
            "maximum": 2100
          },
          "minItems": 1
        },
        "page": {
          "type": "integer"
        },
        "millions_eur": {
          "type": "array",
          "items": {
            "type": [
              "number",
              "null"
            ]
          }
        }
      }
    },
    "par_nature": {
      "type": "object",
      "required": [
        "annees",
        "natures",
        "total_nombre",
        "total_millions_eur"
      ]
    },
    "par_administration_occupante": {
      "type": "object",
      "required": [
        "annees",
        "administrations",
        "total_eur"
      ]
    },
    "plus_de_2_millions_2024": {
      "type": "object",
      "required": [
        "cessions",
        "total_eur"
      ],
      "properties": {
        "cessions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "region",
              "departement",
              "commune",
              "ministere_occupant",
              "prix_eur"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "acquereur"
                  ]
                },
                {
                  "required": [
                    "adresse"
                  ]
                }
              ]
            }
          }
        }
      }
    },
    "outre_mer_2024": {
      "type": "object",
      "required": [
        "lignes",
        "total_eur"
      ]
    },
    "etranger_2024": {
      "type": "object",
      "required": [
        "lignes",
        "total_eur"
      ]
    },
    "jeu_ouvert_2013_2017": {
      "type": "object",
      "required": [
        "annees",
        "biens",
        "par_annee",
        "par_departement"
      ],
      "properties": {
        "par_annee": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "annee",
              "biens",
              "par_nature",
              "par_procedure",
              "par_categorie_acquereur",
              "par_ministere_occupant"
            ]
          }
        }
      }
    },
    "ordre": {
      "type": "object",
      "required": [
        "regle"
      ]
    }
  },
  "required": [
    "millesime",
    "source",
    "unite",
    "avertissement",
    "collecte_le",
    "comparaison_par_annee",
    "prix_actes",
    "encaissements",
    "par_nature",
    "par_administration_occupante",
    "plus_de_2_millions_2024",
    "jeu_ouvert_2013_2017",
    "ordre"
  ]
}
