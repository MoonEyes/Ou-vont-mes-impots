{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ou-vont-mes-impots.fr/contrat/v1/douanes_accises_index.schema.json",
  "title": "site/data/douanes_accises/index.json : produits, répartition par bénéficiaire de la dernière année, écarts entre sources, liens vers les vues voisines, sources (pipeline/douanes_accises.py)",
  "allOf": [
    {
      "$ref": "commun.schema.json#/$defs/entete"
    }
  ],
  "type": "object",
  "required": [
    "millesime",
    "source",
    "unite",
    "date_sources",
    "fichiers",
    "produits",
    "definitions",
    "liens",
    "ecarts",
    "limites",
    "regle",
    "sources",
    "sources_inaccessibles",
    "recherche_publique"
  ],
  "properties": {
    "unite": {
      "$ref": "commun.schema.json#/$defs/unite_md_cp"
    },
    "date_sources": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "fichiers": {
      "type": "object",
      "required": [
        "series",
        "affectation",
        "perception"
      ],
      "additionalProperties": false,
      "properties": {
        "series": {
          "const": "douanes_accises/series.json"
        },
        "affectation": {
          "const": "douanes_accises/affectation.json"
        },
        "perception": {
          "const": "douanes_accises/perception.json"
        }
      }
    },
    "produits": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": [
          "id",
          "libelle",
          "definition",
          "lignes_series",
          "lignes_affectation",
          "postes_perception",
          "repartition_derniere_annee"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "enum": [
              "energies",
              "tabacs",
              "alcools_boissons",
              "droits_douane",
              "autres"
            ]
          },
          "libelle": {
            "type": "string"
          },
          "definition": {
            "type": "string"
          },
          "lignes_series": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "lignes_affectation": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "postes_perception": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "repartition_derniere_annee": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "required": [
                  "annee",
                  "total_md",
                  "par_beneficiaire_md",
                  "parts",
                  "source"
                ],
                "additionalProperties": false,
                "properties": {
                  "annee": {
                    "$ref": "commun.schema.json#/$defs/annee"
                  },
                  "total_md": {
                    "type": "number"
                  },
                  "par_beneficiaire_md": {
                    "type": "object",
                    "required": [
                      "administration_centrale",
                      "securite_sociale",
                      "collectivites",
                      "union_europeenne"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "administration_centrale": {
                        "type": [
                          "number",
                          "null"
                        ]
                      },
                      "securite_sociale": {
                        "type": [
                          "number",
                          "null"
                        ]
                      },
                      "collectivites": {
                        "type": [
                          "number",
                          "null"
                        ]
                      },
                      "union_europeenne": {
                        "type": [
                          "number",
                          "null"
                        ]
                      }
                    }
                  },
                  "parts": {
                    "type": "object",
                    "required": [
                      "administration_centrale",
                      "securite_sociale",
                      "collectivites",
                      "union_europeenne"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "administration_centrale": {
                        "type": [
                          "number",
                          "null"
                        ]
                      },
                      "securite_sociale": {
                        "type": [
                          "number",
                          "null"
                        ]
                      },
                      "collectivites": {
                        "type": [
                          "number",
                          "null"
                        ]
                      },
                      "union_europeenne": {
                        "type": [
                          "number",
                          "null"
                        ]
                      }
                    }
                  },
                  "source": {
                    "type": "string"
                  }
                }
              }
            ]
          }
        }
      }
    },
    "definitions": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "liens": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "vue",
          "fichier",
          "champ",
          "lecture"
        ],
        "additionalProperties": false,
        "properties": {
          "vue": {
            "type": "string"
          },
          "fichier": {
            "type": "string",
            "pattern": "\\.json$"
          },
          "champ": {
            "type": "string"
          },
          "lecture": {
            "type": "string"
          }
        }
      }
    },
    "ecarts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "produit",
          "libelle",
          "annee",
          "insee_md",
          "ocde_md",
          "douane_percu_md",
          "ecart_ocde_insee_md",
          "ecart_douane_insee_md",
          "lecture_ecart"
        ],
        "additionalProperties": false,
        "properties": {
          "produit": {
            "enum": [
              "energies",
              "tabacs",
              "alcools_boissons",
              "droits_douane",
              "autres"
            ]
          },
          "libelle": {
            "type": "string"
          },
          "annee": {
            "$ref": "commun.schema.json#/$defs/annee"
          },
          "insee_md": {
            "type": [
              "number",
              "null"
            ]
          },
          "ocde_md": {
            "type": [
              "number",
              "null"
            ]
          },
          "douane_percu_md": {
            "type": [
              "number",
              "null"
            ]
          },
          "ecart_ocde_insee_md": {
            "type": [
              "number",
              "null"
            ]
          },
          "ecart_douane_insee_md": {
            "type": [
              "number",
              "null"
            ]
          },
          "lecture_ecart": {
            "type": "string"
          }
        }
      }
    },
    "limites": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "regle": {
      "type": "string"
    },
    "sources": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": [
          "id",
          "url",
          "titre",
          "licence",
          "verdict"
        ]
      }
    },
    "sources_inaccessibles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source",
          "url",
          "constat",
          "effet"
        ]
      }
    },
    "recherche_publique": {
      "type": "object",
      "required": [
        "date",
        "conclusion",
        "trouvailles"
      ],
      "properties": {
        "date": {
          "type": "string"
        },
        "conclusion": {
          "type": "string"
        },
        "trouvailles": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "required": [
              "nom",
              "url",
              "licence",
              "verdict"
            ],
            "properties": {
              "nom": {
                "type": "string"
              },
              "url": {
                "type": "string"
              },
              "licence": {
                "type": "string"
              },
              "verdict": {
                "type": "string"
              },
              "mise_a_jour": {
                "type": "string"
              },
              "dernier_commit": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
