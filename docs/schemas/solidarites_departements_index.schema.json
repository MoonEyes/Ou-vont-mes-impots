{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ou-vont-mes-impots.fr/contrat/v1/solidarites_departements_index.schema.json",
  "title": "site/data/solidarites_departements/index.json : collectivités par département, totaux nationaux, reste à charge calculé, écarts nationaux, liens, méthode, sources (pipeline/solidarites_departements.py)",
  "allOf": [
    {
      "$ref": "commun.schema.json#/$defs/entete"
    }
  ],
  "type": "object",
  "required": [
    "millesime",
    "source",
    "unite",
    "date_sources",
    "presentation",
    "annees_comptes",
    "annees_beneficiaires",
    "fichiers",
    "departements",
    "collectivites",
    "liens",
    "totaux",
    "reste_a_charge",
    "ecarts",
    "ecarts_departements",
    "rsa_recentralise",
    "methode",
    "limites",
    "regle",
    "ordre",
    "sources",
    "sources_inaccessibles",
    "recherche_publique"
  ],
  "properties": {
    "unite": {
      "type": "string",
      "minLength": 3
    },
    "date_sources": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "presentation": {
      "type": "string",
      "minLength": 50
    },
    "annees_comptes": {
      "type": "array",
      "items": {
        "$ref": "commun.schema.json#/$defs/annee_entier"
      },
      "minItems": 1
    },
    "annees_beneficiaires": {
      "type": "array",
      "items": {
        "$ref": "commun.schema.json#/$defs/annee_entier"
      }
    },
    "fichiers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "comptes",
        "beneficiaires",
        "ecarts"
      ],
      "properties": {
        "comptes": {
          "const": "solidarites_departements/comptes.json"
        },
        "beneficiaires": {
          "const": "solidarites_departements/beneficiaires.json"
        },
        "ecarts": {
          "const": "solidarites_departements/ecarts.json"
        }
      }
    },
    "departements": {
      "type": "array",
      "minItems": 95,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "nom",
          "comptes",
          "beneficiaires",
          "liens"
        ],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^([0-9]{2,3}|2A|2B)$"
          },
          "nom": {
            "type": "string",
            "minLength": 2
          },
          "comptes": {
            "$ref": "#/$defs/codes"
          },
          "beneficiaires": {
            "$ref": "#/$defs/codes"
          },
          "liens": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "pattern": "^[a-z_]+/[0-9AB]{2,3}\\.json$"
            }
          }
        }
      }
    },
    "collectivites": {
      "type": "array",
      "minItems": 95,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "nom",
          "departements",
          "comptes",
          "beneficiaires"
        ],
        "properties": {
          "code": {
            "$ref": "#/$defs/code"
          },
          "nom": {
            "type": "string",
            "minLength": 2
          },
          "departements": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^([0-9]{2,3}|2A|2B)$"
            },
            "minItems": 1
          },
          "comptes": {
            "type": "boolean"
          },
          "beneficiaires": {
            "type": "boolean"
          },
          "perimetre": {
            "type": "string",
            "minLength": 10
          },
          "perimetre_beneficiaires": {
            "type": "string",
            "minLength": 10
          }
        }
      }
    },
    "liens": {
      "type": "object",
      "required": [
        "depenses_drees_par_poste",
        "foyers_rsa_caf"
      ]
    },
    "totaux": {
      "type": "object",
      "propertyNames": {
        "$ref": "commun.schema.json#/$defs/annee"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "collectivites",
          "eur",
          "collectivites_par_colonne",
          "reste_a_charge_calcule"
        ],
        "properties": {
          "collectivites": {
            "type": "integer",
            "minimum": 0
          },
          "eur": {
            "type": "object",
            "additionalProperties": {
              "type": [
                "integer",
                "null"
              ]
            }
          },
          "collectivites_par_colonne": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "minimum": 0
            }
          },
          "reste_a_charge_calcule": {
            "type": "object",
            "required": [
              "rsa",
              "apa_pch"
            ],
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "montant_eur",
                "collectivites",
                "allocations_eur",
                "recettes_eur",
                "part_couverte_pct"
              ],
              "properties": {
                "montant_eur": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "collectivites": {
                  "type": "integer",
                  "minimum": 0
                },
                "allocations_eur": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "recettes_eur": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "part_couverte_pct": {
                  "type": [
                    "number",
                    "null"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "reste_a_charge": {
      "$ref": "solidarites_departements_comptes.schema.json#/$defs/reste_a_charge"
    },
    "ecarts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "annee",
          "grandeur",
          "source",
          "valeur",
          "autre_source",
          "autre_valeur",
          "ecart",
          "ecart_pct",
          "lecture_ecart"
        ],
        "properties": {
          "annee": {
            "$ref": "commun.schema.json#/$defs/annee_entier"
          },
          "grandeur": {
            "enum": [
              "allocations_apa",
              "allocations_pch",
              "allocations_rsa"
            ]
          },
          "source": {
            "type": "string"
          },
          "valeur": {
            "type": "integer"
          },
          "autre_source": {
            "type": "string"
          },
          "autre_valeur": {
            "type": "integer"
          },
          "ecart": {
            "type": "integer"
          },
          "ecart_pct": {
            "type": [
              "number",
              "null"
            ]
          },
          "lecture_ecart": {
            "type": "string",
            "minLength": 10
          }
        }
      }
    },
    "ecarts_departements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fichier",
        "lignes",
        "par_grandeur"
      ],
      "properties": {
        "fichier": {
          "const": "solidarites_departements/ecarts.json"
        },
        "lignes": {
          "type": "integer",
          "minimum": 0
        },
        "par_grandeur": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "rsa_recentralise": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "premiere_annee_entiere"
        ],
        "properties": {
          "premiere_annee_entiere": {
            "$ref": "commun.schema.json#/$defs/annee_entier"
          },
          "debut": {
            "type": "string"
          }
        }
      }
    },
    "methode": {
      "type": "object",
      "required": [
        "comptes",
        "beneficiaires",
        "reste_a_charge",
        "ecarts"
      ],
      "additionalProperties": {
        "type": "string",
        "minLength": 10
      }
    },
    "limites": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 10
      },
      "minItems": 1
    },
    "regle": {
      "type": "string",
      "minLength": 10
    },
    "ordre": {
      "type": "object",
      "required": [
        "cles",
        "regle"
      ]
    },
    "sources": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "titre",
          "page",
          "producteur",
          "licence",
          "millesime",
          "verdict"
        ],
        "properties": {
          "titre": {
            "type": "string",
            "minLength": 10
          },
          "url": {
            "type": "string",
            "pattern": "^https://"
          },
          "page": {
            "type": "string",
            "minLength": 5
          },
          "producteur": {
            "type": "string"
          },
          "licence": {
            "type": "string"
          },
          "millesime": {
            "type": "string"
          },
          "verdict": {
            "type": "string",
            "pattern": "^(réutilisable tel quel|à adapter|inspiration seulement)"
          },
          "id_catalogue": {
            "type": "string"
          },
          "entrepot": {
            "type": "string",
            "pattern": "^data/lake/"
          },
          "collecte_le": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "sources_inaccessibles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source",
          "constat_le",
          "motif"
        ],
        "properties": {
          "source": {
            "type": "string",
            "minLength": 3
          },
          "constat_le": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "motif": {
            "type": "string",
            "minLength": 5
          }
        }
      }
    },
    "recherche_publique": {
      "type": "object",
      "required": [
        "date",
        "requetes",
        "conclusion",
        "trouvailles"
      ],
      "properties": {
        "date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "requetes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "conclusion": {
          "type": "string",
          "minLength": 20
        },
        "trouvailles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "nom",
              "url",
              "licence",
              "verdict"
            ],
            "properties": {
              "verdict": {
                "type": "string",
                "pattern": "^(réutilisable tel quel|à adapter|inspiration seulement|inaccessible)"
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "code": {
      "type": "string",
      "pattern": "^([0-9]{2,3}|2A|2B|6AE|69D|69M|20R)$"
    },
    "codes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/code"
      }
    }
  }
}
