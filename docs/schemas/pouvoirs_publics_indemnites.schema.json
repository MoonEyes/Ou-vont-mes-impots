{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ou-vont-mes-impots.fr/contrat/v1/pouvoirs_publics_indemnites.schema.json",
  "title": "site/data/pouvoirs_publics/indemnites.json : barèmes mensuels par fonction, parlementaires et membres du Gouvernement (pipeline/pouvoirs_publics.py)",
  "allOf": [
    {
      "$ref": "commun.schema.json#/$defs/entete"
    }
  ],
  "type": "object",
  "required": [
    "millesime",
    "source",
    "collecte_le",
    "unite",
    "regle_personnes",
    "definition",
    "moyenne_hors_echelle_mensuelle_eur",
    "parlementaires",
    "indemnites_speciales",
    "moyens_du_mandat",
    "moyens_du_mandat_lecture",
    "gouvernement",
    "coefficients_decrets",
    "elus_locaux",
    "limites"
  ],
  "properties": {
    "collecte_le": {
      "type": "string",
      "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}$"
    },
    "unite": {
      "const": "euros par mois"
    },
    "regle_personnes": {
      "type": "string",
      "minLength": 1
    },
    "definition": {
      "type": "string",
      "minLength": 1
    },
    "moyenne_hors_echelle_mensuelle_eur": {
      "type": "number",
      "minimum": 1000
    },
    "parlementaires": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": [
          "fonction",
          "element",
          "montant_brut_mensuel_eur",
          "statut",
          "source"
        ],
        "properties": {
          "fonction": {
            "type": "string",
            "minLength": 1
          },
          "element": {
            "type": "string",
            "minLength": 1
          },
          "montant_brut_mensuel_eur": {
            "type": [
              "number",
              "null"
            ]
          },
          "montant_net_mensuel_eur": {
            "type": [
              "number",
              "null"
            ]
          },
          "statut": {
            "enum": [
              "tracé",
              "approché",
              "calculé par le site",
              "non publié"
            ]
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "base_legale": {
            "type": [
              "string",
              "null"
            ]
          },
          "methode": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "indemnites_speciales": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "fonction",
          "assemblee",
          "montant_brut_mensuel_eur",
          "statut",
          "source"
        ]
      }
    },
    "moyens_du_mandat": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "libelle",
          "montant_mensuel_eur",
          "statut",
          "source"
        ]
      }
    },
    "moyens_du_mandat_lecture": {
      "type": "string",
      "minLength": 1
    },
    "gouvernement": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fonction",
          "coefficient_moyenne_hors_echelle",
          "majoration_pct",
          "traitement_brut_mensuel_eur",
          "indemnite_residence_eur",
          "indemnite_fonction_eur",
          "total_brut_mensuel_eur",
          "base_legale",
          "statut",
          "methode"
        ],
        "properties": {
          "fonction": {
            "type": "string",
            "minLength": 1
          },
          "coefficient_moyenne_hors_echelle": {
            "type": "number"
          },
          "majoration_pct": {
            "type": "number"
          },
          "traitement_brut_mensuel_eur": {
            "type": "number"
          },
          "indemnite_residence_eur": {
            "type": "number"
          },
          "indemnite_fonction_eur": {
            "type": "number"
          },
          "total_brut_mensuel_eur": {
            "type": "number"
          },
          "base_legale": {
            "type": "string",
            "minLength": 1
          },
          "statut": {
            "enum": [
              "tracé",
              "approché",
              "calculé par le site",
              "non publié"
            ]
          },
          "methode": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "coefficients_decrets": {
      "type": "object",
      "required": [
        "coef_president_pm",
        "coef_ministre",
        "majoration_pct",
        "coef_secretaire_etat",
        "residence_pct",
        "fonction_pct"
      ]
    },
    "elus_locaux": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "fichier"
      ],
      "properties": {
        "fichier": {
          "const": "fonction_publique/indemnites_elus.json"
        }
      }
    },
    "limites": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
