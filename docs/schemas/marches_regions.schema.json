{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ou-vont-mes-impots.fr/contrat/v1/marches_regions.schema.json",
  "title": "site/data/marches/regions.json : marchés retenus par région de l'acheteur (déduite du département) et par année (pipeline/marches.py)",
  "allOf": [
    {
      "$ref": "commun.schema.json#/$defs/entete"
    }
  ],
  "type": "object",
  "properties": {
    "millesime": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "unite": {
      "type": "string",
      "pattern": "^euros HT"
    },
    "collecte_le": {
      "type": "string",
      "format": "date"
    },
    "annees": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 2019,
        "maximum": 2100
      },
      "minItems": 1
    },
    "note": {
      "type": "string",
      "minLength": 1
    },
    "ordre": {
      "type": "string",
      "minLength": 1
    },
    "regions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "region": {
            "type": "string",
            "pattern": "^(\\d{2}|COM)$"
          },
          "nom": {
            "type": "string",
            "minLength": 1
          },
          "departements": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(\\d{2}|2[AB]|9[78]\\d)$"
            },
            "minItems": 1
          },
          "marches": {
            "type": "integer",
            "minimum": 0
          },
          "acheteurs": {
            "type": "integer",
            "minimum": 0
          },
          "total_eur": {
            "type": "number"
          },
          "montants_eur": {
            "type": "array",
            "items": {
              "type": [
                "number",
                "null"
              ]
            },
            "minItems": 1
          },
          "par_type": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "Travaux",
                    "Services",
                    "Fournitures",
                    "Non catégorisé"
                  ]
                },
                "marches": {
                  "type": "integer",
                  "minimum": 0
                },
                "montant_eur": {
                  "type": "number"
                }
              },
              "required": [
                "type",
                "marches",
                "montant_eur"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "region",
          "nom",
          "departements",
          "marches",
          "acheteurs",
          "total_eur",
          "montants_eur",
          "par_type"
        ],
        "additionalProperties": false
      }
    },
    "non_localise": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "marches": {
              "type": "integer",
              "minimum": 0
            },
            "acheteurs": {
              "type": "integer",
              "minimum": 0
            },
            "total_eur": {
              "type": "number"
            },
            "montants_eur": {
              "type": "array",
              "items": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "minItems": 1
            },
            "par_type": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "Travaux",
                      "Services",
                      "Fournitures",
                      "Non catégorisé"
                    ]
                  },
                  "marches": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "montant_eur": {
                    "type": "number"
                  }
                },
                "required": [
                  "type",
                  "marches",
                  "montant_eur"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "marches",
            "acheteurs",
            "total_eur",
            "montants_eur",
            "par_type"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "millesime",
    "source",
    "unite",
    "collecte_le",
    "annees",
    "note",
    "ordre",
    "regions",
    "non_localise"
  ],
  "additionalProperties": false
}
