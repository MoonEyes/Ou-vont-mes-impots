{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ou-vont-mes-impots.fr/contrat/v1/fiscalite_locale_series_departement.schema.json",
  "title": "site/data/fiscalite_locale_series/taux/<dep>.json et produits/<dep>.json : séries annuelles par commune d'un département (REI, DGFiP ; pipeline/fiscalite_locale_series.py)",
  "allOf": [{"$ref": "commun.schema.json#/$defs/entete"}],
  "type": "object",
  "$defs": {
    "cle": {"enum": ["tfb_commune", "tfb_intercommunalite", "tfb_departement", "tfnb_commune", "tfnb_intercommunalite",
      "th_commune", "th_intercommunalite", "cfe_commune", "cfe_intercommunalite_additionnelle",
      "cfe_intercommunalite_unique", "teom_taux_plein", "teom"]}
  },
  "properties": {
    "millesime": {"type": "string"}, "source": {"type": "string"},
    "licence": {"type": "string"},
    "departement": {"type": "string", "pattern": "^([0-9]{2}|2[AB]|97[0-9])$"},
    "unite": {"enum": ["%", "euros"]},
    "annees": {"type": "array", "items": {"$ref": "commun.schema.json#/$defs/annee_entier"}, "minItems": 1},
    "variables": {"type": "array", "items": {"$ref": "#/$defs/cle"}, "minItems": 1},
    "complement_local_taux": {"type": "object",
      "properties": {
        "fichier": {"type": "string", "pattern": "^local/taux/([0-9]{2}|2[AB]|97[0-9])\\.json$"},
        "exercices": {"type": "array", "items": {"$ref": "commun.schema.json#/$defs/annee_entier"}},
        "colonnes": {"type": "object", "propertyNames": {"$ref": "#/$defs/cle"},
          "additionalProperties": {"type": "string"}}},
      "required": ["fichier", "exercices", "colonnes"], "additionalProperties": false},
    "communes": {"type": "object", "minProperties": 1,
      "propertyNames": {"pattern": "^([0-9]{5}|2[AB][0-9]{3})$"},
      "additionalProperties": {"type": "object",
        "properties": {
          "nom": {"type": ["string", "null"]},
          "series": {"type": "object", "propertyNames": {"$ref": "#/$defs/cle"},
            "additionalProperties": {"type": "array", "items": {"type": ["number", "null"]}, "minItems": 1}}},
        "required": ["nom", "series"], "additionalProperties": false}}
  },
  "required": ["millesime", "source", "licence", "departement", "unite", "annees", "variables", "communes"],
  "additionalProperties": false
}
