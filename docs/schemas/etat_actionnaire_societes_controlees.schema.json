{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ou-vont-mes-impots.fr/contrat/v1/etat_actionnaire_societes_controlees.schema.json",
  "title": "site/data/etat_actionnaire/societes_controlees.json : sociétés contrôlées majoritairement par l'État, nombre, effectifs et activités (Insee)",
  "allOf": [
    {
      "$ref": "commun.schema.json#/$defs/entete"
    }
  ],
  "type": "object",
  "properties": {
    "millesime": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "unite": {
      "type": "string"
    },
    "avertissement": {
      "type": "string",
      "minLength": 20
    },
    "collecte_le": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "url": {
      "type": "string",
      "pattern": "^https://www\\.insee\\.fr/"
    },
    "ordre": {
      "type": "object",
      "required": [
        "regle",
        "cles"
      ],
      "properties": {
        "regle": {
          "type": "string",
          "minLength": 10
        },
        "cles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "serie": {
      "type": "array",
      "minItems": 20,
      "items": {
        "type": "object",
        "required": [
          "annee",
          "societes",
          "effectifs_milliers",
          "part_emploi_salarie_pct"
        ],
        "additionalProperties": false,
        "properties": {
          "annee": {
            "type": "integer",
            "minimum": 1990
          },
          "societes": {
            "type": [
              "integer",
              "null"
            ]
          },
          "effectifs_milliers": {
            "type": [
              "number",
              "null"
            ]
          },
          "part_emploi_salarie_pct": {
            "type": [
              "number",
              "null"
            ]
          }
        }
      }
    },
    "activites": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": [
          "nom",
          "niveau",
          "societes_2021",
          "societes_2022",
          "effectifs_2021",
          "effectifs_2022"
        ],
        "properties": {
          "niveau": {
            "enum": [
              1,
              2
            ]
          },
          "parent": {
            "type": "string"
          },
          "societes_2021": {
            "type": [
              "number",
              "null"
            ]
          },
          "societes_2022": {
            "type": [
              "number",
              "null"
            ]
          },
          "effectifs_2021": {
            "type": [
              "number",
              "null"
            ]
          },
          "effectifs_2022": {
            "type": [
              "number",
              "null"
            ]
          },
          "secret_statistique": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": [
                "societes_2021",
                "societes_2022",
                "effectifs_2021",
                "effectifs_2022"
              ]
            }
          }
        }
      }
    }
  },
  "required": [
    "millesime",
    "source",
    "unite",
    "avertissement",
    "collecte_le",
    "url",
    "ordre",
    "serie",
    "activites"
  ]
}
