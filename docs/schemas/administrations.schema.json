{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ou-vont-mes-impots.fr/contrat/v1/administrations.schema.json",
  "title": "site/data/administrations.json : recettes, depenses et solde de chaque administration publique",
  "type": "object",
  "required": [
    "unite",
    "TR",
    "TE",
    "B9",
    "annees"
  ],
  "additionalProperties": false,
  "properties": {
    "unite": {
      "const": "milliards d'euros"
    },
    "TR": {
      "const": "recettes"
    },
    "TE": {
      "const": "depenses"
    },
    "B9": {
      "const": "solde (negatif = deficit)"
    },
    "annees": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "type": "string",
        "pattern": "^(19|20)[0-9]{2}$"
      },
      "additionalProperties": {
        "type": "object",
        "propertyNames": {
          "enum": [
            "Ensemble",
            "Etat",
            "Collectivites locales",
            "Securite sociale"
          ]
        },
        "required": [
          "Ensemble",
          "Etat",
          "Collectivites locales",
          "Securite sociale"
        ],
        "additionalProperties": {
          "type": "object",
          "required": [
            "TR",
            "TE",
            "B9"
          ],
          "propertyNames": {
            "enum": [
              "TR",
              "TE",
              "B9",
              "D73PAY",
              "D92PAY",
              "D99PAY"
            ]
          },
          "additionalProperties": {
            "type": "number"
          }
        }
      }
    }
  }
}
