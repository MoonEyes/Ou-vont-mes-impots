{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ou-vont-mes-impots.fr/contrat/v1/sante_etablissements_departement.schema.json",
  "title": "site/data/sante_etablissements/departements/<dep>.json : comptes par commune et établissements nommés (personnes morales seulement) d'un département (pipeline/sante_etablissements.py)",
  "allOf": [
    {
      "$ref": "commun.schema.json#/$defs/entete"
    }
  ],
  "type": "object",
  "properties": {
    "millesime": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "collecte_le": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "unite": {
      "type": "string"
    },
    "departement": {
      "type": "string",
      "pattern": "^([0-9]{2}|2A|2B|9[78][0-9])$"
    },
    "note_perimetre": {
      "type": "string"
    },
    "note_prix": {
      "type": "string"
    },
    "communes": {
      "type": "object",
      "properties": {
        "colonnes": {
          "type": "array",
          "prefixItems": [
            {
              "const": "code"
            },
            {
              "const": "nom"
            },
            {
              "const": "etablissements"
            },
            {
              "const": "hospitalier"
            },
            {
              "const": "soins_prevention"
            },
            {
              "const": "autres_sanitaires"
            },
            {
              "const": "social_medico_social"
            },
            {
              "const": "formation"
            },
            {
              "const": "non_classe"
            },
            {
              "const": "public"
            },
            {
              "const": "prive_non_lucratif"
            },
            {
              "const": "prive_commercial"
            },
            {
              "const": "ehpad"
            },
            {
              "const": "ehpad_avec_prix"
            },
            {
              "const": "prix_hebergement_chambre_seule_median_eur"
            },
            {
              "const": "prix_hebergement_chambre_seule_aide_sociale_median_eur"
            },
            {
              "const": "tarif_dependance_gir_1_2_median_eur"
            },
            {
              "const": "tarif_dependance_gir_3_4_median_eur"
            },
            {
              "const": "tarif_dependance_gir_5_6_median_eur"
            }
          ],
          "minItems": 20,
          "maxItems": 20,
          "items": {
            "type": "string",
            "pattern": "^actes_ccam_20[0-9]{2}$"
          }
        },
        "annee_prix": {
          "$ref": "commun.schema.json#/$defs/annee_entier"
        },
        "lignes": {
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "string",
                "pattern": "^([0-9]{5}|2[AB][0-9]{3})$"
              },
              {
                "type": [
                  "string",
                  "null"
                ]
              },
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "integer",
                "minimum": 0
              }
            ],
            "items": {
              "type": [
                "number",
                "null"
              ]
            },
            "minItems": 20,
            "maxItems": 20
          }
        }
      },
      "required": [
        "colonnes",
        "annee_prix",
        "lignes"
      ],
      "additionalProperties": false
    },
    "etablissements": {
      "type": "object",
      "properties": {
        "colonnes": {
          "type": "array",
          "prefixItems": [
            {
              "const": "finess"
            },
            {
              "const": "nom"
            },
            {
              "const": "finess_entite_juridique"
            },
            {
              "const": "siren"
            },
            {
              "const": "entite_juridique"
            },
            {
              "const": "commune"
            },
            {
              "const": "categorie"
            },
            {
              "const": "secteur"
            }
          ],
          "items": {
            "type": "string"
          },
          "contains": {
            "const": "prix_declares_le"
          }
        },
        "annee_prix": {
          "$ref": "commun.schema.json#/$defs/annee_entier"
        },
        "ordre": {
          "type": "string"
        },
        "lignes": {
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "string",
                "pattern": "^[0-9AB]{9}$"
              },
              {
                "type": "string",
                "minLength": 1,
                "description": "dénomination de l'établissement (personne morale)"
              },
              {
                "type": "string",
                "pattern": "^[0-9AB]{9}$"
              },
              {
                "$ref": "commun.schema.json#/$defs/siren"
              },
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "string",
                "pattern": "^([0-9]{5}|2[AB][0-9]{3})$"
              },
              {
                "type": [
                  "string",
                  "null"
                ]
              },
              {
                "enum": [
                  "public",
                  "prive_non_lucratif",
                  "prive_commercial",
                  null
                ]
              }
            ],
            "items": {
              "type": [
                "number",
                "string",
                "null"
              ]
            },
            "minItems": 15
          }
        }
      },
      "required": [
        "colonnes",
        "annee_prix",
        "ordre",
        "lignes"
      ],
      "additionalProperties": false
    },
    "non_nommes": {
      "type": "object",
      "properties": {
        "regle": {
          "type": "string"
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "par_motif": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "absent_de_finess",
              "personne_physique",
              "siren_absent",
              "siren_inconnu_de_sirene",
              "categorie_juridique_non_verifiee",
              "titre_de_personne_dans_la_denomination"
            ]
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "required": [
        "regle",
        "total",
        "par_motif"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "collecte_le",
    "unite",
    "departement",
    "note_perimetre",
    "note_prix",
    "communes",
    "etablissements",
    "non_nommes"
  ],
  "additionalProperties": false
}
