{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ou-vont-mes-impots.fr/contrat/v1/performance_barometre_zone.schema.json",
  "title": "site/data/performance/barometre/<département ou FR>.json : valeurs initiales, successives et cibles des indicateurs du baromètre de la DITP (pipeline/performance.py)",
  "allOf": [
    {
      "$ref": "commun.schema.json#/$defs/entete"
    }
  ],
  "type": "object",
  "required": [
    "millesime",
    "source",
    "collecte_le",
    "code",
    "nom",
    "lecture",
    "indicateurs"
  ],
  "properties": {
    "collecte_le": {
      "type": "string",
      "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}$"
    },
    "code": {
      "type": "string",
      "pattern": "^([0-9]{2,3}|2[AB]|FR)$"
    },
    "nom": {
      "type": "string",
      "minLength": 1
    },
    "lecture": {
      "type": "string",
      "minLength": 1
    },
    "indicateurs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "initiale",
          "valeurs",
          "cibles"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^IND-[0-9]+$"
          },
          "initiale": {
            "type": "array",
            "items": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "string",
                  "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}$"
                },
                {
                  "type": "number"
                }
              ],
              "minItems": 2,
              "maxItems": 2
            }
          },
          "valeurs": {
            "type": "array",
            "items": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "string",
                  "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}$"
                },
                {
                  "type": "number"
                }
              ],
              "minItems": 2,
              "maxItems": 2
            }
          },
          "cibles": {
            "type": "array",
            "items": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "string",
                  "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}$"
                },
                {
                  "type": "number"
                }
              ],
              "minItems": 2,
              "maxItems": 2
            }
          }
        }
      }
    }
  },
  "not": {
    "anyOf": [
      {
        "required": [
          "taux_avancement"
        ]
      }
    ]
  }
}
