{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ou-vont-mes-impots.fr/contrat/v1/numerique_etat_fast.schema.json",
  "title": "site/data/numerique_etat/fonds/fast.json : projets lauréats du Fonds d'accélération des startups d'État et de territoires, par appel et par année",
  "allOf": [
    {
      "$ref": "commun.schema.json#/$defs/entete"
    }
  ],
  "type": "object",
  "properties": {
    "millesime": {
      "type": "string",
      "minLength": 4
    },
    "source": {
      "type": "string",
      "minLength": 10
    },
    "unite": {
      "type": "string",
      "minLength": 4
    },
    "collecte_le": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "avertissement": {
      "type": "string",
      "minLength": 40
    },
    "note": {
      "type": [
        "string",
        "null"
      ]
    },
    "arbre_etat": {
      "type": "object",
      "required": [
        "programme",
        "noeud",
        "nom_programme",
        "fichier",
        "action",
        "nom_action",
        "rattachement"
      ],
      "properties": {
        "programme": {
          "type": "string",
          "pattern": "^[0-9]{3}$"
        },
        "noeud": {
          "type": "string"
        },
        "fichier": {
          "type": "string",
          "pattern": "^arbre/.+\\.json$"
        },
        "action": {
          "type": "string",
          "pattern": "^[0-9]{3}-[0-9]{2}$"
        },
        "nom_action": {
          "type": "string"
        },
        "rattachement": {
          "type": "string"
        }
      }
    },
    "definitions": {
      "type": "object"
    },
    "total": {
      "type": "object",
      "required": [
        "projets",
        "montant_publie_eur",
        "projets_sans_montant_publie"
      ],
      "additionalProperties": false,
      "properties": {
        "projets": {
          "type": "integer",
          "minimum": 0
        },
        "montant_publie_eur": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "projets_sans_montant_publie": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "par_appel": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "required": [
          "numero",
          "annee",
          "mois",
          "libelle",
          "projets",
          "montant_publie_eur",
          "projets_sans_montant_publie"
        ],
        "properties": {
          "numero": {
            "type": "integer"
          },
          "annee": {
            "$ref": "commun.schema.json#/$defs/annee_entier"
          },
          "mois": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 12
          }
        }
      }
    },
    "par_annee": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "annee",
          "projets",
          "montant_publie_eur",
          "projets_sans_montant_publie"
        ],
        "properties": {
          "annee": {
            "type": [
              "integer",
              "null"
            ]
          },
          "projets": {
            "type": "integer"
          },
          "montant_publie_eur": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "projets_sans_montant_publie": {
            "type": "integer"
          }
        }
      }
    },
    "ordre": {
      "type": "object",
      "required": [
        "regle",
        "cles"
      ],
      "properties": {
        "regle": {
          "type": "string"
        },
        "cles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "projets": {
      "type": "array",
      "minItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "propertyNames": {
          "not": {
            "pattern": "(?i)pr[eé]nom|courriel|e-?mail|t[eé]l[eé]phone|adresse|contact|dirigeant|responsable"
          }
        },
        "required": [
          "appel",
          "annee",
          "laureat",
          "projet",
          "objet",
          "montant_eur",
          "dont_coaching_eur",
          "coaching_mention"
        ],
        "properties": {
          "appel": {
            "type": [
              "integer",
              "null"
            ]
          },
          "annee": {
            "type": [
              "integer",
              "null"
            ]
          },
          "laureat": {
            "type": [
              "string",
              "null"
            ]
          },
          "projet": {
            "type": [
              "string",
              "null"
            ]
          },
          "objet": {
            "type": [
              "string",
              "null"
            ]
          },
          "montant_eur": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "dont_coaching_eur": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "coaching_mention": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  },
  "required": [
    "millesime",
    "source",
    "unite",
    "collecte_le",
    "avertissement",
    "arbre_etat",
    "total",
    "par_appel",
    "par_annee",
    "ordre",
    "projets"
  ]
}
