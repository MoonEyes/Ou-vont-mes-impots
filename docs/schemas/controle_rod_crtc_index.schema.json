{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ou-vont-mes-impots.fr/contrat/v1/controle_rod_crtc_index.schema.json",
  "title": "Rapports d'observations définitives des chambres régionales et territoriales des comptes (2020 à 2026) : index",
  "description": "controle/rod_crtc/index.json : périmètre, règles (personnes, rattachement), fichiers annuels, comptes, thèmes, pages des chambres hors rapports, couverture de la collecte.",
  "allOf": [
    {
      "$ref": "commun.schema.json#/$defs/entete"
    }
  ],
  "type": "object",
  "properties": {
    "perimetre": {
      "type": "string",
      "minLength": 10
    },
    "regle_personnes": {
      "type": "string",
      "minLength": 10
    },
    "regles_rattachement": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "fichiers": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^controle/rod_crtc/202[0-6]\\.json$"
      }
    },
    "comptes": {
      "type": "object",
      "properties": {
        "rapports": {
          "type": "integer",
          "minimum": 0
        },
        "par_annee": {
          "type": "object",
          "propertyNames": {
            "pattern": "^202[0-6]$"
          },
          "additionalProperties": {
            "type": "integer"
          }
        },
        "par_chambre": {
          "type": "object"
        },
        "par_niveau": {
          "type": "object"
        },
        "par_type_organisme": {
          "type": "object"
        },
        "avec_code_commune": {
          "type": "integer"
        },
        "avec_code_epci": {
          "type": "integer"
        },
        "avec_departement": {
          "type": "integer"
        },
        "avec_siren": {
          "type": "integer"
        },
        "siren_par_methode": {
          "type": "object"
        },
        "personne_morale": {
          "type": "object",
          "properties": {
            "etablie": {
              "type": "integer"
            },
            "par_preuve": {
              "type": "object"
            }
          },
          "required": [
            "etablie",
            "par_preuve"
          ]
        },
        "intitules_non_publies": {
          "type": "integer"
        },
        "avec_document": {
          "type": "integer"
        },
        "hors_periode": {
          "type": "object"
        },
        "repris_de_la_memoire_publiee": {
          "type": "integer"
        }
      },
      "required": [
        "rapports",
        "par_annee",
        "par_chambre",
        "par_niveau",
        "avec_code_commune",
        "avec_siren",
        "personne_morale",
        "intitules_non_publies"
      ]
    },
    "themes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "theme": {
            "type": "string"
          },
          "rapports": {
            "type": "integer"
          }
        },
        "required": [
          "theme",
          "rapports"
        ]
      }
    },
    "pages_crtc_hors_rapports": {
      "type": "object",
      "properties": {
        "par_categorie": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          }
        },
        "note": {
          "type": "string"
        }
      },
      "required": [
        "par_categorie"
      ]
    },
    "couverture": {
      "type": "object",
      "properties": {
        "pages_au_plan_du_site": {
          "type": "integer"
        },
        "pages_modifiees_depuis_2020": {
          "type": "integer"
        },
        "pages_modifiees_depuis_2020_lues": {
          "type": "integer"
        },
        "pages_modifiees_depuis_2020_restantes": {
          "type": "integer"
        },
        "derniere_collecte": {
          "type": [
            "object",
            "null"
          ]
        },
        "lecture": {
          "type": "string"
        }
      },
      "required": [
        "pages_au_plan_du_site",
        "pages_modifiees_depuis_2020",
        "pages_modifiees_depuis_2020_lues",
        "pages_modifiees_depuis_2020_restantes",
        "lecture"
      ]
    }
  },
  "required": [
    "perimetre",
    "regle_personnes",
    "regles_rattachement",
    "fichiers",
    "comptes",
    "themes",
    "couverture"
  ]
}
