{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ou-vont-mes-impots.fr/contrat/v1/communes.schema.json",
  "title": "site/data/communes/<dep>.json : taux TFB et TEOM par commune",
  "allOf": [
    {
      "$ref": "commun.schema.json#/$defs/entete"
    }
  ],
  "type": "object",
  "properties": {
    "format": {
      "type": "string"
    },
    "communes": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^([0-9]{2}|2[AB])[0-9]{3}$"
      },
      "additionalProperties": {
        "type": "array",
        "minItems": 3,
        "items": false,
        "prefixItems": [
          {
            "type": "string",
            "minLength": 1,
            "description": "Nom DGFiP (majuscules, sans accent)"
          },
          {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 200,
            "description": "Taux global TFB en %"
          },
          {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 200,
            "description": "Taux plein TEOM en % ; null = pas de TEOM"
          }
        ]
      }
    }
  },
  "required": [
    "communes"
  ]
}
