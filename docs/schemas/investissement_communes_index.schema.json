{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://ou-vont-mes-impots.fr/contrat/v1/investissement_communes_index.schema.json",
 "title": "site/data/investissement_communes/index.json : exercices, définitions, méthode, couverture des balances et des crédits votés (pipeline/investissement_communes.py)",
 "allOf": [
  {
   "$ref": "commun.schema.json#/$defs/entete"
  }
 ],
 "type": "object",
 "required": [
  "millesime",
  "source",
  "annees",
  "colonnes",
  "definitions",
  "presentation",
  "methode",
  "methode_vote",
  "regle_null",
  "statut",
  "couverture",
  "jeux",
  "departements"
 ],
 "properties": {
  "annees": {
   "type": "array",
   "items": {
    "type": "string",
    "pattern": "^\\d{4}$"
   },
   "minItems": 1
  },
  "colonnes": {
   "const": [
    "equipement",
    "c20_hors_204",
    "c21",
    "c23",
    "c204"
   ]
  },
  "definitions": {
   "type": "object",
   "additionalProperties": {
    "type": "string"
   }
  },
  "presentation": {
   "type": "string"
  },
  "methode": {
   "type": "string"
  },
  "methode_vote": {
   "type": "string"
  },
  "regle_null": {
   "type": "string"
  },
  "statut": {
   "type": "object",
   "additionalProperties": {
    "type": "string"
   }
  },
  "couverture": {
   "type": "object",
   "propertyNames": {
    "pattern": "^\\d{4}$"
   },
   "additionalProperties": {
    "type": "object",
    "required": [
     "balances",
     "communes_rattachees",
     "balances_sans_commune_en_vigueur",
     "jeu",
     "publie_le"
    ]
   }
  },
  "vote_couverture": {
   "type": "object",
   "additionalProperties": {
    "type": "integer",
    "minimum": 0
   }
  },
  "jeux": {
   "type": "object"
  },
  "jeux_vote": {
   "type": "array"
  },
  "reference_datagouv": {
   "type": "string"
  },
  "departements": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "recherche_publique": {
   "type": "object"
  }
 }
}
