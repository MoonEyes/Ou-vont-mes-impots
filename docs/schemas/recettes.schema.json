{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ou-vont-mes-impots.fr/contrat/v1/recettes.schema.json",
  "title": "site/data/recettes.json : chaque impot par administration beneficiaire et par annee",
  "type": "object",
  "required": [
    "unite",
    "annees",
    "impots"
  ],
  "additionalProperties": false,
  "properties": {
    "unite": {
      "const": "milliards d'euros"
    },
    "annees": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^(19|20)[0-9]{2}$"
      },
      "uniqueItems": true
    },
    "impots": {
      "type": "object",
      "required": [
        "D211",
        "D51A_C1",
        "D61"
      ],
      "propertyNames": {
        "pattern": "^D[0-9A-Z_]+$"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "nom",
          "par_administration"
        ],
        "additionalProperties": false,
        "properties": {
          "nom": {
            "type": "string"
          },
          "par_administration": {
            "type": "object",
            "propertyNames": {
              "enum": [
                "Ensemble",
                "Etat",
                "Collectivites locales",
                "Securite sociale"
              ]
            },
            "required": [
              "Ensemble"
            ],
            "additionalProperties": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "pattern": "^(19|20)[0-9]{2}$"
              },
              "additionalProperties": {
                "type": "number"
              }
            }
          }
        }
      }
    }
  }
}
