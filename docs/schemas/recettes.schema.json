{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ou-vont-mes-impots.fr/contrat/v1/recettes.schema.json",
  "title": "site/data/recettes.json : chaque impot par administration beneficiaire",
  "allOf": [
    {
      "$ref": "commun.schema.json#/$defs/entete"
    }
  ],
  "type": "object",
  "properties": {
    "unite": {
      "type": "string"
    },
    "annees": {
      "type": "array",
      "items": {
        "$ref": "commun.schema.json#/$defs/annee"
      },
      "minItems": 1
    },
    "impots": {
      "type": "object",
      "properties": {},
      "required": [
        "D211",
        "D51A_C1",
        "D61"
      ],
      "propertyNames": {
        "pattern": "^D[0-9A-Z_]+$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "nom": {
            "type": "string"
          },
          "par_administration": {
            "type": "object",
            "properties": {},
            "propertyNames": {
              "enum": [
                "Ensemble",
                "Etat",
                "Collectivites locales",
                "Securite sociale"
              ]
            },
            "additionalProperties": {
              "type": "object",
              "propertyNames": {
                "$ref": "commun.schema.json#/$defs/annee"
              },
              "additionalProperties": {
                "type": [
                  "number",
                  "null"
                ]
              }
            }
          }
        },
        "required": [
          "nom",
          "par_administration"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "unite",
    "annees",
    "impots"
  ]
}
