{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ou-vont-mes-impots.fr/contrat/v1/marches_annees.schema.json",
  "title": "site/data/marches/annees.json : marchés retenus par année, par nature et par type, part nommée et part agrégée, lignes écartées de l'année (pipeline/marches.py)",
  "allOf": [
    {
      "$ref": "commun.schema.json#/$defs/entete"
    }
  ],
  "type": "object",
  "properties": {
    "millesime": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "unite": {
      "type": "string",
      "pattern": "^euros HT"
    },
    "collecte_le": {
      "type": "string",
      "format": "date"
    },
    "annees": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 2019,
        "maximum": 2100
      },
      "minItems": 1
    },
    "note": {
      "type": "string",
      "minLength": 1
    },
    "par_annee": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "annee": {
            "type": "integer",
            "minimum": 2019,
            "maximum": 2100
          },
          "marches": {
            "type": "integer",
            "minimum": 0
          },
          "lignes": {
            "type": "integer",
            "minimum": 0
          },
          "acheteurs": {
            "type": "integer",
            "minimum": 0
          },
          "total_eur": {
            "type": [
              "number",
              "null"
            ]
          },
          "nommes_eur": {
            "type": "number"
          },
          "agrege_confidentialite": {
            "type": "object",
            "properties": {
              "montant_eur": {
                "type": "number"
              },
              "part_pct": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "dont_personnes_physiques_eur": {
                "type": "number"
              },
              "dont_diffusion_partielle_eur": {
                "type": "number"
              },
              "dont_siren_introuvable_eur": {
                "type": "number"
              }
            },
            "required": [
              "montant_eur",
              "part_pct",
              "dont_personnes_physiques_eur",
              "dont_diffusion_partielle_eur",
              "dont_siren_introuvable_eur"
            ],
            "additionalProperties": false
          },
          "par_nature": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "nature": {
                  "enum": [
                    "Marché",
                    "Accord-cadre",
                    "Marché subséquent",
                    "Marché de partenariat",
                    "Marché de défense ou de sécurité",
                    "Non renseignée"
                  ]
                },
                "marches": {
                  "type": "integer",
                  "minimum": 0
                },
                "montant_eur": {
                  "type": "number"
                }
              },
              "required": [
                "nature",
                "marches",
                "montant_eur"
              ],
              "additionalProperties": false
            }
          },
          "par_type": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "enum": [
                    "Travaux",
                    "Services",
                    "Fournitures",
                    "Non catégorisé"
                  ]
                },
                "marches": {
                  "type": "integer",
                  "minimum": 0
                },
                "montant_eur": {
                  "type": "number"
                }
              },
              "required": [
                "type",
                "marches",
                "montant_eur"
              ],
              "additionalProperties": false
            }
          },
          "ecartes": {
            "type": "object",
            "properties": {
              "montant_non_renseigne": {
                "type": "object",
                "properties": {
                  "lignes": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "montant_eur": {
                    "type": [
                      "number",
                      "null"
                    ]
                  }
                },
                "required": [
                  "lignes",
                  "montant_eur"
                ],
                "additionalProperties": false
              },
              "montant_aberrant": {
                "type": "object",
                "properties": {
                  "lignes": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "montant_eur": {
                    "type": [
                      "number",
                      "null"
                    ]
                  }
                },
                "required": [
                  "lignes",
                  "montant_eur"
                ],
                "additionalProperties": false
              },
              "montant_suspect": {
                "type": "object",
                "properties": {
                  "lignes": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "montant_eur": {
                    "type": [
                      "number",
                      "null"
                    ]
                  }
                },
                "required": [
                  "lignes",
                  "montant_eur"
                ],
                "additionalProperties": false
              },
              "montant_negatif": {
                "type": "object",
                "properties": {
                  "lignes": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "montant_eur": {
                    "type": [
                      "number",
                      "null"
                    ]
                  }
                },
                "required": [
                  "lignes",
                  "montant_eur"
                ],
                "additionalProperties": false
              },
              "siret_titulaire_invalide": {
                "type": "object",
                "properties": {
                  "lignes": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "montant_eur": {
                    "type": [
                      "number",
                      "null"
                    ]
                  }
                },
                "required": [
                  "lignes",
                  "montant_eur"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "montant_non_renseigne",
              "montant_aberrant",
              "montant_suspect",
              "montant_negatif",
              "siret_titulaire_invalide"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "annee",
          "marches",
          "lignes",
          "acheteurs",
          "total_eur"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "millesime",
    "source",
    "unite",
    "collecte_le",
    "annees",
    "note",
    "par_annee"
  ],
  "additionalProperties": false
}
