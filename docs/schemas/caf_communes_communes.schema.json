{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://ou-vont-mes-impots.fr/contrat/v1/caf_communes_communes.schema.json",
 "title": "site/data/caf_communes/communes/<dep>.json : foyers allocataires et montant de décembre par prestation, communes (arrondissements à Paris, Lyon, Marseille), quartiers, intercommunalités (CNAF ; pipeline/caf_communes.py)",
 "allOf": [
  {
   "$ref": "commun.schema.json#/$defs/entete"
  }
 ],
 "type": "object",
 "required": [
  "departement",
  "colonnes",
  "communes",
  "epci"
 ],
 "properties": {
  "departement": {
   "type": "string",
   "pattern": "^(\\d{2}|2[AB]|97\\d)$"
  },
  "communes": {
   "type": "object",
   "propertyNames": {
    "pattern": "^(\\d{5}|2[AB]\\d{3})$"
   },
   "additionalProperties": {
    "type": "object",
    "required": [
     "annees"
    ],
    "properties": {
     "annees": {
      "type": "object",
      "propertyNames": {
       "pattern": "^\\d{4}$"
      },
      "additionalProperties": {
       "type": "array",
       "items": {
        "type": [
         "integer",
         "null"
        ]
       },
       "minItems": 14,
       "maxItems": 14
      }
     },
     "iris": {
      "type": "array",
      "items": {
       "type": "array",
       "minItems": 4,
       "maxItems": 4,
       "prefixItems": [
        {
         "type": "string"
        },
        {
         "type": [
          "string",
          "null"
         ]
        },
        {
         "type": "string",
         "pattern": "^\\d{4}$"
        },
        {
         "type": "array",
         "items": {
          "type": [
           "integer",
           "null"
          ]
         },
         "minItems": 14,
         "maxItems": 14
        }
       ]
      }
     },
     "qpv": {
      "type": "array",
      "items": {
       "type": "array",
       "minItems": 4,
       "maxItems": 4,
       "prefixItems": [
        {
         "type": "string"
        },
        {
         "type": [
          "string",
          "null"
         ]
        },
        {
         "type": "string",
         "pattern": "^\\d{4}$"
        },
        {
         "type": "array",
         "items": {
          "type": [
           "integer",
           "null"
          ]
         },
         "minItems": 14,
         "maxItems": 14
        }
       ]
      }
     },
     "arrondissements": {
      "type": "object",
      "propertyNames": {
       "pattern": "^(\\d{5}|2[AB]\\d{3})$"
      },
      "additionalProperties": {
       "type": "object",
       "propertyNames": {
        "pattern": "^\\d{4}$"
       },
       "additionalProperties": {
        "type": "array",
        "items": {
         "type": [
          "integer",
          "null"
         ]
        },
        "minItems": 14,
        "maxItems": 14
       }
      }
     }
    },
    "additionalProperties": false
   }
  },
  "epci": {
   "type": "object",
   "propertyNames": {
    "pattern": "^\\d{9}$"
   },
   "additionalProperties": {
    "type": "object",
    "required": [
     "annees",
     "aah_aeeh"
    ],
    "properties": {
     "annees": {
      "type": "object",
      "propertyNames": {
       "pattern": "^\\d{4}$"
      },
      "additionalProperties": {
       "type": "array",
       "items": {
        "type": [
         "integer",
         "null"
        ]
       },
       "minItems": 14,
       "maxItems": 14
      }
     },
     "aah_aeeh": {
      "type": "object",
      "propertyNames": {
       "pattern": "^\\d{4}$"
      },
      "additionalProperties": {
       "type": "array",
       "items": {
        "type": [
         "integer",
         "null"
        ]
       },
       "minItems": 2,
       "maxItems": 2
      }
     }
    },
    "additionalProperties": false
   }
  }
 }
}
