{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ou-vont-mes-impots.fr/contrat/v1/nature_etat.schema.json",
  "title": "site/data/nature_etat.json : budget de l'Etat par titre et categorie LOLF",
  "allOf": [
    {
      "$ref": "commun.schema.json#/$defs/entete"
    }
  ],
  "type": "object",
  "properties": {
    "unite": {
      "$ref": "commun.schema.json#/$defs/unite_md_cp"
    },
    "libelle": {
      "type": "string"
    },
    "avertissement": {
      "type": "string"
    },
    "titres": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "titre": {
            "enum": [
              "1",
              "2",
              "3",
              "4",
              "5",
              "6",
              "7"
            ]
          },
          "nom": {
            "type": "string"
          },
          "md": {
            "type": "number"
          },
          "categories": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string",
                  "pattern": "^[0-9]{2}$"
                },
                "nom": {
                  "type": "string"
                },
                "md": {
                  "type": "number"
                }
              },
              "required": [
                "code",
                "nom",
                "md"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "titre",
          "nom",
          "md",
          "categories"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "unite",
    "titres"
  ]
}
