{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://ou-vont-mes-impots.fr/contrat/v1/aides_entreprises_index.schema.json",
 "title": "site/data/aides_entreprises/index.json : dispositifs, montants côte à côte par année, secteur et région, écarts entre sources",
 "description": "Axe « aides aux entreprises » (pipeline/aides_entreprises.py, contrat docs/contrat_interface.md). Registre européen de transparence (TAM), France 2030, France Relance, PGE : un montant par source, jamais additionnés.",
 "allOf": [
  {
   "$ref": "commun.schema.json#/$defs/entete"
  }
 ],
 "type": "object",
 "required": [
  "millesime",
  "source",
  "unite",
  "avertissement",
  "dispositifs",
  "par_annee",
  "par_secteur",
  "par_region",
  "ecarts",
  "liens",
  "confidentialite",
  "limites",
  "sources",
  "sources_inaccessibles",
  "recherche_publique",
  "fichiers",
  "export_officiel_tam",
  "comparaison_lectures_tam"
 ],
 "propertyNames": {
  "not": {
   "pattern": "(?i)pr[eé]nom"
  }
 },
 "properties": {
  "millesime": {
   "type": "string",
   "minLength": 3
  },
  "source": {
   "type": "string",
   "minLength": 3
  },
  "unite": {
   "type": "string",
   "minLength": 3
  },
  "avertissement": {
   "type": "string",
   "minLength": 40
  },
  "dispositifs": {
   "type": "array",
   "minItems": 4,
   "items": {
    "type": "object",
    "required": [
     "id",
     "nom",
     "notion",
     "fichier",
     "annees",
     "par_annee_eur",
     "total_eur"
    ],
    "properties": {
     "id": {
      "enum": [
       "tam",
       "france2030",
       "france_relance_industrie",
       "france_relance_industrie_du_futur",
       "france_relance_cheque_france_num",
       "pge"
      ]
     },
     "nom": {
      "type": "string",
      "minLength": 3
     },
     "notion": {
      "type": "string",
      "minLength": 3
     },
     "fichier": {
      "type": "string",
      "pattern": "^aides_entreprises/[a-z0-9_]+\\.json$"
     },
     "annees": {
      "type": [
       "array",
       "null"
      ],
      "items": {
       "$ref": "commun.schema.json#/$defs/annee_entier"
      }
     },
     "par_annee_eur": {
      "type": [
       "object",
       "null"
      ],
      "propertyNames": {
       "pattern": "^[0-9]{4}$|^non renseignée$"
      },
      "additionalProperties": {
       "type": [
        "number",
        "null"
       ]
      }
     },
     "total_eur": {
      "type": [
       "number",
       "null"
      ]
     },
     "aides": {
      "type": "integer",
      "minimum": 0
     },
     "projets": {
      "type": "integer",
      "minimum": 0
     },
     "beneficiaires": {
      "type": "integer",
      "minimum": 0
     },
     "prets": {
      "type": "integer",
      "minimum": 0
     },
     "note": {
      "type": "string",
      "minLength": 3
     }
    }
   }
  },
  "par_annee": {
   "type": "object",
   "required": [
    "regle",
    "annees"
   ],
   "properties": {
    "regle": {
     "type": "string",
     "minLength": 3
    },
    "annees": {
     "type": "object",
     "propertyNames": {
      "pattern": "^[0-9]{4}$"
     },
     "additionalProperties": {
      "type": "object",
      "additionalProperties": {
       "type": [
        "number",
        "null"
       ]
      }
     }
    }
   }
  },
  "par_secteur": {
   "type": "object",
   "required": [
    "regle",
    "sections"
   ],
   "properties": {
    "regle": {
     "type": "string",
     "minLength": 3
    },
    "sections": {
     "type": "object",
     "propertyNames": {
      "pattern": "^[A-U]$"
     },
     "additionalProperties": {
      "type": "object",
      "required": [
       "libelle"
      ],
      "properties": {
       "libelle": {
        "type": "string",
        "minLength": 3
       }
      },
      "additionalProperties": {
       "type": [
        "number",
        "null"
       ]
      }
     }
    }
   }
  },
  "par_region": {
   "type": "object",
   "required": [
    "regle",
    "regions"
   ],
   "properties": {
    "regle": {
     "type": "string",
     "minLength": 3
    },
    "regions": {
     "type": "object",
     "propertyNames": {
      "pattern": "^(0[1-6]|[1-9][0-9])$"
     },
     "additionalProperties": {
      "type": "object",
      "required": [
       "nom"
      ],
      "properties": {
       "nom": {
        "type": "string",
        "minLength": 3
       }
      },
      "additionalProperties": {
       "type": [
        "number",
        "null"
       ]
      }
     }
    }
   }
  },
  "ecarts": {
   "type": "array",
   "minItems": 1,
   "items": {
    "$ref": "aides_entreprises_index.schema.json#/$defs/ecart"
   }
  },
  "liens": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "fichier",
     "objet"
    ],
    "properties": {
     "fichier": {
      "type": "string",
      "pattern": "^[a-z0-9_]+/[a-z0-9_/]+\\.json$"
     },
     "objet": {
      "type": "string",
      "minLength": 3
     }
    }
   }
  },
  "confidentialite": {
   "type": "object",
   "required": [
    "regle",
    "tam",
    "france_relance"
   ],
   "properties": {
    "regle": {
     "type": "string",
     "minLength": 40
    }
   }
  },
  "limites": {
   "type": "array",
   "minItems": 3,
   "items": {
    "type": "string",
    "minLength": 20
   }
  },
  "sources": {
   "type": "array",
   "minItems": 5,
   "items": {
    "type": "object",
    "required": [
     "id",
     "titre",
     "producteur",
     "url",
     "licence"
    ],
    "properties": {
     "url": {
      "type": "string",
      "pattern": "^https://"
     }
    }
   }
  },
  "sources_inaccessibles": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "source",
     "constat",
     "effet"
    ]
   }
  },
  "recherche_publique": {
   "type": "object",
   "required": [
    "date",
    "conclusion",
    "trouvailles"
   ],
   "properties": {
    "trouvailles": {
     "type": "array",
     "minItems": 5,
     "items": {
      "type": "object",
      "required": [
       "nom",
       "url",
       "verdict",
       "licence",
       "mise_a_jour"
      ]
     }
    }
   }
  },
  "fichiers": {
   "type": "array",
   "items": {
    "type": "string",
    "pattern": "^aides_entreprises/[a-z0-9_]+\\.json$"
   }
  },
  "export_officiel_tam": {
   "type": "object",
   "required": [
    "date_export",
    "fichiers",
    "renouvellement"
   ],
   "properties": {
    "date_export": {
     "type": "string",
     "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "fichiers": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "object",
      "required": [
       "fichier",
       "date_export",
       "octroi_du",
       "octroi_au",
       "lignes",
       "retenues"
      ]
     }
    }
   }
  },
  "comparaison_lectures_tam": {
   "$ref": "#/$defs/comparaison_lectures"
  }
 },
 "$defs": {
  "agregat_tam": {
   "allOf": [
    {
     "$ref": "#/$defs/agregat_tam_champs"
    }
   ],
   "unevaluatedProperties": false
  },
  "agregat_tam_champs": {
   "type": "object",
   "required": [
    "aides",
    "element_aide_eur",
    "aides_avec_montant"
   ],
   "properties": {
    "aides": {
     "type": "integer",
     "minimum": 0
    },
    "element_aide_eur": {
     "type": "number"
    },
    "aides_avec_montant": {
     "type": "integer",
     "minimum": 0
    },
    "fourchettes": {
     "type": "object",
     "required": [
      "aides",
      "borne_basse_eur",
      "borne_haute_eur"
     ],
     "additionalProperties": false,
     "properties": {
      "aides": {
       "type": "integer",
       "minimum": 0
      },
      "borne_basse_eur": {
       "type": "number"
      },
      "borne_haute_eur": {
       "type": [
        "number",
        "null"
       ]
      }
     }
    },
    "aides_sans_montant": {
     "type": "integer",
     "minimum": 0
    },
    "montant_nominal_eur": {
     "type": "number"
    },
    "aides_avec_montant_nominal": {
     "type": "integer",
     "minimum": 0
    }
   }
  },
  "somme_projets": {
   "type": "object",
   "required": [
    "montant_eur",
    "projets",
    "beneficiaires"
   ],
   "properties": {
    "montant_eur": {
     "type": "number"
    },
    "projets": {
     "type": "integer",
     "minimum": 0
    },
    "beneficiaires": {
     "type": "integer",
     "minimum": 0
    }
   }
  },
  "ecart": {
   "type": "object",
   "required": [
    "objet",
    "source",
    "montant_eur",
    "autre_source",
    "autre_montant_eur",
    "ecart_eur",
    "ecart_pct",
    "lecture_ecart"
   ],
   "additionalProperties": false,
   "properties": {
    "objet": {
     "type": "string",
     "minLength": 3
    },
    "source": {
     "type": "string",
     "minLength": 3
    },
    "montant_eur": {
     "type": [
      "number",
      "null"
     ]
    },
    "autre_source": {
     "type": "string",
     "minLength": 3
    },
    "autre_montant_eur": {
     "type": [
      "number",
      "null"
     ]
    },
    "ecart_eur": {
     "type": [
      "number",
      "null"
     ]
    },
    "ecart_pct": {
     "type": [
      "number",
      "null"
     ]
    },
    "lecture_ecart": {
     "type": "string",
     "minLength": 10
    },
    "autre_url": {
     "type": "string",
     "pattern": "^https://"
    },
    "citation": {
     "type": "string",
     "minLength": 3
    },
    "autre_fichier": {
     "type": "string",
     "pattern": "^[a-z0-9_]+/[a-z0-9_/]+\\.json$"
    },
    "autre_id": {
     "type": "string"
    }
   }
  },
  "ordre": {
   "type": "object",
   "required": [
    "regle",
    "cles"
   ],
   "properties": {
    "regle": {
     "type": "string",
     "minLength": 3
    },
    "cles": {
     "type": "array",
     "items": {
      "type": "string"
     },
     "minItems": 1
    }
   }
  },
  "pge_valeur": {
   "type": "object",
   "required": [
    "prets",
    "montant_eur"
   ],
   "additionalProperties": false,
   "properties": {
    "prets": {
     "type": "integer"
    },
    "montant_eur": {
     "type": "number"
    }
   }
  },
  "pge_series": {
   "type": "object",
   "required": [
    "situations"
   ],
   "properties": {
    "situations": {
     "type": "object",
     "minProperties": 1,
     "propertyNames": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
     },
     "additionalProperties": {
      "$ref": "aides_entreprises_index.schema.json#/$defs/pge_valeur"
     }
    },
    "par_annee": {
     "type": "object",
     "propertyNames": {
      "pattern": "^20[0-9]{2}$"
     },
     "additionalProperties": {
      "$ref": "aides_entreprises_index.schema.json#/$defs/pge_valeur"
     }
    }
   }
  },
  "comparaison_lectures": {
   "type": "object",
   "required": [
    "objet",
    "pages_publiques",
    "export_officiel",
    "total",
    "par_annee",
    "references",
    "statut",
    "methode",
    "lecture"
   ],
   "properties": {
    "statut": {
     "const": "calculé par le site"
    },
    "methode": {
     "type": "string",
     "minLength": 40
    },
    "lecture": {
     "type": "string",
     "minLength": 40
    },
    "total": {
     "type": "object",
     "required": [
      "pages_publiques",
      "export_officiel",
      "ecart_aides",
      "ecart_element_aide_eur"
     ]
    },
    "par_annee": {
     "type": "object",
     "propertyNames": {
      "pattern": "^[0-9]{4}$"
     },
     "additionalProperties": {
      "type": "object",
      "required": [
       "pages_publiques",
       "export_officiel",
       "ecart_aides",
       "ecart_element_aide_eur"
      ],
      "properties": {
       "pages_publiques": {
        "type": [
         "object",
         "null"
        ],
        "required": [
         "aides",
         "element_aide_eur",
         "aides_avec_montant",
         "fourchettes",
         "aides_sans_montant"
        ],
        "properties": {
         "aides": {
          "type": "integer",
          "minimum": 0
         },
         "element_aide_eur": {
          "type": [
           "number",
           "null"
          ]
         }
        }
       },
       "export_officiel": {
        "type": [
         "object",
         "null"
        ],
        "required": [
         "aides",
         "element_aide_eur",
         "aides_avec_montant",
         "fourchettes",
         "aides_sans_montant"
        ],
        "properties": {
         "aides": {
          "type": "integer",
          "minimum": 0
         },
         "element_aide_eur": {
          "type": [
           "number",
           "null"
          ]
         }
        }
       },
       "ecart_aides": {
        "type": [
         "integer",
         "null"
        ]
       },
       "ecart_element_aide_eur": {
        "type": [
         "number",
         "null"
        ]
       }
      }
     }
    },
    "references": {
     "type": "object",
     "required": [
      "aides_pages",
      "aides_export",
      "communes",
      "seulement_dans_l_export",
      "seulement_dans_les_pages"
     ]
    }
   }
  }
 }
}
