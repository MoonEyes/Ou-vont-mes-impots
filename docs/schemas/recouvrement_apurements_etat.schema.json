{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://ou-vont-mes-impots.fr/contrat/v1/recouvrement_apurements_etat.schema.json",
 "title": "site/data/recouvrement/apurements_etat.json : admissions en non-valeur et décisions gracieuses dans les comptes de l'État",
 "description": "Axe « recouvrement » (pipeline/recouvrement.py). Trois notions séparées : montant notifié, montant encaissé, estimation. Aucun total entre sphère fiscale et sphère sociale.",
 "allOf": [
  {
   "$ref": "commun.schema.json#/$defs/entete"
  }
 ],
 "type": "object",
 "properties": {
  "millesime": {
   "type": "string"
  },
  "source": {
   "type": "string"
  },
  "unite": {
   "type": "string",
   "minLength": 3
  },
  "avertissement": {
   "type": "string",
   "minLength": 20
  },
  "collecte_le": {
   "type": "string",
   "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
  },
  "sphere": {
   "const": "fiscale"
  },
  "producteur": {
   "type": "string",
   "minLength": 3
  },
  "perimetre": {
   "type": "string",
   "minLength": 20
  },
  "methode": {
   "type": "string",
   "minLength": 20
  },
  "notion": {
   "const": "apurement"
  },
  "definitions": {
   "type": "object",
   "required": [
    "admission_en_non_valeur",
    "decision_gracieuse"
   ]
  },
  "annees": {
   "type": "array",
   "minItems": 5,
   "items": {
    "type": "integer",
    "minimum": 1990,
    "maximum": 2100
   }
  },
  "comptes": {
   "type": "array",
   "minItems": 5,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "compte",
     "libelle_source",
     "categorie",
     "champ",
     "montants_eur"
    ],
    "properties": {
     "compte": {
      "type": "string",
      "pattern": "^6[0-9]{9}$"
     },
     "libelle_source": {
      "type": "string",
      "minLength": 5
     },
     "categorie": {
      "enum": [
       "admission_en_non_valeur",
       "decision_gracieuse"
      ]
     },
     "champ": {
      "type": "string"
     },
     "montants_eur": {
      "type": "array",
      "minItems": 1,
      "items": {
       "type": [
        "number",
        "null"
       ]
      }
     }
    }
   }
  }
 },
 "required": [
  "millesime",
  "source",
  "unite",
  "avertissement",
  "collecte_le",
  "sphere",
  "producteur",
  "perimetre",
  "methode",
  "notion",
  "definitions",
  "annees",
  "comptes"
 ],
 "additionalProperties": false
}
