{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://ou-vont-mes-impots.fr/contrat/v1/ma_commune_index.schema.json",
 "title": "site/data/ma_commune/index.json : couverture de la correspondance code postal -> commune, normalisation des noms, fichiers, arrondissements de Paris, Lyon et Marseille, hors périmètre, recherche préalable (pipeline/ma_commune.py)",
 "allOf": [
  {
   "$ref": "commun.schema.json#/$defs/entete"
  }
 ],
 "type": "object",
 "required": [
  "millesime",
  "source",
  "url",
  "licence",
  "date_sources",
  "normalisation",
  "fichiers",
  "prefixes_cp",
  "cles_noms",
  "regle_cles",
  "couverture",
  "arrondissements",
  "hors_perimetre",
  "regles",
  "limites",
  "recherche_publique",
  "ordre"
 ],
 "properties": {
  "date_sources": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
  },
  "licence": {
   "const": "Licence Ouverte 2.0"
  },
  "version_source": {
   "type": [
    "string",
    "null"
   ]
  },
  "prefixes_cp": {
   "type": "array",
   "items": {
    "type": "string",
    "pattern": "^\\d{2}$"
   },
   "minItems": 90
  },
  "cles_noms": {
   "type": "array",
   "items": {
    "type": "string",
    "pattern": "^[a-z0-9]+$"
   },
   "minItems": 20
  },
  "couverture": {
   "type": "object",
   "required": [
    "communes_cog",
    "communes_avec_code_postal",
    "communes_sans_code_postal",
    "codes_postaux",
    "codes_postaux_partages",
    "communes_max_par_code_postal",
    "communes_plusieurs_codes_postaux",
    "localites",
    "arrondissements",
    "lignes_source"
   ],
   "properties": {
    "communes_cog": {
     "type": "integer",
     "minimum": 0
    },
    "communes_avec_code_postal": {
     "type": "integer",
     "minimum": 0
    },
    "codes_postaux": {
     "type": "integer",
     "minimum": 0
    },
    "codes_postaux_partages": {
     "type": "integer",
     "minimum": 0
    },
    "communes_max_par_code_postal": {
     "type": "integer",
     "minimum": 0
    },
    "communes_plusieurs_codes_postaux": {
     "type": "integer",
     "minimum": 0
    },
    "localites": {
     "type": "integer",
     "minimum": 0
    },
    "arrondissements": {
     "type": "integer",
     "minimum": 0
    },
    "lignes_source": {
     "type": "integer",
     "minimum": 0
    },
    "communes_sans_code_postal": {
     "type": "array",
     "items": {
      "type": "string",
      "pattern": "^(\\d{5}|2[AB]\\d{3})$"
     }
    }
   }
  },
  "arrondissements": {
   "type": "object",
   "propertyNames": {
    "type": "string",
    "pattern": "^(\\d{5}|2[AB]\\d{3})$"
   },
   "additionalProperties": {
    "type": "object",
    "required": [
     "nom",
     "arrondissements",
     "note"
    ]
   }
  },
  "hors_perimetre": {
   "type": "object",
   "required": [
    "motif",
    "territoires",
    "codes_postaux"
   ]
  },
  "regles": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "limites": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "recherche_publique": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "trouvaille",
     "verdict",
     "licence",
     "date"
    ],
    "properties": {
     "verdict": {
      "enum": [
       "réutilisable tel quel",
       "à adapter",
       "inspiration seulement"
      ]
     }
    }
   }
  }
 }
}
