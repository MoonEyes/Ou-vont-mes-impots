{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ou-vont-mes-impots.fr/contrat/v1/entites_index.schema.json",
  "title": "site/data/entites/index.json : méthode, canaux, notions de montant, comptes et découpage des organisations reliées (pipeline/entites.py)",
  "allOf": [{"$ref": "commun.schema.json#/$defs/entete"}],
  "type": "object",
  "$defs": {
    "notion": {"type": "object",
      "properties": {
        "libelle": {"type": "string", "minLength": 3},
        "sens": {"enum": ["recoit", "verse", "mention"]},
        "somme_canal": {"type": "boolean"},
        "cumulable_entre_canaux": {"type": ["string", "null"]}},
      "required": ["libelle", "sens", "somme_canal", "cumulable_entre_canaux"], "additionalProperties": false},
    "canal": {"type": "object",
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
        "titre": {"type": "string", "minLength": 3},
        "chemins_source": {"type": "string"},
        "axe": {"type": "string"},
        "page": {"type": ["string", "null"], "pattern": "^/"},
        "organisations": {"type": "integer", "minimum": 0},
        "organisations_avec_fiche": {"type": "integer", "minimum": 0},
        "lignes": {"type": "integer", "minimum": 0},
        "notions": {"type": "array", "items": {"type": "string"}}},
      "required": ["id", "titre", "chemins_source", "axe", "page", "organisations", "organisations_avec_fiche", "lignes", "notions"], "additionalProperties": false}
  },
  "properties": {
    "unite": {"type": "string"},
    "avertissement": {"type": "string"},
    "methode": {"type": "object",
      "properties": {
        "etapes": {"type": "array", "items": {"type": "string"}, "minItems": 3},
        "splink": {"type": "object",
          "properties": {
            "probabilite_a_priori": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
            "blocage": {"type": "string"},
            "niveaux": {"type": "array", "items": {"type": "object",
              "properties": {"niveau": {"type": "string"}, "m": {"type": "number"}, "u": {"type": "number"}},
              "required": ["niveau", "m", "u"], "additionalProperties": false}},
            "seuil_probable": {"type": "number"}, "seuil_incertain": {"type": "number"},
            "version": {"type": "string"}},
          "required": ["probabilite_a_priori", "blocage", "niveaux", "seuil_probable", "seuil_incertain"]},
        "modele": {"type": "string"}},
      "required": ["etapes", "splink", "modele"]},
    "regle_personnes": {"type": "string", "minLength": 20},
    "notions": {"type": "object", "additionalProperties": {"$ref": "#/$defs/notion"}},
    "canaux": {"type": "array", "items": {"$ref": "#/$defs/canal"}, "minItems": 1},
    "non_relus": {"type": "array", "items": {"type": "object",
      "properties": {"chemins_source": {"type": "string"}, "raison": {"type": "string"}},
      "required": ["chemins_source", "raison"], "additionalProperties": false}},
    "fichiers_absents": {"type": "array", "items": {"type": "string"}},
    "comptes": {"type": "object",
      "properties": {
        "organisations_reliees_par_siren": {"type": "integer", "minimum": 0},
        "organisations_avec_fiche": {"type": "integer", "minimum": 0},
        "regle_fiche": {"type": "string"},
        "par_nombre_de_canaux": {"type": "object", "additionalProperties": {"type": "integer"}},
        "apparitions": {"type": "integer"},
        "sirens_lus": {"type": "integer"},
        "referentiel_sirene": {"type": "object"},
        "exclusions": {"type": "object", "additionalProperties": {"type": "integer"}},
        "lignes_sans_siren": {"type": "object",
          "properties": {"total": {"type": "integer"}, "par_canal": {"type": "object"},
            "decisions": {"type": "object", "propertyNames": {"enum": ["probable", "incertain", "different", "non_rapprochable"]},
              "additionalProperties": {"type": "integer"}}},
          "required": ["total", "par_canal", "decisions"]},
        "autres": {"type": "object"}},
      "required": ["organisations_reliees_par_siren", "organisations_avec_fiche", "par_nombre_de_canaux", "exclusions", "lignes_sans_siren"]},
    "fichiers": {"type": "object",
      "properties": {
        "fiches": {"type": "object", "propertyNames": {"pattern": "^[0-9]{1,9}$"},
          "additionalProperties": {"type": "string", "pattern": "^entites/fiches/[0-9]{1,9}\\.json$"}},
        "recherche": {"type": "object", "propertyNames": {"pattern": "^[a-z0-9]+_?$"},
          "additionalProperties": {"type": "string", "pattern": "^entites/recherche/[a-z0-9]+_?\\.json$"}},
        "mots_frequents": {"type": "array", "items": {"type": "object",
          "properties": {"mot": {"type": "string"}, "organisations": {"type": "integer"}}, "required": ["mot", "organisations"]}},
        "recherche_entrees": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1}},
        "recherche_globale": {"type": "string"},
        "regle_fiches": {"type": "string"}, "regle_recherche": {"type": "string"}},
      "required": ["fiches", "recherche", "mots_frequents", "recherche_entrees", "recherche_globale"]},
    "colonnes_valeurs": {"const": ["annee_ou_periode", "montant_eur"]},
    "ordre": {"type": "object", "properties": {"regle": {"type": "string"}, "cles": {"type": "array"}}, "required": ["regle", "cles"]},
    "limites": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "recherche_publique": {"type": "object",
      "properties": {"date": {"type": "string"}, "trouvailles": {"type": "array", "items": {"type": "object",
        "properties": {"nom": {"type": "string"}, "url": {"type": "string"}, "licence": {"type": "string"},
          "verdict": {"enum": ["réutilisable tel quel", "à adapter", "inspiration seulement"]}},
        "required": ["nom", "url", "licence", "verdict"]}, "minItems": 1}},
      "required": ["date", "trouvailles"]}
  },
  "required": ["unite", "avertissement", "methode", "regle_personnes", "notions", "canaux", "comptes", "fichiers", "colonnes_valeurs", "ordre", "limites", "recherche_publique"]
}
