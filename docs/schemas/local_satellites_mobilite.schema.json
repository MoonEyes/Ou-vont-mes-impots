{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ou-vont-mes-impots.fr/contrat/v1/local_satellites_mobilite.schema.json",
  "title": "site/data/local_satellites/mobilite/<dep>.json : AOM et taux de versement mobilité par commune, base sous ODbL (pipeline/local_satellites.py)",
  "allOf": [
    {
      "$ref": "commun.schema.json#/$defs/entete"
    }
  ],
  "type": "object",
  "properties": {
    "licence": {
      "const": "ODbL 1.0"
    },
    "licence_url": {
      "const": "https://opendatacommons.org/licenses/odbl/1-0/"
    },
    "mention": {
      "type": "string",
      "pattern": "Urssaf.*Cerema"
    },
    "partage_a_l_identique": {
      "type": "string",
      "pattern": "ODbL"
    },
    "departement": {
      "type": "object",
      "required": [
        "code",
        "nom"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "nom": {
          "type": "string"
        }
      }
    },
    "date_reference": {
      "const": "2026-01-01"
    },
    "annees": {
      "const": [
        2018,
        2019,
        2020,
        2021,
        2022,
        2023,
        2024,
        2025
      ]
    },
    "unite_taux": {
      "type": "string"
    },
    "colonnes": {
      "const": [
        "aom",
        "taux_vm",
        "taux_vma",
        "taux_vmr",
        "date_debut",
        "syndicat_sru",
        "periode_suivante"
      ]
    },
    "colonnes_periode_suivante": {
      "const": [
        "date_debut",
        "taux_vm",
        "taux_vma",
        "taux_vmr"
      ]
    },
    "syndicats_sru": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "aom": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[0-9]{9}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "nom",
          "forme",
          "population",
          "communes",
          "comptes",
          "versement_mobilite_eur"
        ],
        "properties": {
          "nom": {
            "type": [
              "string",
              "null"
            ]
          },
          "forme": {
            "type": [
              "string",
              "null"
            ]
          },
          "population": {
            "type": [
              "integer",
              "null"
            ]
          },
          "communes": {
            "type": [
              "integer",
              "null"
            ]
          },
          "vm_taux_max_cerema": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 10
          },
          "comptes": {
            "type": [
              "object",
              "null"
            ],
            "required": [
              "vue",
              "fichier"
            ],
            "additionalProperties": false,
            "description": "où lire le budget de l'organisme déjà publié (lien, aucun montant recopié) ; null = comptes non publiés",
            "properties": {
              "vue": {
                "enum": [
                  "local_budget_epci",
                  "local_budget_region",
                  "local_budget_commune",
                  "local_satellites_syndicats"
                ]
              },
              "fichier": {
                "type": "string",
                "pattern": "\\.json$"
              }
            }
          },
          "versement_mobilite_eur": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "array",
                "minItems": 8,
                "maxItems": 8,
                "items": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "description": "euros par exercice, aligné sur `annees` ; null = non publié par l'OFGL cet exercice, jamais 0"
              }
            ]
          }
        }
      }
    },
    "communes": {
      "type": "object",
      "propertyNames": {
        "pattern": "^([0-9]{2}|2[AB])[0-9]{3}$"
      },
      "additionalProperties": {
        "type": "array",
        "minItems": 7,
        "maxItems": 7,
        "prefixItems": [
          {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9]{9}$"
          },
          {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 10
          },
          {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 10
          },
          {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 10
          },
          {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9]{8}$"
          },
          {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "array",
                "minItems": 4,
                "maxItems": 4,
                "prefixItems": [
                  {
                    "type": "string",
                    "pattern": "^[0-9]{8}$"
                  },
                  {
                    "type": [
                      "number",
                      "null"
                    ],
                    "minimum": 0,
                    "maximum": 10
                  },
                  {
                    "type": [
                      "number",
                      "null"
                    ],
                    "minimum": 0,
                    "maximum": 10
                  },
                  {
                    "type": [
                      "number",
                      "null"
                    ],
                    "minimum": 0,
                    "maximum": 10
                  }
                ]
              }
            ]
          }
        ]
      }
    }
  },
  "required": [
    "millesime",
    "source",
    "licence",
    "licence_url",
    "mention",
    "partage_a_l_identique",
    "departement",
    "date_reference",
    "colonnes",
    "syndicats_sru",
    "aom",
    "communes"
  ]
}
