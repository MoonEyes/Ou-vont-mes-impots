{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ou-vont-mes-impots.fr/contrat/v1/formation_cpf_mois.schema.json",
  "title": "site/data/formation/cpf_mois.json : CPF, dossiers et montants engagés par mois de validation, par financeur et par statut",
  "allOf": [
    {
      "$ref": "commun.schema.json#/$defs/entete"
    }
  ],
  "type": "object",
  "properties": {
    "millesime": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "pattern": "Caisse des dépôts"
    },
    "unite": {
      "type": "string"
    },
    "collecte_le": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "avertissement": {
      "type": "string",
      "minLength": 40
    },
    "statuts": {
      "type": "object",
      "required": [
        "realise",
        "realise_partiellement",
        "en_cours",
        "annule"
      ]
    },
    "retenus": {
      "type": "array",
      "items": {
        "enum": [
          "realise",
          "realise_partiellement",
          "en_cours",
          "annule"
        ]
      }
    },
    "mois": {
      "type": "object",
      "minProperties": 60,
      "propertyNames": {
        "pattern": "^20[0-9]{2}-(0[1-9]|1[0-2])$"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "dossiers",
          "montant_eur",
          "financeurs_eur",
          "par_statut"
        ],
        "properties": {
          "dossiers": {
            "type": "integer",
            "minimum": 0
          },
          "montant_eur": {
            "type": "integer",
            "minimum": 0
          },
          "financeurs_eur": {
            "type": "object",
            "required": [
              "france_competences",
              "titulaire",
              "etat",
              "france_travail",
              "regions",
              "opco",
              "entreprises",
              "cec"
            ],
            "additionalProperties": false,
            "properties": {
              "france_competences": {
                "type": "integer",
                "minimum": 0
              },
              "titulaire": {
                "type": "integer",
                "minimum": 0
              },
              "etat": {
                "type": "integer",
                "minimum": 0
              },
              "france_travail": {
                "type": "integer",
                "minimum": 0
              },
              "regions": {
                "type": "integer",
                "minimum": 0
              },
              "opco": {
                "type": "integer",
                "minimum": 0
              },
              "entreprises": {
                "type": "integer",
                "minimum": 0
              },
              "cec": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "par_statut": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "realise": {
                "type": "object",
                "required": [
                  "dossiers",
                  "montant_eur"
                ],
                "properties": {
                  "dossiers": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "montant_eur": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              },
              "realise_partiellement": {
                "type": "object",
                "required": [
                  "dossiers",
                  "montant_eur"
                ],
                "properties": {
                  "dossiers": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "montant_eur": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              },
              "en_cours": {
                "type": "object",
                "required": [
                  "dossiers",
                  "montant_eur"
                ],
                "properties": {
                  "dossiers": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "montant_eur": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              },
              "annule": {
                "type": "object",
                "required": [
                  "dossiers",
                  "montant_eur"
                ],
                "properties": {
                  "dossiers": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "montant_eur": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "required": [
    "millesime",
    "source",
    "unite",
    "collecte_le",
    "avertissement",
    "statuts",
    "retenus",
    "mois"
  ]
}
