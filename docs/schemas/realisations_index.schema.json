{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ou-vont-mes-impots.fr/contrat/v1/realisations_index.schema.json",
  "title": "site/data/realisations/index.json : couverture et controles",
  "allOf": [
    {
      "$ref": "commun.schema.json#/$defs/entete"
    }
  ],
  "type": "object",
  "properties": {
    "avertissement": {
      "type": "string"
    },
    "programmes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9]{3}$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "fichiers": {
      "type": "object"
    },
    "couverture": {
      "type": "object"
    },
    "trous_execution": {
      "type": "object"
    },
    "annees_execution": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1990,
        "maximum": 2100
      }
    },
    "annees_performance": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1990,
        "maximum": 2100
      }
    },
    "tendances": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    }
  },
  "required": [
    "avertissement",
    "programmes",
    "fichiers",
    "couverture",
    "trous_execution"
  ]
}
