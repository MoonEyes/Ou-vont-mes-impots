{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ou-vont-mes-impots.fr/contrat/v1/immobilier_etat_index.schema.json",
  "title": "site/data/immobilier_etat/index.json : définitions, fichiers, chiffres clés, écarts entre sources, contrôles, sources, recherche publique",
  "allOf": [
    {
      "$ref": "commun.schema.json#/$defs/entete"
    }
  ],
  "type": "object",
  "properties": {
    "millesime": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "unite": {
      "type": "string",
      "minLength": 1
    },
    "avertissement": {
      "type": "string",
      "minLength": 20
    },
    "collecte_le": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "definitions": {
      "type": "object",
      "required": [
        "parc",
        "valeur_comptable",
        "loyers",
        "cessions",
        "compte"
      ],
      "additionalProperties": {
        "type": "string"
      }
    },
    "fichiers": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": [
          "fichier",
          "contenu"
        ],
        "properties": {
          "fichier": {
            "type": "string",
            "pattern": "^immobilier_etat/.+\\.json$"
          }
        }
      }
    },
    "chiffres_cles": {
      "type": "object",
      "required": [
        "annee",
        "biens_inventaire_global",
        "valeur_controlee_millions_eur",
        "loyers_payes_millions_eur",
        "cessions_prix_actes_millions_eur"
      ],
      "properties": {
        "annee": {
          "type": "integer"
        }
      },
      "additionalProperties": {
        "type": [
          "number",
          "null"
        ]
      }
    },
    "ecarts_entre_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "objet",
          "annee",
          "valeurs",
          "lecture"
        ],
        "properties": {
          "objet": {
            "type": "string",
            "minLength": 1
          },
          "annee": {
            "type": "integer"
          },
          "valeurs": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "required": [
                "source"
              ],
              "properties": {
                "source": {
                  "type": "string",
                  "minLength": 1
                },
                "montant_eur": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "nombre": {
                  "type": [
                    "number",
                    "null"
                  ]
                }
              }
            }
          },
          "lecture": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "controles_totaux": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "objet",
          "total_publie",
          "somme_des_lignes",
          "ecart"
        ]
      }
    },
    "sources": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": [
          "id",
          "titre",
          "url",
          "licence"
        ]
      }
    },
    "sources_inaccessibles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source",
          "motif",
          "constate_le"
        ]
      }
    },
    "limites": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "recherche_publique": {
      "type": "object",
      "required": [
        "date",
        "trouvailles"
      ],
      "properties": {
        "trouvailles": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "nom",
              "url",
              "verdict",
              "licence",
              "date"
            ]
          }
        }
      }
    }
  },
  "required": [
    "millesime",
    "source",
    "unite",
    "avertissement",
    "collecte_le",
    "definitions",
    "fichiers",
    "chiffres_cles",
    "ecarts_entre_sources",
    "sources",
    "sources_inaccessibles",
    "limites",
    "recherche_publique"
  ]
}
