    "cellules_secretes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "niveau",
          "territoire",
          "annee",
          "aide",
          "indicateur"
        ],
        "properties": {
          "niveau": {
            "enum": [
              "france",
              "ensemble",
              "region",
              "departement"
            ]
          },
          "territoire": {
            "type": "string",
            "minLength": 1
          },
          "annee": {
            "type": "integer",
            "minimum": 2000,
            "maximum": 2100
          },
          "aide": {
            "type": "string",
            "minLength": 1
          },
          "indicateur": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
