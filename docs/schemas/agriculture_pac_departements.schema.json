{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ou-vont-mes-impots.fr/contrat/v1/agriculture_pac_departements.schema.json",
  "title": "site/data/agriculture/pac_departements.json : aides de la politique agricole commune par département, année et type d'aide (Agreste et ASP, 2005-2009 ; pipeline/agriculture.py)",
  "allOf": [
    {
      "$ref": "commun.schema.json#/$defs/entete"
    }
  ],
  "type": "object",
  "required": [
    "millesime",
    "source",
    "url",
    "licence",
    "date_sources",
    "unite",
    "annees",
    "piliers",
    "aides",
    "colonnes",
    "territoires",
    "cellules_secretes",
    "controles",
    "definitions",
    "limites",
    "confidentialite"
  ],
