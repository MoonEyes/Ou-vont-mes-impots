        "comparaisons_completes": {
          "type": "integer"
        },
        "comparaisons_avec_cellule_secrete": {
          "type": "integer"
        },
        "ecarts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "objet",
              "niveau",
              "territoire",
              "annee",
              "aide",
              "indicateur",
              "valeur_publiee",
              "somme_des_lignes",
              "ecart"
            ],
            "properties": {
              "objet": {
                "enum": [
                  "region_contre_departements",
                  "france_metropolitaine_contre_regions"
                ]
              },
              "territoire": {
                "type": "string",
                "minLength": 1
              },
              "annee": {
                "type": "integer",
                "minimum": 2000,
                "maximum": 2100
              },
              "aide": {
                "type": "string",
                "minLength": 1
              },
              "indicateur": {
                "type": "string",
                "minLength": 1
              },
              "valeur_publiee": {
                "type": "number"
              },
              "somme_des_lignes": {
                "type": "number"
              },
              "ecart": {
                "type": "number"
              },
              "niveau": {
                "enum": [
                  "france",
                  "ensemble",
                  "region",
                  "departement"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "regle": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "definitions": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "limites": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "confidentialite": {
      "type": "string",
      "minLength": 1
    }
  }
}
