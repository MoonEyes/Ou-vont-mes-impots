      "minItems": 1
    },
    "piliers": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "required": [
        "premier_pilier",
        "developpement_rural"
      ]
    },
    "aides": {
      "type": "object",
      "minProperties": 1,
