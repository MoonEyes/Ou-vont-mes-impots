        "required": [
          "nom",
          "libelle_source",
          "pilier",
          "annees",
          "montant_retenu"
        ],
        "properties": {
          "nom": {
            "type": "string",
            "minLength": 1
          },
          "libelle_source": {
            "type": "string",
            "minLength": 1
          },
          "pilier": {
            "enum": [
              "premier_pilier",
              "developpement_rural"
            ]
          },
          "annees": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 2000,
              "maximum": 2100
            },
            "minItems": 1
          },
          "montant_retenu": {
            "type": "object",
            "additionalProperties": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "additionalProperties": false
      }
    },
    "colonnes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "annee",
          "aide",
          "indicateur",
          "unite",
          "libelle_source"
        ],
        "properties": {
          "annee": {
            "type": "integer",
            "minimum": 2000,
            "maximum": 2100
          },
          "aide": {
            "type": "string",
            "minLength": 1
          },
          "indicateur": {
            "type": "string",
            "minLength": 1
          },
          "unite": {
            "enum": [
              "euros",
              "exploitations",
              "animaux",
              "tonnes"
            ]
          },
          "libelle_source": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      },
      "minItems": 1
    },
    "territoires": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "niveau",
          "code",
          "nom",
          "region",
          "valeurs",
          "par_annee"
        ],
        "properties": {
          "niveau": {
            "enum": [
              "france",
              "ensemble",
              "region",
              "departement"
            ]
          },
          "code": {
            "type": "string",
            "minLength": 1
          },
          "nom": {
            "type": "string",
            "minLength": 1
          },
          "region": {
            "type": [
              "string",
              "null"
            ]
          },
          "valeurs": {
            "type": "array",
            "items": {
              "type": [
                "number",
                "null"
              ]
            }
          },
          "par_annee": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": [
                "montants_retenus_eur",
                "somme_montants_retenus_eur",
                "aides_sans_montant"
              ],
              "properties": {
                "montants_retenus_eur": {
                  "type": "object",
