{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ou-vont-mes-impots.fr/contrat/v1/sante_etablissements_limites.schema.json",
  "title": "site/data/sante_etablissements/limites.json : ce qui n'est pas ouvert, ce qui existe à la place, recherches faites (pipeline/sante_etablissements.py)",
  "allOf": [
    {
      "$ref": "commun.schema.json#/$defs/entete"
    }
  ],
  "type": "object",
  "properties": {
    "millesime": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "collecte_le": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "avertissement": {
      "type": "string"
    },
    "non_ouvert": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "properties": {
          "sujet": {
            "type": "string"
          },
          "etat": {
            "type": "string"
          },
          "ce_qui_existe": {
            "type": "string"
          },
          "fichiers": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "\\.json$"
            }
          }
        },
        "required": [
          "sujet",
          "etat",
          "ce_qui_existe",
          "fichiers"
        ],
        "additionalProperties": false
      }
    },
    "limites": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "valeurs_hors_bornes_ecartees_des_medianes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "hors_perimetre": {
      "type": "object",
      "properties": {
        "regle": {
          "type": "string"
        },
        "etablissements_actifs_exclus": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "libelle": {
                "type": "string"
              },
              "nombre": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "libelle",
              "nombre"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "regle",
        "etablissements_actifs_exclus"
      ],
      "additionalProperties": false
    },
    "sources_inaccessibles": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "recherche_publique": {
      "type": "object",
      "properties": {
        "date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "verdict": {
          "type": "string"
        },
        "trouvailles": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "nom": {
                "type": "string"
              },
              "classement": {
                "type": "string",
                "pattern": "^(réutilisable tel quel|à adapter|inspiration seulement)"
              },
              "licence": {
                "type": "string"
              },
              "derniere_modification": {
                "type": "string"
              },
              "url": {
                "type": "string",
                "pattern": "^https://"
              }
            },
            "required": [
              "nom",
              "classement",
              "licence",
              "derniere_modification",
              "url"
            ],
            "additionalProperties": false
          }
        },
        "recherches_sans_resultat": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "portail": {
                "type": "string"
              },
              "requetes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "resultat": {
                "type": "string"
              }
            },
            "required": [
              "portail",
              "requetes",
              "resultat"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "date",
        "verdict",
        "trouvailles",
        "recherches_sans_resultat"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "collecte_le",
    "avertissement",
    "non_ouvert",
    "limites",
    "valeurs_hors_bornes_ecartees_des_medianes",
    "hors_perimetre",
    "sources_inaccessibles",
    "recherche_publique"
  ],
  "additionalProperties": false
}
