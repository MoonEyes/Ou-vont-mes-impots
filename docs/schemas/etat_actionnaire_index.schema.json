{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ou-vont-mes-impots.fr/contrat/v1/etat_actionnaire_index.schema.json",
  "title": "site/data/etat_actionnaire/index.json : définitions, fichiers, chiffres clés, liens avec recettes.json et l'arbre, sources, sources inaccessibles, recherche publique",
  "allOf": [
    {
      "$ref": "commun.schema.json#/$defs/entete"
    }
  ],
  "type": "object",
  "properties": {
    "millesime": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "unite": {
      "type": "string"
    },
    "avertissement": {
      "type": "string",
      "minLength": 20
    },
    "collecte_le": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "definitions": {
      "type": "object",
      "required": [
        "dividendes",
        "cessions",
        "recapitalisations",
        "versement_budget_general",
        "compte"
      ],
      "additionalProperties": {
        "type": "string"
      }
    },
    "fichiers": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": [
          "fichier",
          "contenu"
        ],
        "properties": {
          "fichier": {
            "type": "string",
            "pattern": "^etat_actionnaire/.+\\.json$"
          }
        }
      }
    },
    "chiffres_cles": {
      "type": "object",
      "required": [
        "annee",
        "mesure",
        "dividendes_eur",
        "cessions_eur",
        "versement_budget_general_eur",
        "recettes_compte_eur",
        "depenses_programme_731_eur",
        "depenses_programme_732_eur",
        "solde_compte_fin_eur",
        "societes_controlees"
      ],
      "properties": {
        "annee": {
          "type": "integer"
        },
        "dividendes_eur": {
          "type": [
            "number",
            "null"
          ]
        },
        "cessions_eur": {
          "type": [
            "number",
            "null"
          ]
        },
        "versement_budget_general_eur": {
          "type": [
            "number",
            "null"
          ]
        },
        "recettes_compte_eur": {
          "type": [
            "number",
            "null"
          ]
        },
        "depenses_programme_731_eur": {
          "type": [
            "number",
            "null"
          ]
        },
        "depenses_programme_732_eur": {
          "type": [
            "number",
            "null"
          ]
        },
        "solde_compte_fin_eur": {
          "type": [
            "number",
            "null"
          ]
        },
        "societes_controlees": {
          "type": "object",
          "required": [
            "annee",
            "nombre"
          ]
        }
      }
    },
    "liens": {
      "type": "object",
      "required": [
        "recettes",
        "arbre"
      ],
      "properties": {
        "recettes": {
          "type": "object",
          "required": [
            "fichier",
            "relation"
          ],
          "properties": {
            "fichier": {
              "const": "recettes.json"
            },
            "relation": {
              "type": "string",
              "minLength": 20
            }
          }
        },
        "arbre": {
          "type": "object",
          "required": [
            "fichier",
            "relation",
            "noeuds"
          ],
          "properties": {
            "fichier": {
              "const": "arbre/racine.json"
            },
            "noeuds": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "programme",
                  "nom",
                  "present",
                  "id",
                  "md",
                  "execution_2024_plrg_eur",
                  "relation"
                ],
                "properties": {
                  "programme": {
                    "type": "string",
                    "pattern": "^[0-9]{3}$"
                  },
                  "present": {
                    "type": "boolean"
                  },
                  "id": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "md": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "execution_2024_plrg_eur": {
                    "type": [
                      "number",
                      "null"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "required": [
          "id",
          "titre",
          "url",
          "licence"
        ],
        "properties": {
          "url": {
            "type": "string",
            "pattern": "^https://"
          }
        }
      }
    },
    "sources_inaccessibles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source",
          "motif",
          "constate_le"
        ],
        "properties": {
          "constate_le": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          }
        }
      }
    },
    "limites": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ecarts_entre_sources": {
      "type": "object",
      "required": [
        "nombre",
        "fichier"
      ]
    },
    "recherche_publique": {
      "type": "object",
      "required": [
        "date",
        "trouvailles"
      ],
      "properties": {
        "trouvailles": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "required": [
              "nom",
              "url",
              "verdict",
              "licence",
              "date"
            ],
            "properties": {
              "verdict": {
                "enum": [
                  "réutilisable tel quel",
                  "à adapter",
                  "inspiration seulement",
                  "aucun dépôt trouvé"
                ]
              }
            }
          }
        }
      }
    }
  },
  "required": [
    "millesime",
    "source",
    "unite",
    "avertissement",
    "collecte_le",
    "definitions",
    "fichiers",
    "chiffres_cles",
    "liens",
    "sources",
    "sources_inaccessibles",
    "limites",
    "recherche_publique"
  ]
}
