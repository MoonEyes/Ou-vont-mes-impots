{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ou-vont-mes-impots.fr/contrat/v1/etat_actionnaire_index.schema.json",
  "title": "site/data/etat_actionnaire/index.json : définitions, fichiers, chiffres clés, liens avec recettes.json et l'arbre, sources, sources inaccessibles, recherche publique",
  "allOf": [
    {
      "$ref": "commun.schema.json#/$defs/entete"
    }
  ],
  "type": "object",
  "properties": {
    "millesime": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "unite": {
      "type": "string"
    },
    "avertissement": {
      "type": "string",
      "minLength": 20
    },
    "collecte_le": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "definitions": {
      "type": "object",
      "required": [
        "dividendes",
        "cessions",
        "recapitalisations",
        "versement_budget_general",
        "compte"
      ],
      "additionalProperties": {
        "type": "string"
      }
    },
    "fichiers": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": [
          "fichier",
          "contenu"
        ],
        "properties": {
          "fichier": {
            "type": "string",
            "pattern": "^etat_actionnaire/.+\\.json$"
          }
        }
      }
    },
    "chiffres_cles": {
      "type": "object",
      "required": [
        "annee",
        "mesure",
        "dividendes_eur",
        "cessions_eur",
        "versement_budget_general_eur",
        "recettes_compte_eur",
        "depenses_programme_731_eur",
        "depenses_programme_732_eur",
        "solde_compte_fin_eur",
        "societes_controlees"
      ],
      "properties": {
        "annee": {
          "type": "integer"
        },
        "dividendes_eur": {
          "type": [
            "number",
            "null"
          ]
        },
        "cessions_eur": {
          "type": [
            "number",
            "null"
          ]
        },
        "versement_budget_general_eur": {
          "type": [
            "number",
            "null"
          ]
        },
        "recettes_compte_eur": {
          "type": [
            "number",
            "null"
          ]
        },
        "depenses_programme_731_eur": {
          "type": [
            "number",
            "null"
          ]
        },
        "depenses_programme_732_eur": {
          "type": [
            "number",
            "null"
          ]
        },
        "solde_compte_fin_eur": {
          "type": [
            "number",
            "null"
          ]
        },
        "societes_controlees": {
          "type": "object",
          "required": [
            "annee",
            "nombre"
          ]
        }
      }
    },
    "liens": {
      "type": "object",
      "required": [
        "recettes",
        "arbre"
      ],
      "properties": {
        "recettes": {
          "type": "object",
          "required": [
            "fichier",
            "relation"
          ],
          "properties": {
            "fichier": {
              "const": "recettes.json"
            },
            "relation": {
              "type": "string",
              "minLength": 20
            }
          }
        },
        "arbre": {
          "type": "object",
          "required": [
            "fichier",
            "relation",
            "noeuds"
          ],
          "properties": {
            "fichier": {
              "const": "arbre/racine.json"
            },
            "noeuds": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "programme",
                  "nom",
                  "present",
                  "id",
                  "md",
                  "execution_2024_plrg_eur",
                  "relation"
                ],
                "properties": {
                  "programme": {
                    "type": "string",
                    "pattern": "^[0-9]{3}$"
                  },
                  "present": {
                    "type": "boolean"
                  },
                  "id": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "md": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "execution_2024_plrg_eur": {
                    "type": [
                      "number",
                      "null"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "required": [
          "id",
          "titre",
          "url",
          "licence"
        ],
        "properties": {
          "url": {
            "type": "string",
            "pattern": "^https://"
          }
        }
      }
    },
    "sources_inaccessibles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source",
          "motif",
          "constate_le"
        ],
        "properties": {
          "constate_le": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          }
        }
      }
    },
    "limites": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ecarts_entre_sources": {
      "type": "object",
      "required": [
        "nombre",
        "fichier"
      ]
    },
    "recherche_publique": {
      "type": "object",
      "required": [
        "date",
        "trouvailles"
      ],
      "properties": {
        "trouvailles": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "required": [
              "nom",
              "url",
              "verdict",
              "licence",
              "date"
            ],
            "properties": {
              "verdict": {
                "enum": [
                  "réutilisable tel quel",
                  "à adapter",
                  "inspiration seulement",
                  "aucun dépôt trouvé"
                ]
              }
            }
          }
        }
      }
    },
    "valeur_portefeuille": {
      "type": "object",
      "description": "Valeur des participations : estimation de l'Agence des participations de l'État au 30 juin (statut « approché ») et valeur au bilan de l'État au 31 décembre 2025 (compte général, statut « tracé »). Deux mesures publiées côte à côte, jamais additionnées ; chaque montant figure dans une citation exacte.",
      "required": [
        "definition",
        "agence",
        "bilan_etat"
      ],
      "properties": {
        "definition": {
          "type": "string",
          "minLength": 40
        },
        "agence": {
          "type": "object",
          "required": [
            "producteur",
            "perimetre",
            "methode",
            "methode_citation",
            "statut",
            "unite",
            "ordre",
            "serie",
            "cotees_fin_2025"
          ],
          "properties": {
            "statut": {
              "const": "approché"
            },
            "unite": {
              "const": "milliards d'euros"
            },
            "methode_citation": {
              "type": "object",
              "required": [
                "source",
                "url",
                "page",
                "texte"
              ]
            },
            "ordre": {
              "type": "object",
              "required": [
                "regle",
                "cles"
              ]
            },
            "serie": {
              "type": "array",
              "minItems": 3,
              "items": {
                "allOf": [
                  {
                    "type": "object",
                    "required": [
                      "date",
                      "annee",
                      "source",
                      "url",
                      "citations"
                    ],
                    "properties": {
                      "date": {
                        "type": "string",
                        "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
                      },
                      "annee": {
                        "type": "integer"
                      },
                      "source": {
                        "type": "string",
                        "minLength": 10
                      },
                      "url": {
                        "type": "string",
                        "pattern": "^https://"
                      },
                      "citations": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                          "type": "object",
                          "required": [
                            "page",
                            "texte"
                          ],
                          "additionalProperties": false,
                          "properties": {
                            "page": {
                              "type": "integer",
                              "minimum": 1
                            },
                            "texte": {
                              "type": "string",
                              "minLength": 10
                            }
                          }
                        }
                      },
                      "valeur_md": {
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "valeur_cotee_md": {
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "entreprises": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "entreprises_cotees": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "entites": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "note": {
                        "type": "string",
                        "minLength": 10
                      }
                    }
                  },
                  {
                    "required": [
                      "valeur_md"
                    ]
                  }
                ]
              }
            },
            "cotees_fin_2025": {
              "allOf": [
                {
                  "type": "object",
                  "required": [
                    "date",
                    "annee",
                    "source",
                    "url",
                    "citations"
                  ],
                  "properties": {
                    "date": {
                      "type": "string",
                      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
                    },
                    "annee": {
                      "type": "integer"
                    },
                    "source": {
                      "type": "string",
                      "minLength": 10
                    },
                    "url": {
                      "type": "string",
                      "pattern": "^https://"
                    },
                    "citations": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "object",
                        "required": [
                          "page",
                          "texte"
                        ],
                        "additionalProperties": false,
                        "properties": {
                          "page": {
                            "type": "integer",
                            "minimum": 1
                          },
                          "texte": {
                            "type": "string",
                            "minLength": 10
                          }
                        }
                      }
                    },
                    "valeur_md": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "valeur_cotee_md": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "entreprises": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "entreprises_cotees": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "entites": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "note": {
                      "type": "string",
                      "minLength": 10
                    }
                  }
                },
                {
                  "required": [
                    "valeur_cotee_md",
                    "statut"
                  ]
                }
              ]
            }
          }
        },
        "bilan_etat": {
          "allOf": [
            {
              "type": "object",
              "required": [
                "date",
                "annee",
                "source",
                "url",
                "citations"
              ],
              "properties": {
                "date": {
                  "type": "string",
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
                },
                "annee": {
                  "type": "integer"
                },
                "source": {
                  "type": "string",
                  "minLength": 10
                },
                "url": {
                  "type": "string",
                  "pattern": "^https://"
                },
                "citations": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "required": [
                      "page",
                      "texte"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "page": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "texte": {
                        "type": "string",
                        "minLength": 10
                      }
                    }
                  }
                },
                "valeur_md": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "valeur_cotee_md": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "entreprises": {
                  "type": "integer",
                  "minimum": 1
                },
                "entreprises_cotees": {
                  "type": "integer",
                  "minimum": 1
                },
                "entites": {
                  "type": "integer",
                  "minimum": 1
                },
                "note": {
                  "type": "string",
                  "minLength": 10
                }
              }
            },
            {
              "type": "object",
              "required": [
                "producteur",
                "perimetre",
                "methode",
                "statut",
                "unite",
                "valeur_md",
                "entites_controlees_md",
                "entites_non_controlees_md",
                "entites",
                "entites_controlees",
                "entites_non_controlees"
              ],
              "properties": {
                "statut": {
                  "const": "tracé"
                },
                "unite": {
                  "const": "milliards d'euros"
                },
                "entites_controlees_md": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "entites_non_controlees_md": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "entites_controlees": {
                  "type": "integer"
                },
                "entites_non_controlees": {
                  "type": "integer"
                }
              }
            }
          ]
        }
      }
    }
  },
  "required": [
    "millesime",
    "source",
    "unite",
    "avertissement",
    "collecte_le",
    "definitions",
    "fichiers",
    "chiffres_cles",
    "liens",
    "sources",
    "sources_inaccessibles",
    "limites",
    "recherche_publique",
    "valeur_portefeuille"
  ]
}
