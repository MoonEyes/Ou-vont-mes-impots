{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ou-vont-mes-impots.fr/contrat/v1/programme.schema.json",
  "title": "site/data/programmes/<n>.json : actions, sous-actions et nature d'un programme (PLF 2025)",
  "allOf": [
    {
      "$ref": "commun.schema.json#/$defs/entete"
    }
  ],
  "type": "object",
  "properties": {
    "programme": {
      "type": "integer",
      "minimum": 100,
      "maximum": 999
    },
    "unite": {
      "$ref": "commun.schema.json#/$defs/unite_md_cp"
    },
    "libelle": {
      "type": "string"
    },
    "avertissement": {
      "type": "string"
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "nom": {
            "type": [
              "string",
              "null"
            ]
          },
          "md": {
            "type": "number"
          },
          "sous_actions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "code": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "nom": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "md": {
                  "type": "number"
                }
              },
              "required": [
                "code",
                "nom",
                "md"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "code",
          "nom",
          "md",
          "sous_actions"
        ],
        "additionalProperties": false
      }
    },
    "nature": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    }
  },
  "required": [
    "programme",
    "unite",
    "actions",
    "nature"
  ]
}
