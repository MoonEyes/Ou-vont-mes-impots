{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ou-vont-mes-impots.fr/contrat/v1/cofog.schema.json",
  "title": "site/data/cofog.json : depenses publiques consolidees par fonction",
  "allOf": [
    {
      "$ref": "commun.schema.json#/$defs/entete"
    }
  ],
  "type": "object",
  "properties": {
    "annee": {
      "$ref": "commun.schema.json#/$defs/annee"
    },
    "unite": {
      "type": "string"
    },
    "total": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "fonctions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^GF(0[1-9]|10)$"
          },
          "nom": {
            "type": "string"
          },
          "md": {
            "type": "number"
          }
        },
        "required": [
          "code",
          "nom",
          "md"
        ],
        "additionalProperties": false
      },
      "minItems": 10,
      "maxItems": 10
    }
  },
  "required": [
    "annee",
    "unite",
    "fonctions",
    "total"
  ]
}
