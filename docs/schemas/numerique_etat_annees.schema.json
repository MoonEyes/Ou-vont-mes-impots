{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ou-vont-mes-impots.fr/contrat/v1/numerique_etat_annees.schema.json",
  "title": "site/data/numerique_etat/annees.json : par année, chaque source dans sa colonne (éditions du panorama, décisions France Relance et FITN8, appels FAST), sans addition entre sources",
  "allOf": [
    {
      "$ref": "commun.schema.json#/$defs/entete"
    }
  ],
  "type": "object",
  "properties": {
    "millesime": {
      "type": "string",
      "minLength": 4
    },
    "source": {
      "type": "string",
      "minLength": 10
    },
    "unite": {
      "type": "string",
      "minLength": 4
    },
    "collecte_le": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "avertissement": {
      "type": "string",
      "minLength": 40
    },
    "definitions": {
      "type": "object"
    },
    "annees": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": [
          "annee"
        ],
        "additionalProperties": false,
        "properties": {
          "annee": {
            "$ref": "commun.schema.json#/$defs/annee_entier"
          },
          "panorama_editions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "edition",
                "projets",
                "cout_publie_meur",
                "projets_sans_cout_publie"
              ]
            }
          },
          "france_relance_decisions": {
            "type": "object",
            "required": [
              "projets",
              "montant_publie_eur",
              "projets_sans_montant_publie"
            ],
            "additionalProperties": false,
            "properties": {
              "projets": {
                "type": "integer",
                "minimum": 0
              },
              "montant_publie_eur": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "projets_sans_montant_publie": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "ditp_fitn8_decisions": {
            "type": "object",
            "required": [
              "projets",
              "montant_publie_eur",
              "projets_sans_montant_publie"
            ],
            "additionalProperties": false,
            "properties": {
              "projets": {
                "type": "integer",
                "minimum": 0
              },
              "montant_publie_eur": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "projets_sans_montant_publie": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "fast_appels": {
            "type": "object",
            "required": [
              "projets",
              "montant_publie_eur",
              "projets_sans_montant_publie"
            ],
            "additionalProperties": false,
            "properties": {
              "projets": {
                "type": "integer",
                "minimum": 0
              },
              "montant_publie_eur": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "projets_sans_montant_publie": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    }
  },
  "required": [
    "millesime",
    "source",
    "unite",
    "collecte_le",
    "avertissement",
    "definitions",
    "annees"
  ]
}
