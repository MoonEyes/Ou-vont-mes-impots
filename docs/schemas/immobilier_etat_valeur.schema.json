{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ou-vont-mes-impots.fr/contrat/v1/immobilier_etat_valeur.schema.json",
  "title": "site/data/immobilier_etat/valeur.json : valeur comptable du parc contrôlé par l'État (2012 à 2023), par ministère (2017 à 2023), emphytéoses, opérateurs",
  "allOf": [
    {
      "$ref": "commun.schema.json#/$defs/entete"
    }
  ],
  "type": "object",
  "properties": {
    "millesime": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "unite": {
      "type": "string"
    },
    "avertissement": {
      "type": "string",
      "minLength": 20
    },
    "collecte_le": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "url": {
      "type": "string"
    },
    "valeur_comptable_patrimoine_controle": {
      "type": "object",
      "required": [
        "page",
        "valeurs_meur",
        "statut"
      ],
      "properties": {
        "valeurs_meur": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[0-9]{4}$"
          },
          "additionalProperties": {
            "type": "number"
          }
        }
      }
    },
    "logements_concedes_2023": {
      "type": "object",
      "required": [
        "valeur_meur",
        "citation"
      ],
      "properties": {
        "citation": {
          "type": "object",
          "required": [
            "document",
            "page",
            "texte"
          ],
          "properties": {
            "page": {
              "type": "integer",
              "minimum": 1
            },
            "texte": {
              "type": "string",
              "minLength": 10
            }
          }
        }
      }
    },
    "valeur_nette_comptable_par_ministere": {
      "type": "object",
      "required": [
        "page",
        "annees",
        "lignes",
        "total_meur"
      ],
      "properties": {
        "lignes": {
          "type": "array",
          "minItems": 5,
          "items": {
            "type": "object",
            "required": [
              "ministere",
              "valeurs_meur"
            ],
            "properties": {
              "valeurs_meur": {
                "type": "object",
                "propertyNames": {
                  "pattern": "^[0-9]{4}$"
                },
                "additionalProperties": {
                  "type": "number"
                }
              }
            }
          }
        },
        "total_meur": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[0-9]{4}$"
          },
          "additionalProperties": {
            "type": "number"
          }
        }
      }
    },
    "emphyteoses_et_baux_a_construction": {
      "type": "object",
      "required": [
        "nombre",
        "valeur_comptable_meur"
      ]
    },
    "operateurs": {
      "type": "object",
      "required": [
        "valeurs_md",
        "citation"
      ],
      "properties": {
        "citation": {
          "type": "object",
          "required": [
            "document",
            "page",
            "texte"
          ],
          "properties": {
            "page": {
              "type": "integer",
              "minimum": 1
            },
            "texte": {
              "type": "string",
              "minLength": 10
            }
          }
        }
      }
    },
    "ecarts_entre_sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "objet",
          "valeurs",
          "lecture"
        ],
        "properties": {
          "valeurs": {
            "type": "array",
            "minItems": 2
          },
          "lecture": {
            "type": "string",
            "minLength": 10
          }
        }
      }
    }
  },
  "required": [
    "millesime",
    "source",
    "unite",
    "avertissement",
    "collecte_le",
    "url",
    "valeur_comptable_patrimoine_controle",
    "valeur_nette_comptable_par_ministere",
    "emphyteoses_et_baux_a_construction",
    "operateurs",
    "ecarts_entre_sources"
  ]
}
