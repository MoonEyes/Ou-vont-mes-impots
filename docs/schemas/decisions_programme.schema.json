{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ou-vont-mes-impots.fr/contrat/v1/decisions_programme.schema.json",
  "title": "site/data/decisions/programme_<n>.json : décisions et chronologie des crédits d'un programme",
  "description": "Par année : LFI, LFR, reports, mouvements réglementaires et exécution (PLRG), amendements de crédits (comptes et adoptés), décrets et arrêtés publiés au JO. Montants en euros, signés.",
  "allOf": [
    {
      "$ref": "commun.schema.json#/$defs/entete"
    }
  ],
  "type": "object",
  "properties": {
    "genere_le": {
      "type": "string"
    },
    "programme": {
      "type": "string",
      "pattern": "^[0-9]{3}$"
    },
    "libelle": {
      "type": ["string", "null"]
    },
    "mission": {
      "type": ["string", "null"]
    },
    "dans_arbre_2024": {
      "type": "boolean"
    },
    "unite": {
      "type": "string"
    },
    "annees": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^20[0-9]{2}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/annee"
      }
    },
    "chronologie": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["date", "annee", "etape", "cp"],
        "properties": {
          "etape": {
            "type": "string"
          },
          "cp": {
            "type": "number"
          },
          "auteur": {
            "type": ["string", "null"]
          }
        }
      }
    }
  },
  "required": ["programme", "annees", "chronologie"],
  "$defs": {
    "auteur": {
      "type": "object",
      "description": "Seuls les élus, le Gouvernement et les commissions sont nommés ; `masque` : élu candidat à une élection nationale, nom publié seulement dans vie_politique.",
      "required": ["type", "nom", "groupe"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string"
        },
        "nom": {
          "type": ["string", "null"]
        },
        "groupe": {
          "type": ["string", "null"]
        },
        "masque": {
          "type": "string"
        }
      }
    },
    "amendement": {
      "type": "object",
      "required": ["id", "chambre", "texte", "annee", "lieu", "numero", "sort", "auteur", "ae", "cp", "url"],
      "properties": {
        "chambre": {
          "enum": ["AN", "Sénat"]
        },
        "texte": {
          "type": "string",
          "pattern": "^PLF[GR]? [0-9]{4}$"
        },
        "annee": {
          "$ref": "commun.schema.json#/$defs/annee_entier"
        },
        "lieu": {
          "type": ["string", "null"]
        },
        "numero": {
          "type": ["string", "null"]
        },
        "sort": {
          "type": "string"
        },
        "auteur": {
          "$ref": "#/$defs/auteur"
        },
        "cosignataires": {
          "type": "integer",
          "minimum": 0
        },
        "ae": {
          "type": "number"
        },
        "cp": {
          "type": "number"
        },
        "scrutins": {
          "type": "array"
        },
        "url": {
          "type": ["string", "null"]
        }
      }
    },
    "mouvement": {
      "type": "object",
      "required": ["id", "date", "annee", "type", "ae", "cp", "url"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^JORFTEXT[0-9]{12}$"
        },
        "ae": {
          "type": "number"
        },
        "cp": {
          "type": "number"
        },
        "url": {
          "type": "string",
          "pattern": "^https://www\\.legifrance\\.gouv\\.fr/"
        }
      }
    },
    "annee": {
      "type": "object",
      "properties": {
        "lfi_cp": {
          "type": "number"
        },
        "lfr_cp": {
          "type": "number"
        },
        "reports_entrants_cp": {
          "type": "number"
        },
        "mouvements_reglementaires_plrg_cp": {
          "type": "number"
        },
        "fonds_de_concours_plrg_cp": {
          "type": "number"
        },
        "ouverts_cp": {
          "type": "number"
        },
        "depenses_cp": {
          "type": "number"
        },
        "source_plrg": {
          "type": "string"
        },
        "controle_jo_plrg": {
          "type": "object"
        },
        "amendements": {
          "type": "object"
        },
        "amendements_adoptes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/amendement"
          }
        },
        "mouvements_jo": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/mouvement"
          }
        },
        "mouvements_jo_total_cp": {
          "type": "number"
        }
      }
    }
  }
}
