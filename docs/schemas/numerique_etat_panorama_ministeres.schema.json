{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ou-vont-mes-impots.fr/contrat/v1/numerique_etat_panorama_ministeres.schema.json",
  "title": "site/data/numerique_etat/panorama/ministeres.json : projets et coûts estimés publiés par ministère porteur tel que publié, édition par édition",
  "allOf": [
    {
      "$ref": "commun.schema.json#/$defs/entete"
    }
  ],
  "type": "object",
  "properties": {
    "millesime": {
      "type": "string",
      "minLength": 4
    },
    "source": {
      "type": "string",
      "minLength": 10
    },
    "unite": {
      "type": "string",
      "minLength": 4
    },
    "collecte_le": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "avertissement": {
      "type": "string",
      "minLength": 40
    },
    "ordre": {
      "type": "object",
      "required": [
        "regle",
        "cles"
      ],
      "properties": {
        "regle": {
          "type": "string"
        },
        "cles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "ministeres": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "required": [
          "ministere",
          "noms_publies",
          "editions"
        ],
        "properties": {
          "ministere": {
            "type": "string"
          },
          "noms_publies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "editions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "edition",
                "projets",
                "cout_publie_meur",
                "projets_sans_cout_publie",
                "projets_ids"
              ],
              "properties": {
                "edition": {
                  "type": "string",
                  "pattern": "^20[0-9]{2}-(0[1-9]|1[0-2])$"
                },
                "projets": {
                  "type": "integer",
                  "minimum": 1
                },
                "cout_publie_meur": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "exclusiveMinimum": 0
                },
                "projets_sans_cout_publie": {
                  "type": "integer",
                  "minimum": 0
                },
                "projets_ids": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "calculs": {
      "type": "object",
      "required": [
        "calcule_par_le_site",
        "methode"
      ],
      "properties": {
        "calcule_par_le_site": {
          "const": true
        },
        "methode": {
          "type": "string",
          "minLength": 40
        }
      }
    }
  },
  "required": [
    "millesime",
    "source",
    "unite",
    "collecte_le",
    "avertissement",
    "ordre",
    "ministeres",
    "calculs"
  ]
}
