{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ou-vont-mes-impots.fr/contrat/v1/marches_titulaires.schema.json",
  "title": "site/data/marches/titulaires.json : principaux titulaires nommés (personnes morales seulement), sur la période et par année ; entrepreneurs individuels agrégés (pipeline/marches.py)",
  "allOf": [
    {
      "$ref": "commun.schema.json#/$defs/entete"
    }
  ],
  "type": "object",
  "properties": {
    "millesime": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "unite": {
      "type": "string",
      "pattern": "^euros HT"
    },
    "collecte_le": {
      "type": "string",
      "format": "date"
    },
    "annees": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 2019,
        "maximum": 2100
      },
      "minItems": 1
    },
    "note": {
      "type": "string",
      "minLength": 1
    },
    "ordre": {
      "type": "string",
      "minLength": 1
    },
    "titulaires": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "siren": {
            "$ref": "commun.schema.json#/$defs/siren"
          },
          "denomination": {
            "type": "string",
            "minLength": 1
          },
          "categorie_juridique": {
            "$ref": "commun.schema.json#/$defs/categorie_personne_morale"
          },
          "marches": {
            "type": "integer",
            "minimum": 0
          },
          "acheteurs": {
            "type": "integer",
            "minimum": 0
          },
          "total_eur": {
            "type": "number"
          },
          "montants_eur": {
            "type": "array",
            "items": {
              "type": [
                "number",
                "null"
              ]
            },
            "minItems": 1
          }
        },
        "required": [
          "siren",
          "denomination",
          "categorie_juridique",
          "marches",
          "acheteurs",
          "total_eur",
          "montants_eur"
        ],
        "additionalProperties": false,
        "propertyNames": {
          "not": {
            "pattern": "(?i)pr[eé]nom|adresse|courriel|telephone|dirigeant"
          }
        }
      },
      "maxItems": 100
    },
    "autres_personnes_morales": {
      "type": "object",
      "properties": {
        "nombre": {
          "type": "integer",
          "minimum": 0
        },
        "montant_eur": {
          "type": "number"
        }
      },
      "required": [
        "nombre",
        "montant_eur"
      ],
      "additionalProperties": false
    },
    "agrege_confidentialite": {
      "type": "object",
      "properties": {
        "montant_eur": {
          "type": "number"
        },
        "part_pct": {
          "type": [
            "number",
            "null"
          ]
        },
        "dont_personnes_physiques_eur": {
          "type": "number"
        },
        "dont_diffusion_partielle_eur": {
          "type": "number"
        },
        "dont_siren_introuvable_eur": {
          "type": "number"
        }
      },
      "required": [
        "montant_eur",
        "part_pct",
        "dont_personnes_physiques_eur",
        "dont_diffusion_partielle_eur",
        "dont_siren_introuvable_eur"
      ],
      "additionalProperties": false
    },
    "par_annee": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "annee": {
            "type": "integer",
            "minimum": 2019,
            "maximum": 2100
          },
          "titulaires": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "siren": {
                  "$ref": "commun.schema.json#/$defs/siren"
                },
                "denomination": {
                  "type": "string",
                  "minLength": 1
                },
                "categorie_juridique": {
                  "$ref": "commun.schema.json#/$defs/categorie_personne_morale"
                },
                "marches": {
                  "type": "integer",
                  "minimum": 0
                },
                "montant_eur": {
                  "type": "number"
                }
              },
              "required": [
                "siren",
                "denomination",
                "categorie_juridique",
                "marches",
                "montant_eur"
              ],
              "additionalProperties": false,
              "propertyNames": {
                "not": {
                  "pattern": "(?i)pr[eé]nom|adresse|courriel|telephone|dirigeant"
                }
              }
            },
            "maxItems": 20
          },
          "autres_personnes_morales": {
            "type": "object",
            "properties": {
              "nombre": {
                "type": "integer",
                "minimum": 0
              },
              "montant_eur": {
                "type": "number"
              }
            },
            "required": [
              "nombre",
              "montant_eur"
            ],
            "additionalProperties": false
          },
          "agrege_confidentialite": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "montant_eur": {
                    "type": "number"
                  },
                  "part_pct": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "dont_personnes_physiques_eur": {
                    "type": "number"
                  },
                  "dont_diffusion_partielle_eur": {
                    "type": "number"
                  },
                  "dont_siren_introuvable_eur": {
                    "type": "number"
                  }
                },
                "required": [
                  "montant_eur",
                  "part_pct",
                  "dont_personnes_physiques_eur",
                  "dont_diffusion_partielle_eur",
                  "dont_siren_introuvable_eur"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "annee",
          "titulaires",
          "autres_personnes_morales",
          "agrege_confidentialite"
        ],
        "additionalProperties": false
      }
    },
    "regle_personnes": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "millesime",
    "source",
    "unite",
    "collecte_le",
    "annees",
    "note",
    "ordre",
    "titulaires",
    "autres_personnes_morales",
    "agrege_confidentialite",
    "par_annee",
    "regle_personnes"
  ],
  "additionalProperties": false
}
