{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://ou-vont-mes-impots.fr/contrat/v1/fonds_solidarite_regions_mois.schema.json",
 "title": "site/data/fonds_solidarite/regions_mois.json : cumuls publiés à la fin de chaque mois, par volet, région et section d'activité",
 "allOf": [
  {
   "$ref": "commun.schema.json#/$defs/entete"
  }
 ],
 "type": "object",
 "required": [
  "millesime",
  "source",
  "date_sources",
  "unite",
  "colonnes",
  "lignes"
 ],
 "properties": {
  "date_sources": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
  },
  "colonnes": {
   "const": [
    "instantane",
    "volet",
    "region",
    "section",
    "nombre_aides",
    "nombre_entreprises",
    "montant_eur"
   ]
  },
  "lignes": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "array",
    "prefixItems": [
     {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
     },
     {
      "enum": [
       1,
       2
      ]
     },
     {
      "type": "string",
      "pattern": "^\\d{2}$"
     },
     {
      "type": "string",
      "pattern": "^[A-Z]$"
     },
     {
      "type": [
       "integer",
       "null"
      ]
     },
     {
      "type": [
       "integer",
       "null"
      ]
     },
     {
      "type": [
       "integer",
       "null"
      ]
     }
    ],
    "minItems": 7,
    "maxItems": 7
   }
  }
 }
}
