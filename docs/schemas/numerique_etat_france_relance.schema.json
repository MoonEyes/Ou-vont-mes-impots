{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ou-vont-mes-impots.fr/contrat/v1/numerique_etat_france_relance.schema.json",
  "title": "site/data/numerique_etat/fonds/france_relance.json : lauréats France Relance du volet mise à niveau numérique de l'État et des territoires, par dispositif, ministère, année et département",
  "allOf": [
    {
      "$ref": "commun.schema.json#/$defs/entete"
    }
  ],
  "type": "object",
  "properties": {
    "millesime": {
      "type": "string",
      "minLength": 4
    },
    "source": {
      "type": "string",
      "minLength": 10
    },
    "unite": {
      "type": "string",
      "minLength": 4
    },
    "collecte_le": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "avertissement": {
      "type": "string",
      "minLength": 40
    },
    "note": {
      "type": "string"
    },
    "arbre_etat": {
      "type": "object",
      "required": [
        "programme",
        "noeud",
        "nom_programme",
        "fichier",
        "action",
        "nom_action",
        "rattachement"
      ],
      "properties": {
        "programme": {
          "type": "string",
          "pattern": "^[0-9]{3}$"
        },
        "noeud": {
          "type": "string"
        },
        "fichier": {
          "type": "string",
          "pattern": "^arbre/.+\\.json$"
        },
        "action": {
          "type": "string",
          "pattern": "^[0-9]{3}-[0-9]{2}$"
        },
        "nom_action": {
          "type": "string"
        },
        "rattachement": {
          "type": "string"
        }
      }
    },
    "confidentialite": {
      "type": "object",
      "required": [
        "regle_personnes",
        "porteurs_non_publies"
      ],
      "properties": {
        "regle_personnes": {
          "type": "string",
          "minLength": 40
        },
        "porteurs_non_publies": {
          "type": "integer"
        },
        "titres_non_publies": {
          "type": "integer"
        }
      }
    },
    "total": {
      "type": "object",
      "required": [
        "projets",
        "montant_publie_eur",
        "projets_sans_montant_publie"
      ],
      "additionalProperties": false,
      "properties": {
        "projets": {
          "type": "integer",
          "minimum": 0
        },
        "montant_publie_eur": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "projets_sans_montant_publie": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "par_dispositif": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "dispositif",
          "libelle_dispositif",
          "projets",
          "montant_publie_eur",
          "projets_sans_montant_publie"
        ]
      }
    },
    "par_ministere": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "ministere",
          "projets",
          "montant_publie_eur",
          "projets_sans_montant_publie"
        ],
        "properties": {
          "ministere": {
            "type": [
              "string",
              "null"
            ]
          },
          "projets": {
            "type": "integer"
          },
          "montant_publie_eur": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "projets_sans_montant_publie": {
            "type": "integer"
          }
        }
      }
    },
    "par_annee": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "annee",
          "projets",
          "montant_publie_eur",
          "projets_sans_montant_publie"
        ],
        "properties": {
          "annee": {
            "type": [
              "integer",
              "null"
            ]
          },
          "projets": {
            "type": "integer"
          },
          "montant_publie_eur": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "projets_sans_montant_publie": {
            "type": "integer"
          }
        }
      }
    },
    "ordre": {
      "type": "object",
      "required": [
        "regle",
        "cles"
      ],
      "properties": {
        "regle": {
          "type": "string"
        },
        "cles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "departements": {
      "type": "array",
      "minItems": 90,
      "items": {
        "type": "object",
        "required": [
          "code",
          "nom",
          "projets",
          "montant_publie_eur",
          "projets_sans_montant_publie"
        ],
        "properties": {
          "code": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^([0-9]{2,3}|2A|2B)$"
          },
          "nom": {
            "type": "string"
          },
          "projets": {
            "type": "integer"
          },
          "montant_publie_eur": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "projets_sans_montant_publie": {
            "type": "integer"
          },
          "fichier": {
            "type": "string",
            "pattern": "^numerique_etat/fonds/.+\\.json$"
          }
        }
      }
    }
  },
  "required": [
    "millesime",
    "source",
    "unite",
    "collecte_le",
    "avertissement",
    "arbre_etat",
    "confidentialite",
    "total",
    "par_dispositif",
    "par_ministere",
    "par_annee",
    "ordre",
    "departements"
  ]
}
