{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://ou-vont-mes-impots.fr/contrat/v1/fonds_solidarite_index.schema.json",
 "title": "site/data/fonds_solidarite/index.json : volets, instantanés, nomenclatures, couverture, manques, règles et limites du fonds de solidarité (pipeline/fonds_solidarite.py)",
 "allOf": [
  {
   "$ref": "commun.schema.json#/$defs/entete"
  }
 ],
 "type": "object",
 "required": [
  "millesime",
  "source",
  "date_sources",
  "licence",
  "page_source",
  "historique",
  "presentation",
  "volets",
  "instantanes",
  "sections",
  "categories_juridiques",
  "classes_effectif",
  "regions",
  "departements",
  "region_des_departements",
  "couverture",
  "fichiers",
  "manques",
  "regles",
  "limites",
  "recherche_publique",
  "ordre"
 ],
 "properties": {
  "date_sources": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
  },
  "instantanes": {
   "type": "object",
   "required": [
    "volet1_dernier",
    "volet2_dernier",
    "fins_de_mois",
    "manquants"
   ],
   "properties": {
    "fins_de_mois": {
     "type": "array",
     "items": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
     }
    }
   }
  },
  "sections": {
   "type": "object",
   "propertyNames": {
    "pattern": "^[A-Z]$"
   }
  },
  "manques": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "quoi",
     "pourquoi",
     "depuis",
     "source"
    ],
    "properties": {
     "source": {
      "type": "object",
      "required": [
       "libelle",
       "url"
      ]
     }
    }
   }
  },
  "regles": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "limites": {
   "type": "array",
   "items": {
    "type": "string"
   }
  }
 }
}
