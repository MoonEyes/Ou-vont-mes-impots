{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ou-vont-mes-impots.fr/contrat/v1/arbre_etat.schema.json",
  "title": "site/data/arbre*/*.json : arbres du budget de l'Etat (execution 2024, LFI 2025, nature PLF 2025)",
  "allOf": [
    {
      "$ref": "commun.schema.json#/$defs/entete"
    }
  ],
  "$ref": "#/$defs/noeud",
  "properties": {
    "unite": {
      "$ref": "commun.schema.json#/$defs/unite_md_cp"
    }
  },
  "required": [
    "unite"
  ],
  "$defs": {
    "noeud": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "nom": {
          "type": "string"
        },
        "niveau": {
          "enum": [
            "racine",
            "grand_poste",
            "mission",
            "programme",
            "action",
            "sous_action",
            "titre",
            "categorie"
          ]
        },
        "md": {
          "type": "number",
          "description": "Milliards d'euros, 6 decimales ; somme des enfants"
        },
        "enfants": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/noeud"
          },
          "minItems": 1
        },
        "fichier": {
          "type": "string",
          "pattern": "^(arbre|arbre_lfi2025|arbre_plf2025_nature)/[0-9A-Za-z_-]+\\.json$"
        },
        "nb_enfants": {
          "type": "integer",
          "minimum": 1
        },
        "millesime": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "unite": {
          "type": "string"
        },
        "libelle": {
          "type": "string"
        },
        "avertissement": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "nom",
        "niveau",
        "md"
      ],
      "additionalProperties": false,
      "dependentRequired": {
        "fichier": [
          "nb_enfants"
        ],
        "nb_enfants": [
          "fichier"
        ]
      },
      "not": {
        "required": [
          "enfants",
          "fichier"
        ]
      }
    }
  }
}
