{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ou-vont-mes-impots.fr/contrat/v1/niches_mesures.schema.json",
  "title": "site/data/niches/mesures.json : chaque dépense fiscale, coût 2019 à 2026, bénéficiaires, programme (pipeline/niches.py)",
  "allOf": [{"$ref": "commun.schema.json#/$defs/entete"}],
  "type": "object",
  "$defs": {
    "cout": {
      "type": "object",
      "properties": {
        "brut": {"type": "string", "minLength": 1, "description": "valeur telle que publiée : montant en M€, « nc », « ε » ou « - »"},
        "meur": {"type": ["number", "null"], "description": "millions d'euros ; null pour nc, ε, - (jamais 0 à leur place)"},
        "statut": {"enum": ["constaté", "estimé"]},
        "plf": {"type": "integer", "minimum": 2020, "maximum": 2100},
        "hors_reference": {"const": true}
      },
      "required": ["brut", "meur", "statut", "plf"],
      "additionalProperties": false,
      "allOf": [
        {"if": {"properties": {"brut": {"enum": ["nc", "ε", "-"]}}}, "then": {"properties": {"meur": {"type": "null"}}}},
        {"if": {"properties": {"brut": {"pattern": "^-?[0-9]+([.,][0-9]+)?$"}}}, "then": {"properties": {"meur": {"type": "number"}}}}
      ]
    },
    "programme": {
      "type": "object",
      "properties": {
        "code": {"type": "string", "pattern": "^[0-9]{1,3}$"},
        "libelle": {"type": ["string", "null"]},
        "plf": {"type": "integer"},
        "noeud_arbre": {"type": ["string", "null"]}
      },
      "required": ["code"]
    }
  },
  "properties": {
    "unite": {"type": "string"},
    "avertissement": {"type": "string"},
    "jetons": {"type": "object", "required": ["nc", "ε", "-"]},
    "annees": {"type": "array", "items": {"$ref": "commun.schema.json#/$defs/annee"}},
    "mesures": {
      "type": "array", "minItems": 400,
      "items": {
        "type": "object",
        "properties": {
          "id": {"type": "string", "pattern": "^[0-9]{6}$"},
          "libelle": {"type": "string", "minLength": 3},
          "impot": {"type": ["string", "null"]},
          "sous_categorie": {"type": "string"},
          "editions": {"type": "array", "items": {"type": "integer"}, "minItems": 1},
          "finalite": {"type": "string"},
          "norme": {"type": "string"},
          "reference": {"type": "string"},
          "methode": {"type": "string"},
          "fiabilite": {"type": "string"},
          "programme": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/programme"}]},
          "programmes_subsidiaires": {"type": "array", "items": {"$ref": "#/$defs/programme"}},
          "beneficiaires": {
            "type": ["object", "null"],
            "properties": {"nombre": {"type": ["integer", "null"], "minimum": 0}, "nature": {"type": ["string", "null"]},
                           "brut": {"type": "string"}, "plf": {"type": "integer"}},
            "required": ["nombre", "nature"],
            "additionalProperties": false
          },
          "dates": {"type": "object", "properties": {"creation": {"type": "string"}, "modification": {"type": "string"},
                    "fin_fait_generateur": {"type": "string"}, "fin_incidence": {"type": "string"},
                    "suppression": {"type": "string"}, "plf": {"type": "integer"}}, "required": ["plf"]},
          "couts": {"type": "object", "propertyNames": {"pattern": "^20(19|2[0-6])$"},
                    "additionalProperties": {"$ref": "#/$defs/cout"}},
          "evaluation_2011": {"type": "object", "properties": {"note": {"type": ["integer", "null"], "minimum": 0, "maximum": 3},
                              "brut": {"type": "string"}, "cout_2011": {"type": ["string", "null"]}}, "required": ["note", "brut"]}
        },
        "required": ["id", "libelle", "impot", "editions", "programme", "beneficiaires", "dates", "couts"],
        "not": {"anyOf": [{"required": ["nom"]}, {"required": ["prenom"]}, {"required": ["siren"]}]}
      }
    }
  },
  "required": ["unite", "jetons", "annees", "mesures"]
}
