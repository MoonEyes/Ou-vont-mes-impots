{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ou-vont-mes-impots.fr/contrat/v1/sankey_etat.schema.json",
  "title": "site/data/sankey_etat.json : flux Etat > grand poste > mission > programme",
  "type": "object",
  "required": [
    "unite",
    "total",
    "nodes",
    "links"
  ],
  "additionalProperties": false,
  "properties": {
    "unite": {
      "const": "milliards d'euros (credits de paiement)"
    },
    "total": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "nodes": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "level"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(etat|p:.+|m:.+|g:[0-9]+)$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "level": {
            "enum": [
              0,
              1,
              2,
              3
            ]
          }
        }
      }
    },
    "links": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "source",
          "target",
          "value"
        ],
        "additionalProperties": false,
        "properties": {
          "source": {
            "type": "integer",
            "minimum": 0
          },
          "target": {
            "type": "integer",
            "minimum": 0
          },
          "value": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        }
      }
    }
  }
}
