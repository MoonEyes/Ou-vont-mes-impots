{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ou-vont-mes-impots.fr/contrat/v1/sankey_etat.schema.json",
  "title": "site/data/sankey_etat*.json : flux Etat > grand poste > mission > programme",
  "allOf": [
    {
      "$ref": "commun.schema.json#/$defs/entete"
    }
  ],
  "type": "object",
  "properties": {
    "unite": {
      "$ref": "commun.schema.json#/$defs/unite_md_cp"
    },
    "total": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "total_net_arbre": {
      "type": "number"
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(etat|p:.+|m:.+|g:[0-9]+|psr:.+)$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "level": {
            "enum": [
              0,
              1,
              2,
              3
            ]
          }
        },
        "required": [
          "id",
          "name",
          "level"
        ],
        "additionalProperties": false
      },
      "minItems": 2
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source": {
            "type": "integer",
            "minimum": 0
          },
          "target": {
            "type": "integer",
            "minimum": 0
          },
          "value": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "required": [
          "source",
          "target",
          "value"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "programmes_negatifs_hors_sankey": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "programme": {
            "type": "string"
          },
          "mission": {
            "type": "string"
          },
          "md": {
            "type": "number",
            "maximum": 0
          }
        },
        "required": [
          "programme",
          "md"
        ]
      }
    }
  },
  "required": [
    "unite",
    "total",
    "nodes",
    "links"
  ]
}
