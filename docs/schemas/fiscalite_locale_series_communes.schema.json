{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://ou-vont-mes-impots.fr/contrat/v1/fiscalite_locale_series_communes.schema.json",
 "title": "site/data/fiscalite_locale_series/communes/<dep>.json ou <dep>_<k>.json : taux votés et produits des impôts locaux par commune et par année depuis 2010 (REI, DGFiP ; pipeline/fiscalite_locale_series.py)",
 "allOf": [
  {
   "$ref": "commun.schema.json#/$defs/entete"
  }
 ],
 "type": "object",
 "required": [
  "millesime",
  "source",
  "date_sources",
  "annees",
  "unite_taux",
  "unite_produits",
  "series_taux",
  "series_produits",
  "deja_publie",
  "regle_null",
  "departement",
  "partie",
  "communes"
 ],
 "properties": {
  "date_sources": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
  },
  "annees": {
   "type": "array",
   "items": {
    "type": "string",
    "pattern": "^\\d{4}$"
   },
   "minItems": 1
  },
  "unite_taux": {
   "const": "%"
  },
  "unite_produits": {
   "const": "euros"
  },
  "series_taux": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "series_produits": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "deja_publie": {
   "type": "object",
   "required": [
    "annees",
    "fichier",
    "colonnes"
   ],
   "properties": {
    "annees": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "fichier": {
     "type": "string"
    },
    "colonnes": {
     "type": "object",
     "additionalProperties": {
      "type": "string"
     }
    }
   }
  },
  "regle_null": {
   "type": "string"
  },
  "departement": {
   "type": "string",
   "pattern": "^(\\d{2}|2[AB]|97\\d)$"
  },
  "partie": {
   "type": [
    "integer",
    "null"
   ],
   "minimum": 1,
   "description": "null : fichier unique du département ; k : partie k (codes Insee contigus)"
  },
  "communes": {
   "type": "object",
   "minProperties": 1,
   "propertyNames": {
    "pattern": "^(\\d{5}|2[AB]\\d{3})$"
   },
   "additionalProperties": {
    "type": "object",
    "required": [
     "nom"
    ],
    "additionalProperties": false,
    "properties": {
     "nom": {
      "type": "string",
      "description": "libellé de la commune dans le dernier fichier REI où elle figure"
     },
     "taux": {
      "type": "object",
      "additionalProperties": {
       "type": "array",
       "items": {
        "type": [
         "number",
         "null"
        ]
       },
       "minItems": 1,
       "description": "taux en %, aligné sur annees ; null : regle_null"
      }
     },
     "produits": {
      "type": "object",
      "additionalProperties": {
       "type": "array",
       "items": {
        "type": [
         "integer",
         "null"
        ]
       },
       "minItems": 1,
       "description": "euros, aligné sur annees ; null : regle_null"
      }
     },
     "teom_niveau": {
      "type": "array",
      "items": {
       "type": [
        "integer",
        "null"
       ],
       "minimum": 0,
       "maximum": 3
      },
      "minItems": 1,
      "description": "niveau percevant la taxe d'enlèvement des ordures ménagères (0 à 3), aligné sur annees"
     }
    }
   }
  }
 }
}
