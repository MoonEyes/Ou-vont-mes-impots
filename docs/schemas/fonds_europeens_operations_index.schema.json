{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ou-vont-mes-impots.fr/contrat/v1/fonds_europeens_operations_index.schema.json",
  "title": "site/data/fonds_europeens/operations.json : listes d'opérations des autorités de gestion, couverture, rapprochement SIRENE",
  "allOf": [
    {
      "$ref": "commun.schema.json#/$defs/entete"
    }
  ],
  "type": "object",
  "required": [
    "millesime",
    "source",
    "unite",
    "avertissement",
    "regle_personnes_physiques",
    "listes",
    "couverture",
    "rapprochement",
    "liens",
    "sources_inaccessibles",
    "ordre"
  ],
  "properties": {
    "unite": {
      "const": "euros"
    },
    "avertissement": {
      "type": "string",
      "minLength": 40
    },
    "regle_personnes_physiques": {
      "type": "string",
      "minLength": 40
    },
    "listes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "fichier",
          "autorite_de_gestion",
          "region",
          "periodes",
          "fonds",
          "operations",
          "operations_nommees",
          "cout_total_eur",
          "montant_ue_eur",
          "part_cout_nommee",
          "url",
          "licence",
          "collecte_le"
        ],
        "properties": {
          "fichier": {
            "type": "string",
            "pattern": "^fonds_europeens/operations/[a-z0-9_]+\\.json$"
          },
          "operations": {
            "type": "integer",
            "minimum": 0
          },
          "operations_nommees": {
            "type": "integer",
            "minimum": 0
          },
          "part_cout_nommee": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "couverture": {
      "type": "object",
      "required": [
        "programmes_couverts",
        "programmes_regionaux",
        "lecture"
      ]
    },
    "rapprochement": {
      "type": "object",
      "required": [
        "methode",
        "stock_sirene",
        "intitules_retires"
      ]
    },
    "liens": {
      "type": "array",
      "items": {
        "$ref": "fonds_europeens_commun.schema.json#/$defs/lien"
      }
    },
    "sources_inaccessibles": {
      "type": "array",
      "items": {
        "$ref": "fonds_europeens_commun.schema.json#/$defs/inaccessible"
      }
    },
    "ordre": {
      "$ref": "fonds_europeens_commun.schema.json#/$defs/ordre"
    }
  },
  "propertyNames": {
    "not": {
      "pattern": "(?i)pr[eé]nom|adresse|courriel|t[eé]l[eé]phone|dirigeant"
    }
  }
}
