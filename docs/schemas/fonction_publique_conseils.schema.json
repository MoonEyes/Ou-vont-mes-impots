{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ou-vont-mes-impots.fr/contrat/v1/fonction_publique_conseils.schema.json",
  "title": "site/data/fonction_publique/conseils.json : recours de l'État aux conseils extérieurs par exercice, ministère, mission, programme et prestataire personne morale (jaunes PLF)",
  "allOf": [
    {
      "$ref": "commun.schema.json#/$defs/entete"
    }
  ],
  "type": "object",
  "required": [
    "millesime",
    "source",
    "collecte_le",
    "unite",
    "perimetre",
    "regle_personnes",
    "valeurs_absentes",
    "limites",
    "totaux",
    "par_ministere",
    "par_mission",
    "par_programme",
    "controle_programmes",
    "prestataires"
  ],
  "properties": {
    "collecte_le": {
      "type": "string",
      "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}$"
    },
    "unite": {
      "type": "string",
      "minLength": 1
    },
    "perimetre": {
      "type": "string",
      "minLength": 1
    },
    "regle_personnes": {
      "type": "string",
      "minLength": 1
    },
    "valeurs_absentes": {
      "type": "string",
      "minLength": 1
    },
    "limites": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "totaux": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "exercice",
          "semestre_1_seul",
          "editions",
          "edition_retenue",
          "ae_eur",
          "cp_eur",
          "editions_concordantes"
        ],
        "additionalProperties": false,
        "properties": {
          "exercice": {
            "$ref": "commun.schema.json#/$defs/annee_entier"
          },
          "semestre_1_seul": {
            "type": "boolean"
          },
          "editions": {
            "type": "object",
            "propertyNames": {
              "pattern": "^PLF 20[0-9]{2}$"
            },
            "additionalProperties": {
              "type": "object",
              "required": [
                "ae_eur",
                "cp_eur"
              ],
              "additionalProperties": {
                "type": [
                  "number",
                  "null"
                ]
              }
            }
          },
          "edition_retenue": {
            "type": "string",
            "pattern": "^PLF 20[0-9]{2}$"
          },
          "ae_eur": {
            "type": [
              "number",
              "null"
            ]
          },
          "cp_eur": {
            "type": [
              "number",
              "null"
            ]
          },
          "editions_concordantes": {
            "type": "boolean"
          }
        }
      }
    },
    "par_ministere": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^20[0-9]{2}$"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "edition",
          "nomenclature",
          "total_ae_eur",
          "somme_des_lignes_ae_eur",
          "lignes"
        ],
        "additionalProperties": false,
        "properties": {
          "edition": {
            "type": "string",
            "pattern": "^PLF 20[0-9]{2}$"
          },
          "nomenclature": {
            "type": "string",
            "minLength": 1
          },
          "total_ae_eur": {
            "type": "number"
          },
          "somme_des_lignes_ae_eur": {
            "type": "number"
          },
          "lignes": {
            "type": "array",
            "minItems": 5,
            "items": {
              "type": "object",
              "required": [
                "ministere",
                "ae_eur"
              ],
              "additionalProperties": false,
              "properties": {
                "ministere": {
                  "type": "string",
                  "minLength": 1
                },
                "ae_eur": {
                  "type": "number"
                }
              }
            }
          }
        }
      }
    },
    "par_mission": {
      "type": "object",
      "required": [
        "edition",
        "annees",
        "total_ae_eur",
        "lignes"
      ],
      "additionalProperties": false,
      "properties": {
        "edition": {
          "type": "string"
        },
        "annees": {
          "type": "array",
          "items": {
            "$ref": "commun.schema.json#/$defs/annee_entier"
          }
        },
        "total_ae_eur": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "lignes": {
          "type": "array",
          "minItems": 5,
          "items": {
            "type": "object",
            "required": [
              "mission",
              "ae_eur"
            ],
            "additionalProperties": false,
            "properties": {
              "mission": {
                "type": "string",
                "minLength": 1
              },
              "ae_eur": {
                "type": "array",
                "items": {
                  "type": [
                    "number",
                    "null"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "par_programme": {
      "type": "array",
      "minItems": 50,
      "items": {
        "type": "object",
        "required": [
          "programme",
          "libelle",
          "exercices"
        ],
        "additionalProperties": false,
        "properties": {
          "programme": {
            "type": "string",
            "pattern": "^[0-9]{3}$"
          },
          "libelle": {
            "type": "string",
            "minLength": 1
          },
          "exercices": {
            "type": "object",
            "minProperties": 1,
            "propertyNames": {
              "pattern": "^20[0-9]{2}$"
            },
            "additionalProperties": {
              "type": "object",
              "required": [
                "ae_consommees_eur",
                "ae_ouvertes_lfi_eur",
                "part_pct",
                "edition"
              ],
              "additionalProperties": false,
              "properties": {
                "ae_consommees_eur": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "ae_ouvertes_lfi_eur": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0
                },
                "part_pct": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "edition": {
                  "type": "string",
                  "pattern": "^PLF 20[0-9]{2}$"
                },
                "edition_precedente": {
                  "type": "object",
                  "required": [
                    "edition",
                    "ae_consommees_eur"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "edition": {
                      "type": "string"
                    },
                    "ae_consommees_eur": {
                      "type": [
                        "number",
                        "null"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "controle_programmes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "total_publie_ae_eur",
          "somme_des_programmes_lus_ae_eur"
        ],
        "additionalProperties": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "prestataires": {
      "type": "object",
      "propertyNames": {
        "pattern": "^20[0-9]{2}(-20[0-9]{2})?$"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "edition",
          "periode",
          "nb_prestataires_distincts",
          "part_des_vingt_premiers_pct",
          "lignes"
        ],
        "additionalProperties": false,
        "properties": {
          "edition": {
            "type": "string"
          },
          "periode": {
            "type": [
              "string",
              "null"
            ]
          },
          "nb_prestataires_distincts": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "part_des_vingt_premiers_pct": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "lignes": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "object",
              "required": [
                "rang",
                "denomination",
                "siren",
                "categorie_juridique",
                "nb_commandes",
                "montant_meur"
              ],
              "additionalProperties": false,
              "properties": {
                "rang": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 20
                },
                "denomination": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "siren": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^[0-9]{9}$"
                },
                "categorie_juridique": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^[2-9][0-9]{3}$",
                  "not": {
                    "enum": [
                      "2110",
                      "2210",
                      "2310",
                      "2385"
                    ]
                  }
                },
                "nb_commandes": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                },
                "montant_meur": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "motif_non_nomme": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "if": {
                "properties": {
                  "denomination": {
                    "type": "string"
                  }
                }
              },
              "then": {
                "properties": {
                  "siren": {
                    "type": "string"
                  },
                  "categorie_juridique": {
                    "type": "string"
                  }
                }
              },
              "else": {
                "required": [
                  "motif_non_nomme"
                ],
                "properties": {
                  "siren": {
                    "type": "null"
                  },
                  "categorie_juridique": {
                    "type": "null"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
