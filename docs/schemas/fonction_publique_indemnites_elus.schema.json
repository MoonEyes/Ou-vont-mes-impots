{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ou-vont-mes-impots.fr/contrat/v1/fonction_publique_indemnites_elus.schema.json",
  "title": "site/data/fonction_publique/indemnites_elus.json : plafonds légaux des indemnités de fonction brutes mensuelles des élus locaux, par fonction et strate de population (DGCL), aucun élu nommé",
  "allOf": [
    {
      "$ref": "commun.schema.json#/$defs/entete"
    }
  ],
  "type": "object",
  "required": [
    "millesime",
    "source",
    "collecte_le",
    "unite",
    "definition",
    "regle_personnes",
    "limites",
    "date_valeur",
    "indice_brut_1027_mensuel_eur",
    "decret_valeur_du_point",
    "lignes",
    "rangees_ecartees"
  ],
  "properties": {
    "collecte_le": {
      "type": "string",
      "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}$"
    },
    "unite": {
      "type": "string",
      "minLength": 1
    },
    "definition": {
      "type": "string",
      "minLength": 1
    },
    "regle_personnes": {
      "type": "string",
      "minLength": 1
    },
    "limites": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "date_valeur": {
      "type": "string",
      "minLength": 1
    },
    "indice_brut_1027_mensuel_eur": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "decret_valeur_du_point": {
      "type": [
        "string",
        "null"
      ]
    },
    "lignes": {
      "type": "array",
      "minItems": 50,
      "items": {
        "type": "object",
        "required": [
          "annexe",
          "collectivite",
          "fonction",
          "strate",
          "taux_pct_ib1027",
          "indemnite_brute_mensuelle_eur",
          "base_legale"
        ],
        "additionalProperties": false,
        "properties": {
          "annexe": {
            "type": [
              "string",
              "null"
            ]
          },
          "collectivite": {
            "type": [
              "string",
              "null"
            ]
          },
          "fonction": {
            "type": "string",
            "minLength": 1
          },
          "strate": {
            "type": "string",
            "minLength": 1
          },
          "taux_pct_ib1027": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 200
          },
          "indemnite_brute_mensuelle_eur": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "base_legale": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "rangees_ecartees": {
      "type": "integer",
      "minimum": 0
    }
  }
}
