{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ou-vont-mes-impots.fr/contrat/v1/application_lois_mesures.schema.json",
  "title": "site/data/application_lois/mesures/<identifiant>.json : mesures d'application d'une loi, dans l'ordre de l'échéancier",
  "allOf": [
    {
      "$ref": "commun.schema.json#/$defs/entete"
    }
  ],
  "type": "object",
  "required": [
    "millesime",
    "source",
    "unite",
    "collecte_le",
    "loi",
    "ordre",
    "definitions",
    "etats_publies",
    "mesures"
  ],
  "properties": {
    "millesime": {
      "type": "string",
      "minLength": 10
    },
    "source": {
      "type": "string",
      "minLength": 20
    },
    "unite": {
      "type": "string",
      "minLength": 4
    },
    "collecte_le": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "loi": {
      "type": "object",
      "required": [
        "id",
        "titre",
        "date_publication",
        "mesures_a_appliquer",
        "mesures_appliquees",
        "taux_application_publie",
        "taux_note",
        "delais",
        "url_legifrance"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^JORFTEXT[0-9]{12}$"
        },
        "delais": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "mesures",
            "minimum_jours",
            "mediane_jours",
            "maximum_jours",
            "calcule_par_le_site",
            "methode"
          ],
          "properties": {
            "mesures": {
              "type": "integer",
              "minimum": 1
            },
            "minimum_jours": {
              "type": "integer",
              "minimum": 0
            },
            "mediane_jours": {
              "type": "number",
              "minimum": 0
            },
            "maximum_jours": {
              "type": "integer",
              "minimum": 0
            },
            "calcule_par_le_site": {
              "const": true
            },
            "methode": {
              "type": "string",
              "minLength": 40
            }
          }
        }
      }
    },
    "ordre": {
      "type": "object",
      "required": [
        "regle",
        "cles"
      ],
      "properties": {
        "regle": {
          "type": "string",
          "minLength": 20
        },
        "cles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "definitions": {
      "type": "object"
    },
    "etats_publies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "mesures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "numero",
          "articles",
          "base_legale",
          "objet",
          "observations",
          "etat",
          "date_prevue",
          "decret",
          "decret_url",
          "delai_jours"
        ],
        "properties": {
          "numero": {
            "type": [
              "integer",
              "null"
            ]
          },
          "articles": {
            "type": [
              "string",
              "null"
            ]
          },
          "base_legale": {
            "type": [
              "string",
              "null"
            ]
          },
          "objet": {
            "type": [
              "string",
              "null"
            ]
          },
          "observations": {
            "type": [
              "string",
              "null"
            ]
          },
          "etat": {
            "enum": [
              "appliqué",
              "en attente d'application",
              "sans objet",
              null
            ]
          },
          "date_prevue": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "decret": {
            "type": [
              "string",
              "null"
            ]
          },
          "decret_url": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^https://www\\.legifrance\\.gouv\\.fr/jorf/id/"
          },
          "delai_jours": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "textes_non_repris": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "string",
              "minLength": 10
            },
            "propertyNames": {
              "enum": [
                "objet",
                "observations",
                "base_legale"
              ]
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "etat": {
                  "const": "en attente d'application"
                }
              }
            },
            "then": {
              "properties": {
                "delai_jours": {
                  "type": "null"
                }
              }
            }
          }
        ]
      }
    }
  }
}
