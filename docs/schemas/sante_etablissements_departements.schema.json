{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ou-vont-mes-impots.fr/contrat/v1/sante_etablissements_departements.schema.json",
  "title": "site/data/sante_etablissements/departements.json : établissements, actes CCAM publiés et prix médians des EHPAD par département (pipeline/sante_etablissements.py)",
  "allOf": [
    {
      "$ref": "commun.schema.json#/$defs/entete"
    }
  ],
  "type": "object",
  "properties": {
    "millesime": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "collecte_le": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "unite": {
      "type": "string"
    },
    "note_prix": {
      "type": "string"
    },
    "note": {
      "type": "string"
    },
    "colonnes": {
      "const": [
        "etablissements",
        "hospitalier",
        "soins_prevention",
        "autres_sanitaires",
        "social_medico_social",
        "formation",
        "non_classe",
        "public",
        "prive_non_lucratif",
        "prive_commercial",
        "ehpad"
      ]
    },
    "colonnes_prix": {
      "const": [
        "ehpad_avec_prix",
        "prix_hebergement_chambre_seule_median_eur",
        "prix_hebergement_chambre_seule_aide_sociale_median_eur",
        "tarif_dependance_gir_1_2_median_eur",
        "tarif_dependance_gir_3_4_median_eur",
        "tarif_dependance_gir_5_6_median_eur"
      ]
    },
    "annees_ccam": {
      "type": "array",
      "items": {
        "$ref": "commun.schema.json#/$defs/annee_entier"
      }
    },
    "annees_prix": {
      "type": "array",
      "items": {
        "$ref": "commun.schema.json#/$defs/annee_entier"
      }
    },
    "departements": {
      "type": "object",
      "propertyNames": {
        "pattern": "^([0-9]{2}|2A|2B|9[78][0-9])$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "comptes": {
            "oneOf": [
              {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0
                },
                "minItems": 11,
                "maxItems": 11
              },
              {
                "type": "null"
              }
            ]
          },
          "actes_ccam": {
            "type": "array",
            "items": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            }
          },
          "prix_ehpad": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "integer",
                      "minimum": 0
                    }
                  ],
                  "items": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "minItems": 6,
                  "maxItems": 6
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "etablissements_nommes": {
            "type": "integer",
            "minimum": 0
          },
          "fichier": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "comptes",
          "actes_ccam",
          "prix_ehpad",
          "etablissements_nommes",
          "fichier"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "collecte_le",
    "unite",
    "note_prix",
    "note",
    "colonnes",
    "colonnes_prix",
    "annees_ccam",
    "annees_prix",
    "departements"
  ],
  "additionalProperties": false
}
