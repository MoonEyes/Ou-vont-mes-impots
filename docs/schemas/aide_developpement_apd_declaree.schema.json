    "pays": {
      "type": "array",
      "minItems": 50,
      "items": {
        "type": "object",
        "required": [
          "code",
          "nom",
          "nom_tri"
        ],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^([A-Z]{3}|R[0-9]+|NON_VENTILE)$"
          },
          "nom": {
            "type": "string",
            "minLength": 1
          },
          "nom_tri": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": [
              "pays",
              "regroupement"
            ]
          },
          "nom_source": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "par_pays": {
      "type": "object",
      "required": [
        "colonnes",
