    "par_secteur": {
      "type": "object",
      "required": [
        "colonnes",
        "lignes"
      ],
      "properties": {
        "colonnes": {
          "const": [
            "annee",
            "secteur"
          ]
        },
        "lignes": {
          "type": "array",
          "minItems": 10,
          "items": {
            "type": "array",
