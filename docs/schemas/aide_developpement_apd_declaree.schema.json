{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ou-vont-mes-impots.fr/contrat/v1/aide_developpement_apd_declaree.schema.json",
  "title": "site/data/aide_developpement/apd_declaree.json : aide publique au développement déclarée par la France au CAD de l'OCDE (DG Trésor), dons et prêts séparés",
  "allOf": [
    {
      "$ref": "commun.schema.json#/$defs/entete"
    }
  ],
  "type": "object",
  "required": [
    "millesime",
    "source",
    "unite",
    "avertissement",
    "definitions",
    "annees",
    "ordre",
    "par_annee",
    "colonnes_ventilations",
    "par_canal",
    "par_agence",
    "par_secteur",
    "pays",
    "par_pays",
    "limites",
    "sources_textes"
  ],
  "properties": {
    "millesime": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "unite": {
      "type": "string",
      "minLength": 1
    },
    "avertissement": {
      "type": "string",
      "minLength": 20,
      "pattern": "ne s'additionnent pas"
    },
    "collecte_le": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "definitions": {
      "type": "object",
      "minProperties": 4,
      "additionalProperties": {
        "type": "string"
      }
    },
    "annees": {
      "type": "array",
      "minItems": 3,
      "items": {
        "$ref": "commun.schema.json#/$defs/annee_entier"
      }
    },
    "ordre": {
      "type": "object",
      "required": [
        "cles",
        "regle"
      ],
      "properties": {
        "cles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "regle": {
          "type": "string",
          "minLength": 20
        }
      }
    },
    "par_annee": {
      "type": "object",
      "required": [
        "colonnes",
        "lignes"
      ],
      "properties": {
        "colonnes": {
          "const": [
            "annee",
            "type_de_flux",
            "type_de_financement",
            "famille",
            "engagements_eur",
            "verse_eur",
            "equivalent_don_eur",
            "percu_eur",
            "lignes"
          ]
        },
        "lignes": {
          "type": "array",
          "minItems": 10,
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "$ref": "commun.schema.json#/$defs/annee_entier"
              },
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "string",
                "minLength": 1
              },
              {
                "enum": [
                  "don",
                  "pret",
                  "autre"
                ]
              },
              {
                "type": [
                  "integer",
                  "null"
                ]
              },
              {
                "type": [
                  "integer",
                  "null"
                ]
              },
              {
                "type": [
                  "integer",
                  "null"
                ]
              },
              {
                "type": [
                  "integer",
                  "null"
                ]
              },
              {
                "type": "integer",
                "minimum": 1
              }
            ],
            "items": false,
            "minItems": 9
          }
        }
      }
    },
    "perimetre_ventilations": {
      "type": "string",
      "minLength": 20
    },
    "colonnes_ventilations": {
      "const": [
        "dons_verses_eur",
        "prets_verses_eur",
        "autres_verses_eur",
        "equivalent_don_eur",
        "percu_eur"
      ]
    },
    "par_canal": {
      "type": "object",
      "required": [
        "colonnes",
        "lignes"
      ],
      "properties": {
        "colonnes": {
          "const": [
            "annee",
            "canal"
