{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ou-vont-mes-impots.fr/contrat/v1/formation_cpf_organismes.schema.json",
  "title": "site/data/formation/cpf_organismes.json : CPF, entrées en formation par organisme (personnes morales nommées, autres agrégés), montant approché",
  "allOf": [
    {
      "$ref": "commun.schema.json#/$defs/entete"
    }
  ],
  "type": "object",
  "properties": {
    "millesime": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "pattern": "Caisse des dépôts.*Sirene"
    },
    "unite": {
      "type": "string"
    },
    "collecte_le": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "avertissement": {
      "type": "string",
      "minLength": 40
    },
    "estimation": {
      "type": "object",
      "required": [
        "statut",
        "producteur",
        "perimetre",
        "methode",
        "limites"
      ],
      "properties": {
        "statut": {
          "const": "approché"
        },
        "methode": {
          "type": "string",
          "minLength": 80
        },
        "limites": {
          "type": "array",
          "minItems": 3
        }
      }
    },
    "regle_personnes": {
      "type": "string",
      "minLength": 80
    },
    "ordre": {
      "type": "object",
      "required": [
        "regle",
        "cles"
      ],
      "properties": {
        "regle": {
          "type": "string",
          "minLength": 20
        },
        "cles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "colonnes": {
      "const": [
        "entrees",
        "sorties_totales",
        "sorties_partielles",
        "montant_approche_eur"
      ]
    },
    "colonnes_agreges": {
      "const": [
        "entrees",
        "sorties_totales",
        "sorties_partielles",
        "montant_approche_eur",
        "organismes"
      ]
    },
    "annees": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^20[0-9]{2}$"
      }
    },
    "totaux": {
      "type": "object",
      "propertyNames": {
        "pattern": "^20[0-9]{2}$"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "entrees",
          "sorties_totales",
          "sorties_partielles",
          "montant_approche_eur",
          "organismes",
          "entrees_nommees",
          "entrees_nommees_pct",
          "entrees_par_niveau_de_prix",
          "controle_estimation"
        ]
      }
    },
    "organismes": {
      "type": "array",
      "maxItems": 1500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "siren",
          "nom",
          "categorie_juridique",
          "etablissements",
          "entrees_cumulees",
          "annees"
        ],
        "properties": {
          "siren": {
            "$ref": "commun.schema.json#/$defs/siren"
          },
          "nom": {
            "type": "string",
            "minLength": 1
          },
          "categorie_juridique": {
            "$ref": "commun.schema.json#/$defs/categorie_personne_morale"
          },
          "etablissements": {
            "type": "integer",
            "minimum": 1
          },
          "entrees_cumulees": {
            "type": "integer",
            "minimum": 0
          },
          "annees": {
            "type": "object",
            "propertyNames": {
              "pattern": "^20[0-9]{2}$"
            },
            "additionalProperties": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "agreges": {
      "type": "object",
      "required": [
        "personnes_morales_non_listees",
        "entrepreneurs_individuels_et_groupements_de_personnes",
        "absents_du_repertoire_sirene",
        "categorie_juridique_non_verifiee"
      ],
      "additionalProperties": {
        "type": "object",
        "required": [
          "organismes",
          "annees"
        ],
        "properties": {
          "organismes": {
            "type": [
              "integer",
              "null"
            ]
          },
          "annees": {
            "type": "object",
            "propertyNames": {
              "pattern": "^20[0-9]{2}$"
            },
            "additionalProperties": {
              "type": "array",
              "minItems": 5,
              "maxItems": 5,
              "items": {
                "type": [
                  "integer",
                  "null"
                ]
              }
            }
          }
        }
      }
    }
  },
  "required": [
    "millesime",
    "source",
    "unite",
    "collecte_le",
    "avertissement",
    "estimation",
    "regle_personnes",
    "ordre",
    "colonnes",
    "colonnes_agreges",
    "annees",
    "totaux",
    "organismes",
    "agreges"
  ]
}
