{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ou-vont-mes-impots.fr/contrat/v1/fraicheur_index.schema.json",
  "title": "site/data/fraicheur/index.json : fraîcheur de chaque source lue par le site",
  "description": "Écrit par pipeline/fraicheur.py (étape « fraicheur » de pipeline/tout.py, avant le datapackage). Pour chaque source : date de dernière collecte, millésime publié, date de publication déclarée par la source, prochaine publication attendue (calendrier officiel, sinon null), statut et explication. Une date inconnue est null, jamais inventée.",
  "type": "object",
  "allOf": [
    {
      "$ref": "commun.schema.json#/$defs/entete"
    }
  ],
  "$defs": {
    "jour": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "jour_ou_null": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "statut": {
      "enum": [
        "a_jour",
        "en_retard",
        "inaccessible",
        "non_verifiee"
      ]
    },
    "par_statut": {
      "type": "object",
      "required": [
        "a_jour",
        "en_retard",
        "inaccessible",
        "non_verifiee"
      ],
      "additionalProperties": false,
      "properties": {
        "a_jour": {
          "type": "integer",
          "minimum": 0
        },
        "en_retard": {
          "type": "integer",
          "minimum": 0
        },
        "inaccessible": {
          "type": "integer",
          "minimum": 0
        },
        "non_verifiee": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "required": [
    "millesime",
    "source",
    "date_reference",
    "rapport_passage",
    "mise_a_jour_hebdomadaire",
    "statuts",
    "calendriers",
    "comptes",
    "total",
    "etapes",
    "sources",
    "non_collectables",
    "ordre",
    "limites",
    "recherche_prealable"
  ],
  "properties": {
    "date_reference": {
      "$ref": "#/$defs/jour"
    },
    "date_reference_definition": {
      "type": "string"
    },
    "rapport_passage": {
      "type": "object",
      "required": [
        "fichier",
        "genere_le"
      ],
      "properties": {
        "fichier": {
          "const": "mise_a_jour.json"
        },
        "genere_le": {
          "type": [
            "string",
            "null"
          ]
        },
        "mode": {
          "type": [
            "string",
            "null"
          ]
        },
        "note": {
          "type": "string"
        }
      }
    },
    "mise_a_jour_hebdomadaire": {
      "type": "object",
      "required": [
        "fichier",
        "cron",
        "jour",
        "heure_utc",
        "relecture_mensuelle",
        "etapes"
      ],
      "properties": {
        "fichier": {
          "type": "string"
        },
        "cron": {
          "type": [
            "string",
            "null"
          ]
        },
        "jour": {
          "type": [
            "string",
            "null"
          ]
        },
        "heure_utc": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\d{2}:\\d{2}$"
        },
        "relecture_mensuelle": {
          "type": "boolean"
        },
        "budget_s": {
          "type": [
            "integer",
            "null"
          ]
        },
        "etapes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "etape",
              "titre",
              "libelle"
            ],
            "properties": {
              "etape": {
                "type": "string",
                "pattern": "^[a-z_0-9]+$"
              },
              "titre": {
                "type": "string"
              },
              "libelle": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "statuts": {
      "type": "object",
      "required": [
        "a_jour",
        "en_retard",
        "inaccessible",
        "non_verifiee"
      ],
      "additionalProperties": {
        "type": "object",
        "required": [
          "libelle",
          "definition"
        ],
        "properties": {
          "libelle": {
            "type": "string",
            "minLength": 1
          },
          "definition": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "calendriers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "libelle",
          "regle",
          "reference",
          "url",
          "familles"
        ],
        "properties": {
          "id": {
            "enum": [
              "plf",
              "plrg",
              "placss",
              "pde"
            ]
          },
          "libelle": {
            "type": "string"
          },
          "regle": {
            "type": "string"
          },
          "reference": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "pattern": "^https://"
          },
          "familles": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "famille",
                "libelle",
                "derniere_edition"
              ],
              "properties": {
                "famille": {
                  "type": "string"
                },
                "libelle": {
                  "type": "string"
                },
                "derniere_edition": {
                  "type": [
                    "integer",
                    "null"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "comptes": {
      "$ref": "#/$defs/par_statut"
    },
    "total": {
      "type": "integer",
      "minimum": 0
    },
    "etapes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "etape",
          "titre",
          "libelle",
          "sorties",
          "statut_passage",
          "statut_passage_le",
          "statut_passage_origine",
          "millesime",
          "fichier_millesime",
          "sources",
          "par_statut",
          "derniere_collecte",
          "sources_inaccessibles_passage",
          "signalements"
        ],
        "properties": {
          "etape": {
            "type": "string",
            "pattern": "^[a-z_0-9]+$"
          },
          "titre": {
            "type": "string"
          },
          "libelle": {
            "type": "string",
            "minLength": 1
          },
          "sorties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "statut_passage": {
            "enum": [
              "produit",
              "partiel",
              "conserve",
              "echec",
              "reporte",
              null
            ]
          },
          "statut_passage_le": {
            "$ref": "#/$defs/jour_ou_null"
          },
          "statut_passage_origine": {
            "enum": [
              "rapport",
              "passage_en_cours",
              null
            ]
          },
          "millesime": {
            "type": [
              "string",
              "null"
            ]
          },
          "fichier_millesime": {
            "type": [
              "string",
              "null"
            ]
          },
          "sources": {
            "type": "integer",
            "minimum": 0
          },
          "sources_principales": {
            "type": "integer",
            "minimum": 0
          },
          "par_statut": {
            "$ref": "#/$defs/par_statut"
          },
          "derniere_collecte": {
            "$ref": "#/$defs/jour_ou_null"
          },
          "premiere_collecte": {
            "$ref": "#/$defs/jour_ou_null"
          },
          "sources_inaccessibles_passage": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "signalements": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "source",
                "constat",
                "fichier"
              ],
              "properties": {
                "source": {
                  "type": "string"
                },
                "constat": {
                  "type": "string"
                },
                "fichier": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "titre",
          "producteur",
          "url",
          "origine",
          "etapes",
          "derniere_collecte",
          "derniere_verification",
          "collecte_origine",
          "statut_collecte",
          "millesime_publie",
          "millesime_origine",
          "fichier_millesime",
          "publication_source",
          "famille",
          "edition",
          "prochaine_publication",
          "statut",
          "explication"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "titre": {
            "type": "string",
            "minLength": 1
          },
          "producteur": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^https?://"
          },
          "origine": {
            "enum": [
              "sources.json",
              "catalogue",
              "lue_par_une_etape",
              "module"
            ]
          },
          "etapes": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z_0-9]+$"
            }
          },
          "derniere_collecte": {
            "$ref": "#/$defs/jour_ou_null"
          },
          "derniere_verification": {
            "$ref": "#/$defs/jour_ou_null"
          },
          "collecte_origine": {
            "enum": [
              "manifeste",
              "verification",
              "page",
              null
            ]
          },
          "statut_collecte": {
            "enum": [
              "ok",
              "partiel",
              "erreur",
              "delai_depasse",
              "sans_ressource",
              "lourd_ignore",
              null
            ]
          },
          "millesime_publie": {
            "type": [
              "string",
              "null"
            ]
          },
          "millesime_origine": {
            "enum": [
              "source",
              "page",
              null
            ]
          },
          "fichier_millesime": {
            "type": [
              "string",
              "null"
            ]
          },
          "publication_source": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "required": [
                  "date",
                  "nature"
                ],
                "additionalProperties": false,
                "properties": {
                  "date": {
                    "$ref": "#/$defs/jour"
                  },
                  "nature": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            ]
          },
          "famille": {
            "type": [
              "string",
              "null"
            ]
          },
          "edition": {
            "type": [
              "integer",
              "null"
            ]
          },
          "prochaine_publication": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "required": [
                  "date",
                  "edition",
                  "calendrier",
                  "passee"
                ],
                "additionalProperties": false,
                "properties": {
                  "date": {
                    "$ref": "#/$defs/jour"
                  },
                  "edition": {
                    "type": "string",
                    "minLength": 1
                  },
                  "calendrier": {
                    "enum": [
                      "plf",
                      "plrg",
                      "placss",
                      "pde"
                    ]
                  },
                  "passee": {
                    "type": "boolean"
                  }
                }
              }
            ]
          },
          "statut": {
            "$ref": "#/$defs/statut"
          },
          "explication": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "non_collectables": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source",
          "motif"
        ],
        "properties": {
          "source": {
            "type": "string"
          },
          "motif": {
            "type": "string"
          }
        }
      }
    },
    "ordre": {
      "type": "object",
      "required": [
        "cles",
        "regle"
      ]
    },
    "limites": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "recherche_prealable": {
      "type": "object",
      "required": [
        "date",
        "conclusion",
        "trouvailles"
      ],
      "properties": {
        "trouvailles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "nom",
              "url",
              "licence",
              "dernier_commit",
              "verdict"
            ]
          }
        }
      }
    }
  }
}
