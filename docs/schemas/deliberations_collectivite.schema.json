{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://ou-vont-mes-impots.fr/contrat/v1/deliberations_collectivite.schema.json",
 "title": "site/data/deliberations/collectivites/<siren>.json : délibérations publiées par une collectivité (métadonnées : date, matière, objet filtré, lien), comptes et exclusions (pipeline/deliberations.py)",
 "allOf": [
  {
   "$ref": "commun.schema.json#/$defs/entete"
  }
 ],
 "type": "object",
 "required": [
  "millesime",
  "source",
  "siren",
  "nom",
  "type",
  "jeux",
  "matieres",
  "comptes",
  "exclus",
  "motifs",
  "colonnes_recentes",
  "recentes",
  "regle",
  "sans_date"
 ],
 "properties": {
  "siren": {
   "type": "string",
   "pattern": "^\\d{9}$"
  },
  "nom": {
   "type": "string"
  },
  "type": {
   "type": [
    "string",
    "null"
   ],
   "enum": [
    "commune",
    "epci",
    "departement",
    "region",
    "collectivite_territoriale",
    "autre_public",
    null
   ]
  },
  "code": {
   "type": [
    "string",
    "null"
   ]
  },
  "jeux": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "id",
     "titre",
     "url",
     "licence"
    ]
   }
  },
  "matieres": {
   "type": "object",
   "propertyNames": {
    "pattern": "^[0-9]$"
   },
   "additionalProperties": {
    "type": "string"
   }
  },
  "comptes": {
   "type": "object",
   "propertyNames": {
    "pattern": "^\\d{4}$"
   },
   "additionalProperties": {
    "type": "object",
    "additionalProperties": {
     "type": "integer",
     "minimum": 0
    }
   }
  },
  "exclus": {
   "type": "object",
   "propertyNames": {
    "pattern": "^\\d{4}$"
   },
   "additionalProperties": {
    "type": "object",
    "additionalProperties": {
     "type": "integer",
     "minimum": 0
    }
   }
  },
  "motifs": {
   "type": "object",
   "additionalProperties": {
    "type": "string"
   }
  },
  "colonnes_recentes": {
   "const": [
    "date",
    "matiere",
    "objet",
    "lien",
    "jeu"
   ]
  },
  "par_matiere": {
   "type": "integer",
   "minimum": 0
  },
  "regle": {
   "type": "string"
  },
  "recentes": {
   "type": "object",
   "propertyNames": {
    "pattern": "^[0-9]$"
   },
   "additionalProperties": {
    "type": "array",
    "items": {
     "type": "array",
     "prefixItems": [
      {
       "type": "string",
       "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      },
      {
       "type": [
        "string",
        "null"
       ]
      },
      {
       "type": "string",
       "minLength": 1,
       "maxLength": 140
      },
      {
       "type": [
        "string",
        "null"
       ],
       "pattern": "^https?://"
      },
      {
       "type": "integer",
       "minimum": 0
      }
     ],
     "minItems": 5,
     "maxItems": 5
    }
   }
  },
  "sans_date": {
   "type": "object",
   "propertyNames": {
    "pattern": "^[0-9]$"
   },
   "additionalProperties": {
    "type": "integer",
    "minimum": 0
   }
  }
 },
 "not": {
  "anyOf": [
   {
    "required": [
     "votes"
    ]
   },
   {
    "required": [
     "texte"
    ]
   }
  ]
 }
}
