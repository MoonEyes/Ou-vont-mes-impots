{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://ou-vont-mes-impots.fr/contrat/v1/deliberations_budgets.schema.json",
 "title": "site/data/deliberations/budgets.json : documents budgétaires publiés au format national « Budget », par collectivité (pipeline/deliberations.py)",
 "allOf": [
  {
   "$ref": "commun.schema.json#/$defs/entete"
  }
 ],
 "type": "object",
 "required": [
  "millesime",
  "source",
  "presentation",
  "colonnes_documents",
  "etapes",
  "jeux",
  "couverture",
  "collectivites"
 ],
 "properties": {
  "presentation": {
   "type": "string"
  },
  "colonnes_documents": {
   "const": [
    "annee",
    "etape",
    "jeu"
   ]
  },
  "etapes": {
   "type": "object",
   "additionalProperties": {
    "type": "string"
   }
  },
  "jeux": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "titre",
     "url",
     "licence"
    ]
   }
  },
  "couverture": {
   "type": "object",
   "additionalProperties": {
    "type": "integer",
    "minimum": 0
   }
  },
  "collectivites": {
   "type": "object",
   "propertyNames": {
    "pattern": "^\\d{9}$"
   },
   "additionalProperties": {
    "type": "object",
    "required": [
     "nom",
     "type",
     "documents"
    ],
    "properties": {
     "nom": {
      "type": [
       "string",
       "null"
      ]
     },
     "type": {
      "type": [
       "string",
       "null"
      ],
      "enum": [
       "commune",
       "epci",
       "departement",
       "region",
       "collectivite_territoriale",
       "autre_public",
       null
      ]
     },
     "documents": {
      "type": "array",
      "items": {
       "type": "array",
       "prefixItems": [
        {
         "type": "string",
         "pattern": "^\\d{4}$"
        },
        {
         "type": "string"
        },
        {
         "type": "integer",
         "minimum": 0
        }
       ],
       "minItems": 3,
       "maxItems": 3
      }
     }
    }
   }
  }
 }
}
