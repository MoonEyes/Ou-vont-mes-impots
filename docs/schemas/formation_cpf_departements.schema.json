{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ou-vont-mes-impots.fr/contrat/v1/formation_cpf_departements.schema.json",
  "title": "site/data/formation/cpf_departements.json : CPF par année et département du lieu de formation, par modalité",
  "allOf": [
    {
      "$ref": "commun.schema.json#/$defs/entete"
    }
  ],
  "type": "object",
  "properties": {
    "millesime": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "pattern": "Caisse des dépôts"
    },
    "unite": {
      "type": "string"
    },
    "collecte_le": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "avertissement": {
      "type": "string",
      "minLength": 40
    },
    "colonnes": {
      "const": [
        "dossiers",
        "montant_eur",
        "france_competences_eur",
        "titulaire_eur",
        "autres_financeurs_eur",
        "dossiers_annules",
        "montant_annule_eur"
      ]
    },
    "departements": {
      "type": "object",
      "propertyNames": {
        "pattern": "^20[0-9]{2}$"
      },
      "additionalProperties": {
        "type": "object",
        "minProperties": 95,
        "propertyNames": {
          "pattern": "^([0-9]{2}|2[AB]|97[0-9])$"
        },
        "additionalProperties": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "lieu_non_communique": {
      "type": "object",
      "propertyNames": {
        "pattern": "^20[0-9]{2}$"
      },
      "additionalProperties": {
        "type": "array",
        "minItems": 7,
        "maxItems": 7,
        "items": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "modalites": {
      "type": "object",
      "required": [
        "colonnes",
        "annees"
      ],
      "properties": {
        "annees": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "note": {
      "type": "string"
    }
  },
  "required": [
    "millesime",
    "source",
    "unite",
    "collecte_le",
    "avertissement",
    "colonnes",
    "departements",
    "lieu_non_communique",
    "modalites"
  ]
}
