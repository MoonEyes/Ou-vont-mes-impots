{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ou-vont-mes-impots.fr/contrat/v1/subventions_index.schema.json",
  "title": "site/data/subventions/index.json : sources de subventions, totaux, part nommée et agrégée, recouvrements, recherche préalable (pipeline/subventions.py)",
  "allOf": [
    {
      "$ref": "commun.schema.json#/$defs/entete"
    }
  ],
  "type": "object",
  "properties": {
    "millesime": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "unite": {
      "const": "euros"
    },
    "collecte_le": {
      "type": "string",
      "format": "date"
    },
    "regle_personnes": {
      "type": "string",
      "minLength": 1
    },
    "regle_titres": {
      "type": "string",
      "minLength": 1
    },
    "note": {
      "type": "string",
      "minLength": 1
    },
    "limites": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "totaux": {
      "type": "object",
      "properties": {
        "total_additionne_eur": {
          "type": "number"
        },
        "nommes_additionnes": {
          "type": "object",
          "properties": {
            "nombre": {
              "type": "integer",
              "minimum": 0
            },
            "montant_eur": {
              "type": "number"
            }
          },
          "required": [
            "nombre",
            "montant_eur"
          ],
          "additionalProperties": false
        },
        "agrege_confidentialite": {
          "type": "object",
          "properties": {
            "montant_eur": {
              "type": "number"
            },
            "part_pct": {
              "type": [
                "number",
                "null"
              ]
            }
          },
          "required": [
            "montant_eur",
            "part_pct"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "total_additionne_eur",
        "nommes_additionnes",
        "agrege_confidentialite"
      ],
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^subv_[a-z0-9_]+$"
          },
          "titre": {
            "type": "string",
            "minLength": 1
          },
          "attribuant": {
            "type": "string",
            "minLength": 1
          },
          "producteur": {
            "type": "string",
            "minLength": 1
          },
          "page": {
            "type": "string",
            "pattern": "^https://"
          },
          "licence": {
            "type": "string",
            "minLength": 1
          },
          "millesime": {
            "type": "string",
            "minLength": 1
          },
          "rattachement": {
            "type": "object",
            "properties": {
              "type": {
                "enum": [
                  "programme_source",
                  "programme_dispositif",
                  "operateur",
                  "hors_budget_etat"
                ]
              },
              "programmes": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[0-9]{3}$"
                }
              },
              "colonne": {
                "type": "string"
              },
              "operateur": {
                "type": "string"
              },
              "siren": {
                "type": "string",
                "pattern": "^[0-9]{9}$"
              },
              "programme_chef_de_file": {
                "type": "string",
                "pattern": "^[0-9]{3}$"
              },
              "fichier": {
                "type": "string",
                "pattern": "^operateurs/.+\\.json$"
              },
              "id": {
                "type": "string"
              },
              "note": {
                "type": "string"
              }
            },
            "required": [
              "type"
            ],
            "additionalProperties": false
          },
          "additionne": {
            "type": "boolean"
          },
          "inclus_dans": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^subv_[a-z0-9_]+$"
              },
              {
                "type": "null"
              }
            ]
          },
          "annees": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "conventions": {
            "type": "integer",
            "minimum": 0
          },
          "lignes_montant_non_communique": {
            "type": "integer",
            "minimum": 0
          },
          "total_eur": {
            "type": "number"
          },
          "montant_retire_des_totaux_eur": {
            "type": "number"
          },
          "nommes": {
            "type": "object",
            "properties": {
              "nombre": {
                "type": "integer",
                "minimum": 0
              },
              "montant_eur": {
                "type": "number"
              }
            },
            "required": [
              "nombre",
              "montant_eur"
            ],
            "additionalProperties": false
          },
          "agrege_confidentialite": {
            "type": "object",
            "properties": {
              "montant_eur": {
                "type": "number"
              },
              "part_pct": {
                "type": [
                  "number",
                  "null"
                ]
              }
            },
            "required": [
              "montant_eur",
              "part_pct"
            ],
            "additionalProperties": false
          },
          "fichier": {
            "type": "string",
            "pattern": "^subventions/attribuants/subv_[a-z0-9_]+\\.json$"
          }
        },
        "required": [
          "id",
          "titre",
          "attribuant",
          "producteur",
          "page",
          "licence",
          "millesime",
          "rattachement",
          "additionne",
          "annees",
          "conventions",
          "lignes_montant_non_communique",
          "total_eur",
          "nommes",
          "agrege_confidentialite",
          "fichier"
        ],
        "additionalProperties": false
      }
    },
    "recouvrements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string",
            "pattern": "^subv_[a-z0-9_]+$"
          },
          "autre_source": {
            "type": "string",
            "pattern": "^subv_[a-z0-9_]+$"
          },
          "lecture": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "source",
          "autre_source",
          "lecture"
        ],
        "additionalProperties": false
      }
    },
    "sources_inaccessibles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string",
            "pattern": "^subv_[a-z0-9_]+$"
          },
          "motif": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "source",
          "motif"
        ],
        "additionalProperties": false
      }
    },
    "fichiers": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^subventions/.+\\.json$"
      }
    },
    "recherche_publique": {
      "type": "object",
      "properties": {
        "date": {
          "type": "string",
          "format": "date"
        },
        "trouvailles": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "nom": {
                "type": "string",
                "minLength": 1
              },
              "url": {
                "type": "string",
                "minLength": 1
              },
              "depot": {
                "type": "string",
                "minLength": 1
              },
              "licence": {
                "type": "string",
                "minLength": 1
              },
              "derniere_mise_a_jour": {
                "type": "string",
                "minLength": 1
              },
              "verdict": {
                "enum": [
                  "réutilisable tel quel",
                  "à adapter",
                  "inspiration seulement"
                ]
              },
              "usage": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "nom",
              "url",
              "licence",
              "derniere_mise_a_jour",
              "verdict",
              "usage"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "date",
        "trouvailles"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "millesime",
    "source",
    "unite",
    "collecte_le",
    "regle_personnes",
    "totaux",
    "sources",
    "recouvrements",
    "sources_inaccessibles",
    "fichiers",
    "recherche_publique",
    "limites"
  ],
  "additionalProperties": false
}
