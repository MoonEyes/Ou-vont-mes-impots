{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://ou-vont-mes-impots.fr/contrat/v1/deliberations_index.schema.json",
 "title": "site/data/deliberations/index.json : couverture des délibérations publiées au format national, jeux lus, règles (pipeline/deliberations.py)",
 "allOf": [
  {
   "$ref": "commun.schema.json#/$defs/entete"
  }
 ],
 "type": "object",
 "required": [
  "millesime",
  "source",
  "date_releve",
  "presentation",
  "absence",
  "absence_detail",
  "couverture",
  "methode",
  "statut_couverture",
  "regle",
  "motifs",
  "exclus",
  "matieres",
  "jeux",
  "collectivites",
  "sans_fichier"
 ],
 "properties": {
  "date_releve": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
  },
  "presentation": {
   "type": "string"
  },
  "absence": {
   "const": "ne publie pas ses délibérations en données ouvertes"
  },
  "absence_detail": {
   "type": "string"
  },
  "methode": {
   "type": "string"
  },
  "regle": {
   "type": "string"
  },
  "statut_couverture": {
   "const": "calculé par le site"
  },
  "couverture": {
   "type": "object",
   "additionalProperties": {
    "type": "object",
    "required": [
     "publient",
     "total",
     "libelle",
     "part_nombre"
    ],
    "properties": {
     "publient": {
      "type": "integer",
      "minimum": 0
     },
     "total": {
      "type": [
       "integer",
       "null"
      ]
     },
     "libelle": {
      "type": "string"
     },
     "part_nombre": {
      "type": [
       "number",
       "null"
      ],
      "minimum": 0,
      "maximum": 1
     },
     "part_population": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
     },
     "population_couverte": {
      "type": "integer",
      "minimum": 0
     },
     "population_totale": {
      "type": "integer",
      "minimum": 0
     }
    }
   }
  },
  "motifs": {
   "type": "object",
   "additionalProperties": {
    "type": "string"
   }
  },
  "exclus": {
   "type": "object",
   "additionalProperties": {
    "type": "integer",
    "minimum": 0
   }
  },
  "matieres": {
   "type": "object",
   "additionalProperties": {
    "type": "string"
   }
  },
  "colonnes_recentes": {
   "const": [
    "date",
    "matiere",
    "objet",
    "lien",
    "jeu"
   ]
  },
  "jeux": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "titre",
     "url",
     "licence",
     "lues",
     "lignes"
    ],
    "properties": {
     "id": {
      "type": "string"
     },
     "titre": {
      "type": "string"
     },
     "url": {
      "type": "string",
      "pattern": "^https://"
     },
     "licence": {
      "type": "string"
     },
     "lues": {
      "type": "integer",
      "minimum": 0
     },
     "lignes": {
      "type": "integer",
      "minimum": 0
     }
    }
   }
  },
  "lignes_lues": {
   "type": "integer",
   "minimum": 0
  },
  "collectivites": {
   "type": "object",
   "propertyNames": {
    "pattern": "^\\d{9}$"
   },
   "additionalProperties": {
    "type": "object",
    "required": [
     "nom",
     "type",
     "total",
     "annees"
    ],
    "properties": {
     "nom": {
      "type": "string"
     },
     "type": {
      "type": [
       "string",
       "null"
      ],
      "enum": [
       "commune",
       "epci",
       "departement",
       "region",
       "collectivite_territoriale",
       "autre_public",
       null
      ]
     },
     "code": {
      "type": [
       "string",
       "null"
      ]
     },
     "total": {
      "type": "integer",
      "minimum": 0
     },
     "annees": {
      "type": "array",
      "items": {
       "type": "string",
       "pattern": "^\\d{4}$"
      }
     }
    }
   }
  },
  "recherche_publique": {
   "type": "object"
  },
  "sans_fichier": {
   "type": "object",
   "additionalProperties": {
    "type": "integer",
    "minimum": 0
   }
  },
  "sans_fichier_note": {
   "type": "string"
  }
 }
}
