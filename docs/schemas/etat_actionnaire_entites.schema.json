{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ou-vont-mes-impots.fr/contrat/v1/etat_actionnaire_entites.schema.json",
  "title": "site/data/etat_actionnaire/entites.json : dividendes par ligne d'exécution et par entité (personnes morales seulement), opérations de 2025 citées par le Sénat",
  "allOf": [
    {
      "$ref": "commun.schema.json#/$defs/entete"
    }
  ],
  "type": "object",
  "properties": {
    "millesime": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "unite": {
      "type": "string"
    },
    "avertissement": {
      "type": "string",
      "minLength": 20
    },
    "collecte_le": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "regle_personnes": {
      "type": "string",
      "minLength": 20
    },
    "ordre": {
      "type": "object",
      "required": [
        "regle",
        "cles"
      ],
      "properties": {
        "regle": {
          "type": "string",
          "minLength": 10
        },
        "cles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "annees": {
      "type": "array",
      "items": {
        "type": "integer"
      }
    },
    "dividendes_par_ligne_d_execution": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "ligne",
          "code_execution",
          "libelle_source",
          "categorie_source",
          "entite",
          "execution_eur"
        ],
        "properties": {
          "ligne": {
            "enum": [
              "2110",
              "2116",
              "2199"
            ]
          },
          "code_execution": {
            "type": "string",
            "pattern": "^21[0-9]{4}$"
          },
          "libelle_source": {
            "type": "string",
            "minLength": 3
          },
          "categorie_source": {
            "enum": [
              "Entités contrôlées",
              "Entités non contrôlées",
              null
            ]
          },
          "entite": {
            "oneOf": [
              {
                "type": "object",
                "required": [
                  "siren",
                  "denomination",
                  "categorie_juridique"
                ],
                "additionalProperties": false,
                "properties": {
                  "siren": {
                    "$ref": "commun.schema.json#/$defs/siren"
                  },
                  "denomination": {
                    "type": "string",
                    "minLength": 1
                  },
                  "categorie_juridique": {
                    "$ref": "commun.schema.json#/$defs/categorie_personne_morale"
                  }
                },
                "propertyNames": {
                  "not": {
                    "pattern": "(?i)pr[eé]nom"
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "execution_eur": {
            "type": "object",
            "propertyNames": {
              "pattern": "^20[0-9]{2}$"
            },
            "additionalProperties": {
              "type": [
                "number",
                "null"
              ]
            }
          },
          "note": {
            "type": "string"
          }
        },
        "propertyNames": {
          "not": {
            "pattern": "(?i)pr[eé]nom"
          }
        }
      }
    },
    "non_verifiees": {
      "type": "object",
      "required": [
        "nombre",
        "execution_eur"
      ],
      "properties": {
        "nombre": {
          "type": "integer",
          "minimum": 0
        },
        "execution_eur": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        }
      }
    },
    "operations_citees": {
      "type": "object",
      "required": [
        "source",
        "url",
        "note",
        "operations",
        "non_nommees"
      ],
      "properties": {
        "non_nommees": {
          "type": "integer",
          "minimum": 0
        },
        "operations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "annee",
              "entite",
              "mentions"
            ],
            "properties": {
              "annee": {
                "type": "integer"
              },
              "entite": {
                "type": "object",
                "required": [
                  "siren",
                  "denomination",
                  "categorie_juridique"
                ],
                "additionalProperties": false,
                "properties": {
                  "siren": {
                    "$ref": "commun.schema.json#/$defs/siren"
                  },
                  "denomination": {
                    "type": "string",
                    "minLength": 1
                  },
                  "categorie_juridique": {
                    "$ref": "commun.schema.json#/$defs/categorie_personne_morale"
                  }
                },
                "propertyNames": {
                  "not": {
                    "pattern": "(?i)pr[eé]nom"
                  }
                }
              },
              "mentions": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "nature",
                    "montant_eur",
                    "citation",
                    "page"
                  ],
                  "properties": {
                    "montant_eur": {
                      "type": "number"
                    },
                    "citation": {
                      "type": "string",
                      "minLength": 10
                    },
                    "page": {
                      "type": "integer",
                      "minimum": 1
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "required": [
    "millesime",
    "source",
    "unite",
    "avertissement",
    "collecte_le",
    "regle_personnes",
    "ordre",
    "annees",
    "dividendes_par_ligne_d_execution",
    "non_verifiees",
    "operations_citees"
  ]
}
