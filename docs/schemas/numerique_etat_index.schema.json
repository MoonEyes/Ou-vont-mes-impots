{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ou-vont-mes-impots.fr/contrat/v1/numerique_etat_index.schema.json",
  "title": "site/data/numerique_etat/index.json : sources, synthèse du panorama des grands projets numériques, fonds de transformation numérique, liens vers l'arbre État, recherche publique",
  "allOf": [
    {
      "$ref": "commun.schema.json#/$defs/entete"
    }
  ],
  "type": "object",
  "properties": {
    "millesime": {
      "type": "string",
      "minLength": 4
    },
    "source": {
      "type": "string",
      "minLength": 10
    },
    "unite": {
      "type": "string",
      "minLength": 4
    },
    "collecte_le": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "avertissement": {
      "type": "string",
      "minLength": 40
    },
    "sources": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": [
          "id",
          "titre",
          "producteur",
          "licence",
          "url",
          "fichiers",
          "ressource_modifiee_le",
          "collecte_le"
        ],
        "properties": {
          "url": {
            "type": "string",
            "pattern": "^https://www\\.data\\.gouv\\.fr/"
          },
          "licence": {
            "const": "Licence Ouverte 2.0"
          }
        }
      }
    },
    "panorama": {
      "type": "object",
      "required": [
        "fichiers",
        "editions",
        "premiere_edition",
        "derniere_edition",
        "projets",
        "projets_dans_la_derniere_edition",
        "cout_publie_derniere_edition_meur",
        "projets_avec_au_moins_deux_couts_publies",
        "rapprochements_appliques",
        "changements_de_nom_non_rapproches",
        "programmes_cites",
        "programmes_cites_dans_arbre"
      ],
      "properties": {
        "fichiers": {
          "type": "object",
          "required": [
            "projets",
            "editions",
            "ministeres",
            "programmes"
          ]
        },
        "editions": {
          "type": "integer",
          "minimum": 20
        },
        "premiere_edition": {
          "type": "string",
          "pattern": "^20[0-9]{2}-(0[1-9]|1[0-2])$"
        },
        "derniere_edition": {
          "type": "string",
          "pattern": "^20[0-9]{2}-(0[1-9]|1[0-2])$"
        }
      }
    },
    "fonds": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": [
          "id",
          "nom",
          "fichier",
          "millesime",
          "arbre_etat"
        ],
        "properties": {
          "id": {
            "enum": [
              "france_relance",
              "ditp",
              "ftap",
              "fast"
            ]
          },
          "fichier": {
            "type": "string",
            "pattern": "^numerique_etat/fonds/[a-z_]+\\.json$"
          },
          "arbre_etat": {
            "type": "object",
            "required": [
              "programme",
              "noeud",
              "nom_programme",
              "fichier",
              "action",
              "nom_action",
              "rattachement"
            ],
            "properties": {
              "programme": {
                "type": "string",
                "pattern": "^[0-9]{3}$"
              },
              "noeud": {
                "type": "string"
              },
              "fichier": {
                "type": "string",
                "pattern": "^arbre/.+\\.json$"
              },
              "action": {
                "type": "string",
                "pattern": "^[0-9]{3}-[0-9]{2}$"
              },
              "nom_action": {
                "type": "string"
              },
              "rattachement": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "annees": {
      "type": "object",
      "required": [
        "fichier"
      ]
    },
    "recherche_publique": {
      "type": "object",
      "required": [
        "date",
        "trouvailles"
      ],
      "properties": {
        "trouvailles": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "required": [
              "nom",
              "url",
              "verdict",
              "licence",
              "mise_a_jour"
            ],
            "properties": {
              "verdict": {
                "enum": [
                  "réutilisable tel quel",
                  "à adapter",
                  "inspiration seulement"
                ]
              }
            }
          }
        }
      }
    }
  },
  "required": [
    "millesime",
    "source",
    "unite",
    "collecte_le",
    "avertissement",
    "sources",
    "panorama",
    "fonds",
    "annees",
    "recherche_publique"
  ]
}
