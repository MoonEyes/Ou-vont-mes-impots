{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://ou-vont-mes-impots.fr/contrat/v1/universites_etablissements.schema.json",
 "title": "site/data/universites/etablissements.json : par établissement (code UAI), montants et ratios publiés par la source pour chaque exercice ; colonnes = nature puis indicateurs de index.json (pipeline/universites.py)",
 "allOf": [
  {
   "$ref": "commun.schema.json#/$defs/entete"
  }
 ],
 "type": "object",
 "required": [
  "millesime",
  "source",
  "date_sources",
  "unite",
  "colonnes",
  "etablissements"
 ],
 "properties": {
  "date_sources": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
  },
  "unite": {
   "type": "string"
  },
  "colonnes": {
   "type": "array",
   "prefixItems": [
    {
     "const": "nature"
    }
   ],
   "minItems": 6,
   "items": {
    "type": "string"
   }
  },
  "etablissements": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "uai",
     "nom",
     "noms_anterieurs",
     "commune",
     "code_commune",
     "region",
     "academie",
     "responsabilites_elargies_depuis",
     "id_paysage",
     "exercices"
    ],
    "additionalProperties": false,
    "properties": {
     "uai": {
      "type": "string",
      "pattern": "^\\d{7}[A-Z]$"
     },
     "nom": {
      "type": "string",
      "minLength": 2
     },
     "noms_anterieurs": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "commune": {
      "type": [
       "string",
       "null"
      ]
     },
     "code_commune": {
      "type": [
       "string",
       "null"
      ]
     },
     "region": {
      "type": [
       "string",
       "null"
      ]
     },
     "academie": {
      "type": [
       "string",
       "null"
      ]
     },
     "responsabilites_elargies_depuis": {
      "type": [
       "integer",
       "null"
      ]
     },
     "id_paysage": {
      "type": [
       "string",
       "null"
      ]
     },
     "exercices": {
      "type": "object",
      "propertyNames": {
       "pattern": "^\\d{4}$"
      },
      "additionalProperties": {
       "type": "array",
       "prefixItems": [
        {
         "enum": [
          "compte_financier",
          "budget_initial"
         ]
        }
       ],
       "items": {
        "type": [
         "number",
         "null"
        ]
       }
      }
     }
    }
   }
  }
 }
}
