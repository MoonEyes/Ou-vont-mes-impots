{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ou-vont-mes-impots.fr/contrat/v1/retraites_index.schema.json",
  "title": "site/data/retraites/index.json : régimes de retraite, liens vers les financeurs, écarts entre sources, sources (pipeline/retraites.py)",
  "allOf": [
    {
      "$ref": "commun.schema.json#/$defs/entete"
    }
  ],
  "type": "object",
  "required": [
    "millesime",
    "source",
    "unite",
    "date_sources",
    "annees",
    "derniere_annee",
    "fichiers",
    "regimes",
    "definitions",
    "ecarts",
    "ecarts_msa",
    "cotisants",
    "regle",
    "limites",
    "sources",
    "sources_inaccessibles",
    "recherche_publique"
  ],
  "properties": {
    "unite": {
      "type": "string"
    },
    "date_sources": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "annees": {
      "type": "array",
      "items": {
        "$ref": "commun.schema.json#/$defs/annee_entier"
      },
      "minItems": 1
    },
    "derniere_annee": {
      "$ref": "commun.schema.json#/$defs/annee_entier"
    },
    "fichiers": {
      "type": "object",
      "required": [
        "regimes",
        "etat"
      ],
      "additionalProperties": false,
      "properties": {
        "regimes": {
          "const": "retraites/regimes.json"
        },
        "etat": {
          "const": "retraites/etat.json"
        }
      }
    },
    "regimes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "nom",
          "code_caisse",
          "type",
          "premiere_annee",
          "derniere_annee",
          "cotisants_publies",
          "liens"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "nom": {
            "type": "string"
          },
          "code_caisse": {
            "type": "string",
            "pattern": "^[0-9]{4}$"
          },
          "type": {
            "enum": [
              "base",
              "complementaire",
              "integre",
              "ensemble",
              null
            ]
          },
          "premiere_annee": {
            "anyOf": [
              {
                "$ref": "commun.schema.json#/$defs/annee_entier"
              },
              {
                "type": "null"
              }
            ]
          },
          "derniere_annee": {
            "anyOf": [
              {
                "$ref": "commun.schema.json#/$defs/annee_entier"
              },
              {
                "type": "null"
              }
            ]
          },
          "cotisants_publies": {
            "type": "boolean"
          },
          "liens": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "vue",
                "fichier",
                "id",
                "nom",
                "lecture"
              ],
              "additionalProperties": false,
              "properties": {
                "vue": {
                  "enum": [
                    "secu_cps",
                    "secu_arbre",
                    "arbre_etat",
                    "prestations"
                  ]
                },
                "fichier": {
                  "type": "string",
                  "pattern": "^(secu|arbre|prestations)/.+\\.json$"
                },
                "id": {
                  "type": "string"
                },
                "nom": {
                  "type": "string"
                },
                "md": {
                  "type": "number"
                },
                "millesime": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "lecture": {
                  "type": "string"
                },
                "partage_avec": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z0-9_]+$"
                  }
                }
              }
            }
          }
        }
      }
    },
    "tous_regimes": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "annee",
        "retraites_droit_direct",
        "retraites_tous_droits",
        "pension_droit_direct_eur_mois",
        "note"
      ]
    },
    "types": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "definitions": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "ecarts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "objet",
          "regime",
          "annee",
          "grandeur",
          "source",
          "valeur",
          "autre_source",
          "autre_valeur",
          "ecart",
          "ecart_pct",
          "lecture_ecart"
        ],
        "properties": {
          "objet": {
            "type": "string"
          },
          "regime": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "annee": {
            "$ref": "commun.schema.json#/$defs/annee_entier"
          },
          "grandeur": {
            "enum": [
              "effectif",
              "eur_mois"
            ]
          },
          "source": {
            "type": "string"
          },
          "valeur": {
            "type": "number"
          },
          "autre_source": {
            "type": "string"
          },
          "autre_valeur": {
            "type": "number"
          },
          "ecart": {
            "type": "number"
          },
          "ecart_pct": {
            "type": [
              "number",
              "null"
            ]
          },
          "lecture_ecart": {
            "type": "string",
            "minLength": 10
          }
        }
      }
    },
    "ecarts_msa": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "autre_source",
        "lignes",
        "annees_colonnes_inversees",
        "constat",
        "lecture_ecart"
      ],
      "properties": {
        "source": {
          "type": "string"
        },
        "autre_source": {
          "type": "string"
        },
        "lignes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "annee",
              "colonne_salaries_agricoles",
              "colonne_non_salaries_agricoles",
              "intercommunalites",
              "cellules_non_numeriques",
              "eacr_msa_salaries_tous_droits",
              "eacr_msa_non_salaries_tous_droits"
            ],
            "properties": {
              "annee": {
                "$ref": "commun.schema.json#/$defs/annee_entier"
              },
              "colonne_salaries_agricoles": {
                "type": "integer",
                "minimum": 0
              },
              "colonne_non_salaries_agricoles": {
                "type": "integer",
                "minimum": 0
              },
              "intercommunalites": {
                "type": "integer"
              },
              "cellules_non_numeriques": {
                "type": "integer",
                "minimum": 0
              },
              "eacr_msa_salaries_tous_droits": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "eacr_msa_non_salaries_tous_droits": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "ecart_salaries": {
                "type": "integer"
              },
              "ecart_non_salaries": {
                "type": "integer"
              }
            }
          }
        },
        "annees_colonnes_inversees": {
          "type": "array",
          "items": {
            "$ref": "commun.schema.json#/$defs/annee_entier"
          }
        },
        "constat": {
          "type": "string"
        },
        "lecture_ecart": {
          "type": "string"
        }
      }
    },
    "cotisants": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9_]+$"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "source",
          "annees",
          "definition"
        ],
        "additionalProperties": false,
        "properties": {
          "source": {
            "type": "string"
          },
          "annees": {
            "type": "array",
            "items": {
              "$ref": "commun.schema.json#/$defs/annee_entier"
            }
          },
          "definition": {
            "type": "string"
          }
        }
      }
    },
    "regle": {
      "type": "string"
    },
    "limites": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "entrepot",
          "url",
          "page",
          "titre",
          "producteur",
          "millesime",
          "licence",
          "verdict"
        ],
        "properties": {
          "url": {
            "type": "string",
            "pattern": "^https://"
          },
          "page": {
            "type": "string",
            "pattern": "^https://"
          },
          "verdict": {
            "type": "string",
            "pattern": "^(réutilisable tel quel|à adapter|inspiration seulement)"
          },
          "entrepot": {
            "type": "string",
            "description": "nom du fichier ou du dossier brut dans data/lake/secu/ (non versionné)"
          }
        }
      }
    },
    "sources_inaccessibles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source",
          "motif"
        ],
        "additionalProperties": false,
        "properties": {
          "source": {
            "type": "string"
          },
          "motif": {
            "type": "string"
          }
        }
      }
    },
    "recherche_publique": {
      "type": "object",
      "required": [
        "date",
        "conclusion",
        "trouvailles"
      ],
      "properties": {
        "trouvailles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "nom",
              "url",
              "licence",
              "verdict"
            ],
            "properties": {
              "verdict": {
                "type": "string",
                "pattern": "^(réutilisable tel quel|à adapter|inspiration seulement|aucun autre dépôt pertinent)"
              }
            }
          }
        }
      }
    }
  }
}
