{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ou-vont-mes-impots.fr/contrat/v1/marches_acheteurs.schema.json",
  "title": "site/data/marches/acheteurs.json : principaux acheteurs nommés, tous départements réunis, montants par année (pipeline/marches.py)",
  "allOf": [
    {
      "$ref": "commun.schema.json#/$defs/entete"
    }
  ],
  "type": "object",
  "properties": {
    "millesime": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "unite": {
      "type": "string",
      "pattern": "^euros HT"
    },
    "collecte_le": {
      "type": "string",
      "format": "date"
    },
    "annees": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 2019,
        "maximum": 2100
      },
      "minItems": 1
    },
    "note": {
      "type": "string",
      "minLength": 1
    },
    "ordre": {
      "type": "string",
      "minLength": 1
    },
    "acheteurs": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "properties": {
          "siren": {
            "$ref": "commun.schema.json#/$defs/siren"
          },
          "denomination": {
            "type": "string",
            "minLength": 1
          },
          "categorie_juridique": {
            "$ref": "commun.schema.json#/$defs/categorie_personne_morale"
          },
          "categorie": {
            "type": "string",
            "minLength": 1
          },
          "marches": {
            "type": "integer",
            "minimum": 0
          },
          "departements": {
            "type": "integer",
            "minimum": 0
          },
          "total_eur": {
            "type": "number"
          },
          "montants_eur": {
            "type": "array",
            "items": {
              "type": [
                "number",
                "null"
              ]
            },
            "minItems": 1
          },
          "centrale_achat": {
            "type": "boolean"
          }
        },
        "required": [
          "siren",
          "denomination",
          "categorie_juridique",
          "categorie",
          "marches",
          "departements",
          "total_eur",
          "montants_eur",
          "centrale_achat"
        ],
        "additionalProperties": false,
        "propertyNames": {
          "not": {
            "pattern": "(?i)pr[eé]nom|adresse|courriel|telephone|dirigeant"
          }
        }
      }
    },
    "autres_acheteurs_nommes": {
      "type": "object",
      "properties": {
        "nombre": {
          "type": "integer",
          "minimum": 0
        },
        "montant_eur": {
          "type": "number"
        }
      },
      "required": [
        "nombre",
        "montant_eur"
      ],
      "additionalProperties": false
    },
    "acheteurs_non_nommes": {
      "type": "object",
      "properties": {
        "nombre": {
          "type": "integer",
          "minimum": 0
        },
        "marches": {
          "type": "integer",
          "minimum": 0
        },
        "montant_eur": {
          "type": "number"
        }
      },
      "required": [
        "nombre",
        "marches",
        "montant_eur"
      ],
      "additionalProperties": false
    },
    "acheteur_illisible": {
      "type": "object",
      "properties": {
        "marches": {
          "type": "integer",
          "minimum": 0
        },
        "montant_eur": {
          "type": "number"
        }
      },
      "required": [
        "marches",
        "montant_eur"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "millesime",
    "source",
    "unite",
    "collecte_le",
    "annees",
    "note",
    "ordre",
    "acheteurs",
    "autres_acheteurs_nommes",
    "acheteurs_non_nommes",
    "acheteur_illisible"
  ],
  "additionalProperties": false
}
