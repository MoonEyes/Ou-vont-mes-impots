{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ou-vont-mes-impots.fr/contrat/v1/aide_developpement_afd.schema.json",
  "title": "site/data/aide_developpement/afd.json : concours de l'AFD (standard IATI), dons et prêts séparés, engagements et versements par année, pays et secteur",
  "allOf": [
    {
      "$ref": "commun.schema.json#/$defs/entete"
    }
  ],
  "type": "object",
  "required": [
    "millesime",
    "source",
    "unite",
    "avertissement",
    "definitions",
    "annees",
    "annees_partielles",
    "colonnes_montants",
    "ordre",
    "par_annee",
    "pays",
    "par_pays",
    "par_secteur",
    "methode",
    "couverture",
    "ecartes",
    "limites",
    "sources_textes",
    "citations"
  ],
  "properties": {
    "millesime": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "unite": {
      "type": "string",
      "minLength": 1
    },
    "avertissement": {
      "type": "string",
      "minLength": 20,
      "pattern": "ne s'additionnent pas"
    },
    "collecte_le": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "definitions": {
      "type": "object",
      "required": [
        "don",
        "pret",
        "apd",
        "engagements",
        "versements"
      ],
      "additionalProperties": {
        "type": "string"
      }
    },
    "annees": {
      "type": "array",
      "minItems": 3,
      "items": {
        "$ref": "commun.schema.json#/$defs/annee_entier"
      }
    },
    "annees_partielles": {
      "type": "array",
      "items": {
        "$ref": "commun.schema.json#/$defs/annee_entier"
      }
    },
    "colonnes_montants": {
      "const": [
        "dons_engages_eur",
        "prets_engages_eur",
        "dons_verses_eur",
        "prets_verses_eur"
      ]
    },
    "ordre": {
      "type": "object",
      "required": [
        "cles",
        "regle"
      ],
      "properties": {
        "cles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "regle": {
          "type": "string",
          "minLength": 20
        }
      }
    },
    "par_annee": {
      "type": "object",
      "required": [
        "colonnes",
        "lignes",
        "concours_engages"
      ],
      "properties": {
        "colonnes": {
          "const": [
            "annee",
            "flux"
          ]
        },
        "lignes": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "$ref": "commun.schema.json#/$defs/annee_entier"
              },
              {
                "enum": [
                  "apd",
                  "autres_apports_publics"
                ]
              },
              {
                "type": [
                  "integer",
                  "null"
                ]
              },
              {
                "type": [
                  "integer",
                  "null"
                ]
              },
              {
                "type": [
                  "integer",
                  "null"
                ]
              },
              {
                "type": [
                  "integer",
                  "null"
                ]
              }
            ],
            "items": false,
            "minItems": 6
          }
        },
        "concours_engages": {
          "type": "object",
          "required": [
            "colonnes",
            "lignes"
          ],
          "properties": {
            "colonnes": {
              "const": [
                "annee",
                "flux",
                "dons",
                "prets"
              ]
            },
            "lignes": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "array",
                "prefixItems": [
                  {
                    "$ref": "commun.schema.json#/$defs/annee_entier"
                  },
                  {
                    "enum": [
                      "apd",
                      "autres_apports_publics"
                    ]
                  },
                  {
                    "type": "integer"
                  },
                  {
                    "type": "integer"
                  }
                ],
                "items": false,
                "minItems": 4
              }
            }
          }
        }
      }
    },
    "pays": {
      "type": "array",
      "minItems": 50,
      "items": {
        "type": "object",
        "required": [
          "code",
          "nom",
          "nom_tri"
        ],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^([A-Z]{3}|R[0-9]+|NON_VENTILE)$"
          },
          "nom": {
            "type": "string",
            "minLength": 1
          },
          "nom_tri": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": [
              "pays",
              "regroupement"
            ]
          },
          "nom_source": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "par_pays": {
      "type": "object",
      "required": [
        "colonnes",
        "lignes"
      ],
      "properties": {
        "colonnes": {
          "const": [
            "annee",
            "code",
            "flux"
          ]
        },
        "lignes": {
          "type": "array",
          "minItems": 100,
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "$ref": "commun.schema.json#/$defs/annee_entier"
              },
              {
                "type": "string",
                "pattern": "^([A-Z]{3}|NON_VENTILE)$"
              },
              {
                "enum": [
                  "apd",
                  "autres_apports_publics"
                ]
              },
              {
                "type": [
                  "integer",
                  "null"
                ]
              },
              {
                "type": [
                  "integer",
                  "null"
                ]
              },
              {
                "type": [
                  "integer",
                  "null"
                ]
              },
              {
                "type": [
                  "integer",
                  "null"
                ]
              }
            ],
            "items": false,
            "minItems": 7
          }
        }
      }
    },
    "par_secteur": {
      "type": "object",
      "required": [
        "colonnes",
        "lignes"
      ],
      "properties": {
        "colonnes": {
          "const": [
            "annee",
            "secteur",
            "flux"
          ]
        },
        "lignes": {
          "type": "array",
          "minItems": 20,
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "$ref": "commun.schema.json#/$defs/annee_entier"
              },
              {
                "type": "string",
                "minLength": 1
              },
              {
                "enum": [
                  "apd",
                  "autres_apports_publics"
                ]
              },
              {
                "type": [
                  "integer",
                  "null"
                ]
              },
              {
                "type": [
                  "integer",
                  "null"
                ]
              },
              {
                "type": [
                  "integer",
                  "null"
                ]
              },
              {
                "type": [
                  "integer",
                  "null"
                ]
              }
            ],
            "items": false,
            "minItems": 7
          }
        }
      }
    },
    "methode": {
      "type": "string",
      "minLength": 20
    },
    "couverture": {
      "type": "object",
      "required": [
        "fichiers",
        "activites",
        "concours_retenus",
        "hors_champ"
      ]
    },
    "ecartes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "motif"
        ],
        "properties": {
          "motif": {
            "type": "string",
            "minLength": 20
          }
        }
      }
    },
    "limites": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 20
      }
    },
    "sources_textes": {
      "type": "object",
      "minProperties": 1,
      "description": "Source de chaque champ texte explicatif (motif de chemin, indices remplacés par *) : « traitement » (règle appliquée par pipeline/aide_developpement.py), identifiant de sources[] d'index.json, « arbre » (budget de l'État) ou « citation:<id> » ; « citation » pour le texte d'une citation.",
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "pattern": "^(traitement|arbre|citation|citation:[a-z0-9_]+|[a-z0-9_]+)$"
        }
      }
    },
    "citations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "auteur",
          "document",
          "url",
          "page",
          "texte",
          "consulte_le"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "auteur": {
            "type": "string",
            "minLength": 3
          },
          "document": {
            "type": "string",
            "minLength": 3
          },
          "url": {
            "type": "string",
            "pattern": "^https://"
          },
          "page": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "texte": {
            "type": "string",
            "minLength": 10
          },
          "consulte_le": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          }
        }
      },
      "description": "Citations mot pour mot de documents primaires (auteur, document, adresse, page, date de consultation). Aucun texte n'y est ajouté."
    }
  }
}
