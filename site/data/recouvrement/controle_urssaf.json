nombre_actions":[5144,5497,4545,5631,5670,6140,6792],"nombre_redressements":[4528,4991,4064,4728,4723,5124,5835],"redressements_eur":[612969321,687953949,575255618,772831828,766344623,1151625462,1565187315],"libelle":"Contrôle ciblé de lutte contre le travail dissimulé"},{"type_action":"CCA (avec redressements LCTI)","nombre_actions":[null,null,null,null,null,null,null],"nombre_redressements":[null,null,null,null,null,null,null],"redressements_eur":[12706906,15155409,11567444,3975382,7118288,5813226,8333037],"libelle":"Contrôle comptable d'assiette ayant donné lieu à un redressement pour travail dissimulé"},{"type_action":"Autre action LCTI","nombre_actions":[null,null,null,null,null,null,null],"nombre_redressements":[null,null,null,null,null,null,null],"redressements_eur":[15079508,5209183,19012959,12612757,14653825,20051736,12484592],"libelle":"Autre action de lutte contre le travail dissimulé"},{"type_action":"Prévention/recherche LCTI","nombre_actions":[45214,44829,20052,30451,31852,28673,26290],"nombre_redressements":[null,null,null,null,null,null,null],"redressements_eur":[null,null,null,null,null,null,null],"libelle":"Prévention et recherche"}],"total":{"nombre_actions":[50358,50326,24597,36082,37522,34813,33082],"nombre_redressements":[4528,4991,4064,4728,4723,5124,5835],"redressements_eur":[640755735,708318541,605836021,789419967,788116736,1177490424,1586004944]}},"regle":"Les deux jeux sont publiés séparément par l'Urssaf. La source ne précise pas si les redressements pour travail dissimulé constatés lors d'un contrôle comptable d'assiette figurent aussi dans les résultats du contrôle : les deux séries ne sont pas additionnées.","definitions":[{"terme":"Redressements","citation":"Les redressements correspondent aux sommes dues par les entreprises, liées à des erreurs ou irrgularités concernant les règles de calcul et de paiement des cotisations sociales, détectées lors du contrôle.","source":"urssaf_lexique"},{"terme":"Restitutions","citation":"Le contrôle vise à rétablir une situation et non pas à sanctionner. Cette régularisation peut d’ailleurs être en faveur de l'usager et peut donc conduire à des restitutions. 150 à 200 millions sont ainsi restitués chaque année à nos publics.","source":"urssaf_lexique"},{"terme":"Régularisations","citation":"Suite aux vérifications réalisées lors d'un contrôle, les erreurs détectées doivent être régularisées. Elles peuvent donner lieu soit à un redressement au profit de l'Urssaf soit  à une restitution au profit de l'entreprise. Le contrôle vise à rétablir une situation et non pas à sanctionner. Le contexte sanitaire et économique de l'année 2020 a impacté les activités de l'Urssaf, ainsi les chiffres présentés pour cette année ne reflètent pas la situation normale du réseau.","source":"urssaf_lexique"},{"terme":"Contrôle comptable d'assiette (CCA)","citation":"Le contrôle comptable d’assiette pour le régime général peut se définir comme le contrôle sur place d’une entreprise dont la situation est examinée dans sa globalité.","source":"urssaf_lexique"},{"terme":"Lutte contre le travail dissimulé (LCTD)","citation":"L’infraction de travail dissimulé ou illégal se caractérise par un élément intentionnel relevant d’une volonté délibérée de se soustraire à tout ou partie de ses obligations déclaratives et de paiement. Les situations de travail dissimulé se caractérisent par une dissimulation totale ou partielle d’activité ou dissimulation totale ou partielle d’emploi salarié. Le contrôle a pour finalités de : préserver les droits sociaux des salariés ; sécuriser le financement du système de protection sociale ; contribuer à une concurrence loyale entre les entreprises, dans une économie où les diverses cotisations et contributions constituent une composante des coûts de production des entreprises.","source":"urssaf_lexique"}],"organismes":[{"organisme":"CGSS Guadeloupe","nom_tri":"cgss guadeloupe","region":"Guadeloupe","code_region":"01","controle":{"nombre_actions":[528,429,160,23