biologie":3477187027,"soins_infirmiers":5855234316,"kinesitherapie":5340743094,"transports":1920784372,"indemnites_journalieres":14611501024,"autres":3400790666,"total":62114507660},"etablissements_prives":{"total":18723921318,"postes":{"sejours_mco":9513910008,"smr":2884607621,"psychiatrie":1005647705,"medicaments_dispositifs_en_sus":2457446462,"dialyse":977119540,"hospitalisation_domicile":1027076514,"medico_social":454962075,"imagerie":166968539,"autres":236182855},"statuts":{"prive_lucratif":16223356301,"prive_non_lucratif":2409360704,"public":91204312,"autre":0}}}},"definitions":{"honoraires.sans_depassement":"honoraires des professionnels de santé libéraux au tarif de la convention avec l'assurance maladie (base de remboursement), y compris rémunérations forfaitaires et indemnités de déplacement ; département du cabinet principal ; professionnels actifs au 31 décembre","honoraires.depassements":"part facturée au-delà du tarif conventionnel ; non remboursée par l'assurance maladie obligatoire","prescriptions_medecins":"montant, sur la base de remboursement, de ce que les médecins libéraux du département ont prescrit et qui a été exécuté (par une pharmacie, un laboratoire, un infirmier, un transporteur...) ; indemnités journalières : arrêts de travail prescrits ; la base de remboursement comprend la part remboursée, le ticket modérateur et les franchises","etablissements_prives":"montants remboursés par le régime général (85 % des dépenses de l'ensemble des régimes selon la source) aux établissements de santé privés et à certains établissements facturant directement les caisses, en date de remboursement ; département de la caisse primaire de l'assuré ; les lignes « dont » de la source sont exclues","absence":"secret_statistique : moins de 5 professionnels dans le département (« NS » à la source) ; non_calcule : « NC » à la source ; absent : ligne non publiée. Une valeur absente est null, jamais 0."},"comparabilite":[{"elements":["honoraires","prescriptions_medecins"],"lecture":"un même euro peut figurer deux fois : une séance de kinésithérapie prescrite par un médecin est dans les prescriptions du médecin et dans les honoraires du kinésithérapeute ; ces deux vues ne s'additionnent pas"},{"elements":["prescriptions_medecins","ondam.soins_de_ville"],"lecture":"la base de remboursement n'est pas le montant remboursé : la part de l'assurance maladie en est une fraction ; l'ONDAM est en droits constatés, tous régimes, net des remises des laboratoires"},{"elements":["departements","france"],"lecture":"honoraires et prescriptions : le total « France » est celui publié par la Cnam ; il peut différer de la somme des départements (secret statistique, arrondis). Établissements privés : le total « France » est la somme des départements et des codes hors département de la source (voir hors_departements_etablissements_prives)"}],"hors_departements_etablissements_prives":{"2024":{"97":7068},"2025":{"97":3967408}},"controles_professions":[{"annee":2023,"groupe":"medecins","publie":24832801011,"somme_composantes":24832801010,"difference":1},{"annee":2023,"groupe":"auxiliaires_medicaux","publie":17683466213,"somme_composantes":17683466213,"difference":0},{"annee":2024,"groupe":"medecins","publie":25970577462,"somme_composantes":25970577462,"difference":0},{"annee":2024,"groupe":"auxiliaires_medicaux","publie":18714466964,"somme_composantes":18714466965,"difference":-1},{"annee":2025,"groupe":"medecins","publie":27200682798,"somme_composantes":27200682798,"difference":0},{"annee":2025,"groupe":"auxiliaires_medicaux","publie":19391928258,"somme_composantes":19391928258,"difference":0}],"liens":[{"vue":"secu_arbre","fichier":"secu/arbre/racine.json","lecture":"comptes de la branche maladie et ONDAM 2024 par poste (vue nationale) ; même argent, jamais additionné aux montants par département"},{"vue":"sante_etablissements","fichier":"sante_etablissements/index.json","lecture":"établissements de santé par département (référentiel, activité) ; auc